ScottRoom Inside_Stump "Wnętrze pnia"
  with description "Jesteś w dużym, pustym, wilgotnym pniu na bagnie.",
       n_to Dismal_Swamp,  s_to Dismal_Swamp,  e_to Dismal_Swamp,
       w_to Dismal_Swamp,  u_to Dismal_Swamp,  d_to Root_Chamber,
  has  light;
Sign -> "ZOSTAW TU SKARBY - (powiedz 'WYNIK')";
Object -> bottle "butelk/a"
  with name 'butelka' 'butelkę' 'butelki' 'butelce' 'butelką' 'flaszka'
            'flaszkę' 'słoik' 'słoika',
       short_name
       [;  if (water_in_the_bottle in self)
           {   PoPrzyp(self, "butelka", "butelki", "butelce", "butelkę",
                   "butelką", "butelce");
               print " wody"; rtrue;
           }
           if (bees in self)
           {   PoPrzyp(self, "butelka", "butelki", "butelce", "butelkę",
                   "butelką", "butelce");
               print " pszczół"; rtrue;
           }
           PoPrzyp(self, "pusta butelka", "pustej butelki", "pustej butelce",
               "pustą butelkę", "pustą butelką", "pustej butelce");
           rtrue;
       ],
       before
       [ x; LetGo:
             if (noun in bottle)
                 "Przecież już to trzymasz (w butelce).";
         Receive:
             if (noun==water or bees) <<Fill self>>;
             "To się nie zmieści do butelki.";
         Fill:
             if (child(bottle)~=0)
               "Butelka jest już pełna.";
             if (water in location)
             {   move water_in_the_bottle to bottle;
                 "Butelka jest teraz pełna wody.";
             }
             if (bees in location)
             {   move bees to bottle;
                 "Butelka jest teraz pełna pszczół.";
             }
             "Nie ma tu niczego, czym można by napełnić butelkę.";
         Empty: if (child(bottle)==0) "Butelka jest już pusta!";
             x=child(bottle);
             remove x;
             if (x==bees) { bees.released(); return; }
             "Butelka jest teraz pusta, a ziemia mokra.";
       ],
  has  container open female;

Object -> brass_lantern "staroświeck/a lamp/a"
  with name 'lampka' 'lampkę' 'latarnia' 'latarnię',
       power 125,
       daemon
       [ t; if (self hasnt on) { StopDaemon(self); rtrue; }
          t=--(self.power);
          if (t==0) give self ~on ~light;
          if (self in player or location)
          {   if (t==0) "Lampa się wyczerpała.";
              if (t==30) "Lampa zaczyna przygasać.";
          }
       ],
       before
       [; Examine: print "To błyszcząca mosiężna lampa";
                if (self hasnt on)
                    ".  Teraz jest zgaszona.";
                if (self.power < 30)
                    ", świecąca słabo.";
                ", świecąca jasno.";
          Burn: <<SwitchOn self>>;
          Rub:  if (self has on) "Nie!  Jest za gorąca.";
                if (self hasnt general) "Nic się nie dzieje.";
                switch(++genie_gifts)
                {   1: move ring to location;
                       "Pojawia się świecący dżin - coś upuszcza - i znika.";
                    2: move bracelet to location;
                       "Pojawia się świecący dżin - coś upuszcza - i znika.";
                    3: if (ring in Inside_Stump)
                           score=score-ring.depositpoints;
                       remove ring; move player to Misty_Room;
                       "Pojawia się dżin - mówi ~ale z ciebie samolub~ - coś
                        zabiera - i znika!";
                    4: if (bracelet in Inside_Stump)
                           score=score-bracelet.depositpoints;
                       remove bracelet; move player to Misty_Room;
                       "Pojawia się dżin - mówi ~ale z ciebie samolub~ - coś
                        zabiera - i znika!";
                    default: "Nic się nie dzieje.";
                }
          SwitchOn: if (self.power <= 0) "Wyczerpała się.";
          Receive, Open:
                "Do lampy nie można niczego włożyć.";
       ],
       after
       [; SwitchOn: give self light; StartDaemon(self);
              "Bezpłomienna lampa świeci.";
          SwitchOff: give self ~light;
       ],
  has  switchable female;

