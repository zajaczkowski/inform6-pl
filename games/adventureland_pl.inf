           return Throne_Room;
       ];
Treasure -> mirror "*MAGICZNE LUSTRO*"
  with name 'magiczne' 'magicznego' 'lustro' 'lustra' 'lustrem' 'lusterko',
       side_up 0,
       before
       [;  Take:
               if (bear in location && bear hasnt general)
                   "Niedźwiedź cię nie przepuści!";
       ],
       after
       [;  Drop:
             if (rug in location)
             {   print "Lustro ląduje miękko na dywanie - rozjaśnia się
                        i mówi:^";
                 self.side_up++;
                 if (self.side_up % 2 == 1)
                   "*SMOK ŻĄDLI* i gaśnie.  Nie rozumiem - mam nadzieję, że
                    ty rozumiesz.";
                 "Nie marnuj *MIODU*.  Lepiej kogoś rozwściecz.  Zatamuj
                  lawę!";
             }
             remove self; move broken_glass to location;
             "Lustro uderza o ziemię i rozpada się na milion kawałków!";
       ],
  has  neuter;
Object -> bear "niedźwiedź"
  with name 'niedźwiedź' 'niedźwiedzia' 'niedźwiedziowi' 'niedźwiedziem'
            'niedźwiedziu' 'chudy' 'chudego' 'czarny' 'czarnego' 'miś' 'misia',
       short_name
       [;  if (self has general)
           {   PoPrzyp(self, "śpiący niedźwiedź", "śpiącego niedźwiedzia",
                   "śpiącemu niedźwiedziowi", "śpiącego niedźwiedzia",
                   "śpiącym niedźwiedziem", "śpiącym niedźwiedziu");
               rtrue;
           }
           PoPrzyp(self, "chudy czarny niedźwiedź", "chudego czarnego
               niedźwiedzia", "chudemu czarnemu niedźwiedziowi", "chudego
               czarnego niedźwiedzia", "chudym czarnym niedźwiedziem",
               "chudym czarnym niedźwiedziu");
           rtrue;
       ],
       before
       [;  WakeOther: give self ~general; "Niedźwiedź się budzi!^";
       ],
       life
       [;  Ask, Order, Answer: <<Sing>>;
           Attack, ThrowAt:
               if (self has general) <WakeOther self>;
               remove mirror; move broken_glass to location;
               "O nie...  Niedźwiedź robi unik...  TRZASK!";
       ],
  has  animate male;
Object broken_glass "potłuczon/e szkł/o"
  with name 'odłamki' 'odłamków' 'kawałki' 'kawałków' 'szkła',
  has  neuter;
Object dead_bear "martwy niedźwiedź"
