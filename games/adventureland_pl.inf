Treasure -> "*ZŁOTA KORONA*"
  with name 'złota' 'złotą' 'złotej' 'korona' 'koronę' 'korony' 'koroną',
       desc_dop "*ZŁOTEJ KORONY*", desc_cel "*ZŁOTEJ KORONIE*",
       desc_bie "*ZŁOTĄ KORONĘ*", desc_nar "*ZŁOTĄ KORONĄ*",
       desc_mie "*ZŁOTEJ KORONIE*",
  has  female;

ScottRoom Real_Trouble "Kłopoty!"
  with description
           "Chyba masz naprawdę poważne kłopoty.  Jest tu facet z widłami!^^
            Wszystkie skarby *PRZEPADŁY*.",
       initial
       [;  deadflag=3;
       ],
  has  light;

ScottRoom Memory_RAM "Paskudne miejsce"
  with description
          "Jesteś w pamięci RAM komputera IBM PC.  Gdzieś źle skręciłeś!",
       e_to Large_Cavern,
  has  light;
Sign -> "Dla Architektów - TSURRIS";

ScottRoom Misty_Room "Mglista sala"
  with description "Jesteś w dużej mglistej sali z dziwnymi literami nad
                    wyjściami.",
       s_to Real_Trouble,  e_to Forest,  w_to Real_Trouble,
       u_to Up_Oak,  d_to Real_Trouble,
  has  light;
Sign -> "OTCHŁAŃ.  ZNAJDŹ WŁAŚCIWE WYJŚCIE I ŻYJ ZNOWU!";

! ------------------------------------------------------------------------------
!   Szczypta kodu
! ------------------------------------------------------------------------------

[ Initialise;
  location=Forest; score = 0;

  StartDaemon(chiggers);

  "^^^^^Rozlega się grzmiący głos...^
  Skarby mają w nazwie *.  Powiedz 'WYNIK'^
  Jeśli potrzebujesz podpowiedzi, spróbuj 'POMOC'.^";
];

[ TimePasses i;
  if (location ~= Inside_Stump) rfalse;

  score=0;
  objectloop (i in Inside_Stump && i ofclass Treasure)
      score = score + i.depositpoints;

  if (score ~= 100) rfalse;

  deadflag=2;
  "Gratulacje!  Znajdując i składając wszystkie 13 *SKARBÓW*, rozwiązał",
  (nop) Gracz("eś", "aś"), " ~Krainę Przygód~ Scotta Adamsa i zostaje tylko
   powiedzieć, że...";
];

[ AfterLife;
   if (deadflag==3) { deadflag=1; rfalse; }
   remove chigger_bites; remove infected_bites;
   deadflag=0; PlayerTo(Misty_Room);
];

[ PrintRank; "."; ];

[ DarkToDark;
  if (dark_warning==0)
  {   dark_warning=1; "Jest teraz zupełnie ciemno.  Jeśli pójdziesz dalej,
                       pewnie wpadniesz do jamy.";
  }
  if (random(4) == 1)
  {   deadflag=1;
      "Wpadł", (nop) Gracz("eś", "aś"), " do jamy i połamał",
      (nop) Gracz("eś", "aś"), " sobie wszystkie kości!";
  }
  rfalse;
];

[ BunyonSub;
  if (axe notin player) "Nic się nie dzieje.";
  if (ox in player or location)
  {   move ox to Hidden_Grove;
      move axe to Hidden_Grove;
      "Coś, co trzymasz, zawibrowało i...";
  }
  if (player notin Quicksand)
  {   move axe to Hidden_Grove;
      print "Coś, co trzymasz, zawibrowało i...^";
      <<Inv>>;
  }
  "Nic się nie dzieje.";
];

[ TsurrisSub;
  if (location ~= Memory_RAM) "Nic się nie dzieje.";
  "Rozlega się grzmiący głos...^
   Niech ci wszystkie zęby wypadną poza jednym, a ten niech cię boli.^
   (Nie możesz oprzeć się wrażeniu, że trafił", (nop) Gracz("eś", "aś"), " na
    prywatną kłótnię, która nie ma nic wspólnego z twoją grą.)";
];

[ BurnSub;
  if (flint_and_steel notin player)
      "Nie masz czym skrzesać ognia.";
  if (noun==gas) "Żeby gaz się zapalił, trzeba go najpierw w czymś zamknąć.";
  if (noun==distended_bladder)
  {   if (noun in player)
      {   remove noun; deadflag=1; "Bukłak z gazem wybuchł ci w rękach!";
      }
      remove noun;
      print "Bukłak z gazem wybuchł!^";
      if (dragon in location)
      {   remove dragon; move gore to location;
          "Smok został rozerwany na strzępy!";
      }
      if (bricked_window in location)
      {   remove bricked_window;
          move holed_window to location; move firebricks to location;
          Royal_Chamber.e_to = holed_window;
          "Zamurowane okno zostało rozerwane na strzępy!";
      }
      rtrue;
  }
  "To się nie zapali.";
];

[ HelpSub;
   print "Rozlega się grzmiący głos...^";
   print "Spróbuj:  ROZEJRZYJ SIĘ, SKOCZ, PŁYŃ, WESPNIJ SIĘ, RZUĆ, ZNAJDŹ,
          IDŹ, WEŹ, EKWIPUNEK, WYNIK.^";
   if (chigger_bites in player || infected_bites in player)
       "Na ukąszenia dobre jest lekarstwo.";
   if (location == Quicksand) "Tu mogą być potrzebne magiczne słowa.";
   if (location == Sunny_Meadow)
       "Tylko 3 rzeczy obudzą smoka.  Jedna z nich jest niebezpieczna!";
   if (location == Hive)
       "Przeczytaj tabliczkę na łące!";
   if (location == Maze1 or Maze2 or Maze3
       || location == Maze4 or Maze5 or Maze6)
       "Tu mogą być potrzebne magiczne słowa.";
   if (location == Royal_Chamber) "Wysadź to.  Spróbuj na bagnie.";
];

[ AwaySub;
  if (rug notin player || location~=Maze3) "Nic się nie dzieje.";
  print "Coś, co trzymasz, wibruje i...^";
  PlayerTo(Sunny_Meadow);
];

[ FindSub;
  "Rozlega się grzmiący głos...^Znajdź to sam", (nop) Gracz("", "a"), ".";
];

! ------------------------------------------------------------------------------
!   Gramatyka: zwykła i kilka rozszerzeń
! ------------------------------------------------------------------------------

Include "PolskiG";

Verb 'zetnij' 'zrąb' 'porąb' 'rąb' 'ściąć'
                * noun                           -> Cut
                * noun held                      -> Cut;

Verb 'bunyon'   *                                -> Bunyon;
Verb 'away'     *                                -> Away;
Verb 'tsurris'  *                                -> Tsurris;
Extend 'pomoc' replace *                         -> Help;
Extend 'szukaj' * topic                          -> Find;

! ------------------------------------------------------------------------------
