Object -> cypress_tree "cyprys/+u"
  with name 'drzewo' 'drzewa' 'drzewie',
       before
       [;   Climb: <<Enter self>>;
            Cut:    if (axe notin player) rfalse;
                    remove self; move tree_remains to Dismal_Swamp;
                    Dismal_Swamp.in_to = tree_remains;
                    Dismal_Swamp.u_to = 0;
                    print "DRZEWO LECI..";
                    if (keys in Tree_Top)
                    {   remove keys;
                        ".  Coś spadło z wierzchołka i zniknęło!";
                    }
                    ".";
       ],
       door_to Tree_Top, door_dir u_to
  has  open door static;

Object -> mud "cuchnąc/e błot/o"
  with name 'błoto' 'błota' 'błotem' 'muł' 'mułu',
       after
       [ f; Take:
                if (infected_bites in player) { remove infected_bites; f=1; }
                if (chigger_bites in player)  { remove chigger_bites; f=1; }
                if (f==1) "O rany, ale to dobrze zrobiło!";
       ],
       each_turn
       [;  if (self notin player) rtrue;
           if (random(100)<=5 &&
               (bottle notin player || water_in_the_bottle notin bottle))
           {   move self to Dismal_Swamp;
               "Błoto wyschło i odpadło.";
           }
       ],
  has  neuter;

Object -> gas "bagienn/y gaz/+u"
  with name 'gazu',
       before
       [;  Take:
               if (distended_bladder in player) "Bukłak jest już pełny.";
               if (wine_bladder notin player) "Nie masz niczego odpowiedniego.";
               <<Insert self wine_bladder>>;
           Insert:
               if (second == distended_bladder) "Bukłak jest pełny.";
               if (second ~= wine_bladder)
                   "To nie utrzyma gazu.";
               move distended_bladder to player; remove wine_bladder;
               PronounNotice(distended_bladder);
               "Bukłak nadyma się bagiennym gazem.";
       ],
  has  static;
Object -> slime "pływając/a plam/a oleistego szlamu"
  with name 'szlam' 'szlamu' 'olej' 'oleju' 'oleisty' 'oleistego',
       before
       [;  Take: brass_lantern.power=125; give brass_lantern general;
                 remove self; move brass_lantern to player;
                 "Magiczny olej przyciąga magiczną lampę.  Lampa jest teraz
                  pełna.";
       ],
  has  static female;
Object -> chiggers "rój/ meszek"
  with name 'meszki' 'meszek' 'roju' 'rojem',
       daemon
       [;  if (chigger_bites in player && mud notin player && random(100)<=10)
           {   remove chigger_bites; move infected_bites to player;
               "^Ukąszenia meszek ci się zaogniły.";
           }
           if (infected_bites in player && random(100)<=8)
           {   deadflag=1;
               "^Ukąszenia zżarły ci całe ciało.";
           }
           if (infected_bites notin player
               && chigger_bites notin player
               && slime in location && mud notin player
               && random(100)<=5)
           {   move chigger_bites to player;
               "^Pogryzły cię meszki.";
           }
           if (infected_bites notin player
               && chigger_bites notin player
               && chiggers in player
               && random(100)<=30)
           {   move chigger_bites to player;
               "^Pogryzły cię meszki.";
           }
       ];
Object chigger_bites "ukąszeni/a meszek"
  with name 'ukąszenie' 'ukąszeń' 'ugryzienia' 'ugryzień',
       desc_dop "ukąszeń meszek",
       before [; "Ukąszenia są dokuczliwe.  Może jakieś lekarstwo by pomogło?"; ],
  has  pluralname neuter;
Object infected_bites "zaognion/e ukąszeni/a meszek"
  with name 'ukąszenie' 'ukąszeń' 'ugryzienia' 'ugryzień',
       desc_dop "zaognionych ukąszeń meszek",
       before [; "Ukąszenia wyglądają przerażająco.  Zdobądź lekarstwo!"; ],
  has  pluralname neuter;

