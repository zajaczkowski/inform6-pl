  has  light;
Object -> root_door "drzwi"
  with name 'drzwi' 'drzwiach' 'drzwiami' 'korytarz' 'korytarza',
       short_name
       [;  if (self has locked)
           {   PoPrzyp(self, "zamknięte na klucz drzwi",
                   "zamkniętych na klucz drzwi", "zamkniętym na klucz drzwiom",
                   "zamknięte na klucz drzwi", "zamkniętymi na klucz drzwiami",
                   "zamkniętych na klucz drzwiach");
               rtrue;
           }
           if (self has open)
           {   PoPrzyp(self, "otwarte drzwi", "otwartych drzwi", "otwartym
                   drzwiom", "otwarte drzwi", "otwartymi drzwiami",
                   "otwartych drzwiach");
               print ", za którymi jest korytarz"; rtrue;
           }
           PoPrzyp(self, "zamknięte drzwi", "zamkniętych drzwi", "zamkniętym
               drzwiom", "zamknięte drzwi", "zamkniętymi drzwiami",
               "zamkniętych drzwiach");
           rtrue;
       ],
       before
       [;  ThrowAt:
               if (second==axe)
               {   give self ~locked ~lockable ~openable open;
                   "Zamek pęka!";
               }
       ],
       door_to Long_Hall, door_dir d_to, with_key keys
  has  static door openable lockable locked pluralname;

