Treasure -> honey "*KRÓLEWSKI MIÓD*"
  with name 'królewski' 'królewskiego' 'miód' 'miodu' 'miodem',
       before
       [;  Take:
               if (bees in location && mud notin player)
               {   deadflag=1; "Pszczoły cię żądlą."; }
           Drop:
               if (bear in location)
               {   remove self; give bear general;
                   "Niedźwiedź zjada miód i zasypia.";
               }
       ],
  has  edible;
Object -> bees "wielk/ie afrykańsk/ie pszczoł/y"
  with name 'pszczoły' 'pszczół' 'pszczołami' 'pszczoła' 'rój' 'roju' 'rojem',
       desc_dop "wielkich afrykańskich pszczół",
       released
       [;  move self to location;
           if (dragon in location)
           {   move eggs to location; remove dragon;
              "Pszczoły atakują smoka, który wstaje i odlatuje...";
           }
           if (bear in location)
           {   move self to location;
               give bear ~general; deadflag=1;
              "Pszczoły doprowadzają niedźwiedzia do szału.  Niedźwiedź
               atakuje cię!";
           }
          "Wypuszczasz pszczoły.";
       ],
       before
       [;  Take:
               if (mud notin player)
               {   deadflag=1; "Pszczoły cię żądlą."; }
               if (bottle in player) <<Fill bottle>>;
               "Nie masz w czym nieść pszczół.";
           Drop:
               if (self in bottle) { self.released(); rtrue; }
       ],
       each_turn
       [;  #Ifndef DEBUG;
           !  Zupełnie niesprawiedliwa reguła!  A w oryginale pszczoły przepadają.
           if (self in bottle && random(100)<=8)
           {   move self to Hive; "^Wszystkie pszczoły w butelce się udusiły."; }
           #Endif;
           if (self in bottle) rfalse;
           if (self in location && mud notin player && mud notin location &&
               random(100)<=8)
           {   deadflag=1; "Pszczoły cię żądlą."; }
       ],
  has  pluralname female;

