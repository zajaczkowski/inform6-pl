       desc_bie "zardzewiałą siekierę", desc_nar "zardzewiałą siekierą",
       desc_mie "zardzewiałej siekierze",
       description "Na trzonku wypisano magiczne słowo BUNYON.",
  has  female;
Sign -> "KĄPIEL WZBRONIONA";
