!% -Cu
!% +language_name=polski
! ==============================================================================
!   KRAINA PRZYGÓD - polska wersja "Adventureland" (Scott Adams, ok. 1979;
!   wersja Inform Grahama Nelsona, wydanie 4, 970902), jednej z przykładowych
!   gier Inform 6.
!
!   Gra naśladuje wygląd gier Scotta Adamsa: krótkie opisy, lista
!   "Widoczne wyjścia" i przedmioty wypisane w jednym wierszu.  Skarby mają
!   w nazwie gwiazdki; trzeba je złożyć we wnętrzu pnia (13 skarbów, 100
!   punktów).
!
!   Magiczne słowa (BUNYON, AWAY, TSURRIS) zostały w oryginale, bo są częścią
!   zagadek.  Zmiany względem oryginału: nazwy obiektów są w notacji
!   automatycznej odmiany (lib/odmiana.h), a procedury short_name dobierają
!   przypadek same (PoPrzyp).
! ==============================================================================

Include "PolskiZ";

Constant Story "KRAINA PRZYGÓD";
Constant Headline
           "^Interaktywna klasyka Scotta Adamsa (ok. 1979/80)^Wersja polska.^";

Release 4;
Serial "970902";

Constant MAX_CARRIED = 6;
Constant MAX_SCORE = 100;

Replace BurnSub;

Include "Parser";
Include "VerbLib";

Global genie_gifts;
Global dark_warning;

! ------------------------------------------------------------------------------
!   Nazwy drukowane przez procedury short_name (zob. też balances_pl.inf)
! ------------------------------------------------------------------------------

[ Przyp o;
    if (short_name_case == PRZYP_MIAN && pl_lista_rodzic && parent(o) == pl_lista_rodzic)
        return pl_lista_przyp;
    return short_name_case;
];

[ PoPrzyp o s0 s1 s2 s3 s4 s5;
    switch (Przyp(o)) {
      PRZYP_MIAN: print (string) s0;
      PRZYP_DOP:  print (string) s1;
      PRZYP_CEL:  print (string) s2;
      PRZYP_BIE:  print (string) s3;
      PRZYP_NAR:  print (string) s4;
      PRZYP_MIE:  print (string) s5;
    }
];

! ------------------------------------------------------------------------------

Class Treasure
 with depositpoints 7,
      after
      [; Take: if (location==Inside_Stump) "Wzięte!";
         Drop: if (location==Inside_Stump) "Bezpiecznie złożone.";
      ];

Class Sign
 with name 'tabliczka' 'tabliczkę' 'tabliczki' 'tabliczce' 'napis' 'napisu'
           'znak' 'znaku',
      short_name
      [;  PoPrzyp(self, "tabliczka", "tabliczki", "tabliczce", "tabliczkę",
              "tabliczką", "tabliczce");
          print " głosi- ", (object) self; rtrue;
      ],
      description
      [;  print_ret "Tabliczka głosi: ", (object) self;
      ],
  has static female;

Class ScottRoom
 with initial
      [;  give self ~visited;
      ],
      describe
      [ i c d;  print (string) self.description;
          print "^^Widoczne wyjścia: ";
          for (i=n_to: i<=d_to: i++)
              if (self.i ~= 0) c++;
          if (c==0) print "żadnych!";
          else
          {   for (i=n_to: i<=d_to: i++)
                  if (self.i ~= 0)
                  {   if (d++>0) print ", ";
                      if (i==n_to) print "Północ";
                      if (i==s_to) print "Południe";
                      if (i==e_to) print "Wschód";
                      if (i==w_to) print "Zachód";
                      if (i==u_to) print "Góra";
                      if (i==d_to) print "Dół";
                  }
              print ".";
          }
          new_line;
          c=0; d=0;
          objectloop (i in self)
              if (i ~= player) { c++; give i concealed; }
          if (c==0) rtrue;
          print "^Widzisz też: ";
          objectloop (i in self)
              if (i ~= player)
              {   if (d++>0) print " - "; PrintShortName(i);
              }
          new_line; rtrue;
      ];

[ GamePreRoutine i c d;
   if (action~=##Inv) rfalse;
   c=0; d=0;
   objectloop (i in player) c++;
   if (c==0) "Nic nie niesiesz.";
   print "Niesiesz:^";
   objectloop (i in player)
   {   if (d++>0) print " - "; PrintShortName(i);
   }
   new_line; rtrue;
];

[ GamePostRoutine i;
    if (action==##Look)
        objectloop (i in location)
            if (i ~= player && i has concealed)
                give i ~concealed;
    rfalse;
];

! ------------------------------------------------------------------------------
!   Do Krainy Przygód...
! ------------------------------------------------------------------------------

ScottRoom Lake_Shore "Brzeg jeziora"
  with description "Jesteś na brzegu jeziora.",
       n_to Forest,  s_to Lake_Shore,  w_to Dismal_Swamp,
       d_to Quicksand,
       before
       [;  Swim: "Pod tobą i przed jeziorem jest grzęzawisko.";
       ],
  has  light;
Object -> water "wod/a"
  with name 'jezioro' 'jeziora' 'jeziorze',
       before
       [; Drink: "O rany, ale to dobrze zrobiło.";
          Take: if (bottle notin player)
                    "Nie masz w czym nieść wody.";
                <<Fill bottle>>;
          Insert: if (second == bottle) <<Fill bottle>>;
                    "Nie masz w czym nieść wody.";
          Receive: if (noun == bottle) <<Fill bottle>>;
                remove noun; print_ret (CMian) noun, " ",
                    (nop) PL(noun, "znika", "znikają"), " w jeziorze.";
       ],
  has  scenery female;
Treasure -> "*ZŁOTA RYBKA*"
  with name 'złota' 'złotą' 'złotej' 'rybka' 'rybkę' 'rybki' 'rybką' 'ryba'
            'rybę' 'ryby' 'rybkami',
       desc_dop "*ZŁOTEJ RYBKI*", desc_cel "*ZŁOTEJ RYBCE*",
       desc_bie "*ZŁOTĄ RYBKĘ*", desc_nar "*ZŁOTĄ RYBKĄ*",
       desc_mie "*ZŁOTEJ RYBCE*",
       each_turn
       [;  if (self notin player) rfalse;
           if (net notin player && random(100) <= 75)
           {   move self to Lake_Shore;
               "^Rybka ucieka z powrotem do jeziora.";
           }
           if ((water_in_the_bottle notin bottle
                || bottle notin player) && random(100)<=50)
           {   remove self; move dead_fish to player;
               "^Za sucho.  Rybka zdycha.";
           }
       ],
  has  female;
Object -> axe "zardzewiała siekiera (magiczne słowo- BUNYON -jest na niej)"
  with name 'zardzewiała' 'zardzewiałą' 'siekiera' 'siekierę' 'siekiery'
