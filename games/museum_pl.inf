Object -> "Charlotte"
  with name 'charlotte' 'charlie' 'dziewczynka' 'dziewczynkę' 'dziewczynce',
       number 0,
       grammar
       [;  give self ~general;
           wn=verb_wordnum;
           if (NextWord()=='szymon' && NextWord()=='mówi')
           {   give self general;
               verb_wordnum=verb_wordnum+2;
           }
           self.number=TryNumber(verb_wordnum);
           if (self.number~=-1000)
           {    action=##Clap; noun=0; second=0; rtrue; }
       ],
       orders
       [ i;  if (self hasnt general) "Charlotte pokazuje ci język.";
           WaveHands: "Charlotte macha energicznie.";
           Clap: if (self.number==0) "Charlotte zakłada ręce.";
                 for (i=0:i<self.number:i++)
                 {   print "Klap!  ";
                     if (i==100)
                         print "(Pewnie już tego żałujesz.)  ";
                     if (i==200)
                         print "(Ale z niej uparta dziewczynka.)  ";
                 }
                 if (self.number>100)
                     "^^Charlotte trochę brakuje tchu.";
                "^^~Łatwizna!~ mówi Charlotte.";
           default: "~Nie umiem~, mówi Charlotte.";
       ],
       initial "Charlotte chce się bawić w ~Szymon mówi~.",
  has  animate female proper crewmember;

Object -> "Dan/"
  with name 'dyslektyk' 'dyslektyka' 'dyslektykiem',
