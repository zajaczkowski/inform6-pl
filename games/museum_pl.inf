!   Gwiazdki z kilku metali: wypisywane razem ("osiem gwiazdek: cztery
!   srebrne, jedna brązowa i trzy złote"), a w grupie każda nazwa skraca się
!   do samego metalu.

Class  Star
  with name 'gwiazdka' 'gwiazdkę' 'gwiazdki' 'gwiazdką' 'gwiazdce',
       description
           "Mała gwiazdka z cennego metalu, może egzotyczna waluta.",
       parse_name
       [ i j;
         if (parser_action==##TheSame)
         {   if (parser_one.metal == parser_two.metal) return -1;
             return -2;
         }
         for (::i++)
         {   if (wn > NumberWords()) return i;
             j=NextWord();
             if (j=='gwiazdki' or 'gwiazdek' or 'gwiazdkami') parser_action=##PluralFound;
             else if (~~Refers(self, wn-1)) return i;
         }
       ],
       metal 0,
       list_together
       [ o n;
           if (inventory_stage==1)
           {   objectloop (o in parent(parser_one)) if (o ofclass Star) n++;
               if (n==2) print "dwie"; else LanguageNumber(n);
               print " "; Liczebnik(n, "gwiazdka", "gwiazdki", "gwiazdek");
               print " (";
               c_style = c_style | (ENGLISH_BIT+NOARTICLE_BIT);
               if (c_style & NEWLINE_BIT ~= 0) c_style = c_style - NEWLINE_BIT;
               if (c_style & INDENT_BIT ~= 0)  c_style = c_style - INDENT_BIT;
           }
           else print ")";
           rfalse;
       ],
       plural
       [ o n;
           objectloop (o in parent(self)) if (o ofclass Star && Identical(o, self)) n++;
           self.przym();
           if (n<5) print "e"; else print "ych";
       ],
       short_name
       [;  if (listing_together ofclass Star)
           {   print "jedna "; self.przym(); print "a"; rtrue; }
           self.przym();
           PoPrzyp(self, "a gwiazdka", "ej gwiazdki", "ej gwiazdce", "ą gwiazdkę",
               "ą gwiazdką", "ej gwiazdce");
           rtrue;
       ],
  has  female;

Class  GoldStar   class Star with metal 1, przym [; print "złot"; ],
  name 'złota' 'złotą' 'złote' 'złotych';
Class  SilverStar class Star with metal 2, przym [; print "srebrn"; ],
  name 'srebrna' 'srebrną' 'srebrne' 'srebrnych';
Class  BronzeStar class Star with metal 3, przym [; print "brązow"; ],
  name 'brązowa' 'brązową' 'brązowe' 'brązowych';

SilverStar -> "srebrna gwiazdka";
SilverStar -> "srebrna gwiazdka";
SilverStar -> "srebrna gwiazdka";
SilverStar -> "srebrna gwiazdka";
