       [;  font off;
           print
          "^+------------------------------------------+
           ^|                              (lustro)    |
           ^|   Sala          Sala 10  ---  Sala 10a   |
           ^|   ciężarów      zmysły        kierunki   |
           ^|      |            |                      |
           ^|   Sala 14 ---    Hol    ---   Sala 11    |
           ^|  (zmiana     (jesteś tutaj)   pojemniki  |
           ^|   postaci)        |                      |
           ^|                   |                      |
           ^|   Sala 15 --- Korytarz 12                |
           ^| (rękopisy)  (drzwi, kustosz)             |
           ^|   (Biblia)        |                      |
           ^|           Sala Przełączników 13          |
           ^|               (przepaść)                 |
           ^|                   |                      |
           ^|      Druga strona przepaści w Sali 13    |
           ^+------------------------------------------+^";
           font on;
       ],
  has  static;

