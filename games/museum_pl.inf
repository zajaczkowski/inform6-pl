Class  WindowRoom
  with description
       [;  print "To jeden koniec długiej sali biegnącej ze wschodu na zachód.  ";
           if (self==window_w) "Wyjście prowadzi z powrotem na @00.";
          "Po tej stronie nie widać żadnego wejścia ani wyjścia.";
       ],
       before
       [;  Examine, Search: ;
           default:
             if (inp1~=1 && noun~=0 && noun in self.far_side)
                 print_ret (CMian) noun, " ", (nop) PL(noun, "jest", "są"),
                    " po drugiej stronie szyby.";
             if (inp2~=1 && second~=0 && second in self.far_side)
                 print_ret (CMian) second, " ", (nop) PL(second, "jest", "są"),
                    " po drugiej stronie szyby.";
       ],
       after
       [;  Look:
             if (ggw has general) rfalse;
             print "^Salę przedziela wielka szklana szyba";
             if (location.far_side hasnt light) ", za którą jest ciemność.";
             print ", od podłogi do sufitu.^";
             ListaWPrzypadku(location.far_side, PRZYP_BIE);
             if (Locale(location.far_side,
                    "Za szybą widzisz",
                    "Za szybą widzisz też")~=0) { ListaWPrzypadku(0); "."; }
             ListaWPrzypadku(0);
       ],
  has  light;

