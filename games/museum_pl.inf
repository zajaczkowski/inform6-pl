       orders
       [;
           Take: "~Co~, mówi Dan, ~chcesz, żebym wziął ", (bie) noun, "?~";
           Drop: "~Co~, mówi Dan, ~chcesz, żebym upuścił ", (bie) noun, "?~";
           Inv: "~To akurat umiem~, mówi Dan.  ~Mam puste ręce.~";
           default: "~Nie umiem~, mówi Dan.";
       ],
       initial "Jest tu Dan Dyslektyk.",
  has  animate proper male crewmember;

