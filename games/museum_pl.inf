Object Corridor12 "Korytarz 12"
  with description
          "Biegnie na południe od holu.  Boczne wyjście prowadzi na @01, do
           Sali 15, sali rękopisów.",
       n_to Foyer, s_to Oak_Door, w_to Room15,
  has  light;

Object -> "złowrog/i kustosz/"
  with name 'kustosza',
       initial
       [;  if (self hasnt general)
              "Pod ścianą stoi oparty złowrogi kustosz i śpi.";
          "Jest tu kustosz i rzuca groźne spojrzenia.";
       ],
       daemon
       [ i p j n k;
           if (random(3)~=1 || self hasnt general) rfalse;
           p=parent(self);
           objectloop (i in compass)
           {   j=p.(i.door_dir);
               if (ZRegion(j)==1 && j hasnt door) n++;
           }
           if (n==0) rfalse;
           k=random(n); n=0;
           objectloop (i in compass)
           {   j=p.(i.door_dir);
               if (ZRegion(j)==1 && j hasnt door) n++;
               if (n==k)
               {   move self to j;
                   if (p==location) "^Kustosz odchodzi sztywnym krokiem.";
                   if (j==location) "^Wchodzi kustosz sztywnym krokiem.";
                   rfalse;
               }
           }
       ],
       orders
       [;  if (self hasnt general) "Kustosz tylko chrapie.";
          "Przykłada kościsty palec do ust.  ~Ćśś!~";
       ],
       life
       [;  WakeOther:
               if (self hasnt general)
               {   give self general; move self to Foyer;
                  "Budzi się, podnosi, odpycha cię i odchodzi sztywnym
                   krokiem.";
               }
           default: "Cofa się z pogardą.";
       ],
  has  animate male;

Object Oak_Door "dębow/e drzwi/"
  with description "Wbrew pozorom do tych drzwi nie ma klucza.",
       door_dir
       [; if (location==Corridor12) return s_to; return n_to; ],
       door_to
       [; if (location==Corridor12) return Room13; return Corridor12; ],
       describe
       [; if (self has open) "^Dębowe drzwi stoją otworem.";
          if (self hasnt locked) "^Korytarz kończy się dębowymi drzwiami.";
       ],
       found_in  Corridor12  Room13
  has  static door openable lockable pluralname;

