Constant CARRYING_STRENGTH = 500;
Constant HEAVINESS_THRESHOLD = 100;

Object Weights_Room "Sala Ciężarów"
  with description
          "To przybudówka na północ od Sali 14.  Tutaj (choć nigdzie indziej)
           przedmioty mają określone ciężary i możesz unieść tylko
           ograniczony łączny ciężar.  (Przedmioty z innych części muzeum
           ważą po 10 zobów, niezależnie od tego, czym są.)  Im dłużej
           nosisz ciężkie przedmioty, tym bardziej się męczysz, aż w końcu
           musisz je upuścić; siły wracają, kiedy niesiesz już tylko lekki
           ładunek.",
       initial [; weight_monitor.activate(); ],
       s_to Room14,
  has  light;

Object -> "piórk/o" with weight 1, has neuter;
Object -> "żelazn/e kowadł/o" with weight 300, has neuter;
Object -> "pięciozobow/y odważnik/"
  with name 'pięć' 'zobów' 'ciężarek' 'ciężarka', weight 5;
Object -> "dziesięciozobow/y odważnik/"
  with name 'dziesięć' 'zobów' 'ciężarek' 'ciężarka', weight 10;
Object -> "dwudziestozobow/y odważnik/"
  with name 'dwadzieścia' 'zobów' 'ciężarek' 'ciężarka', weight 20;
Object -> "pięćdziesięciozobow/y odważnik/"
  with name 'pięćdziesiąt' 'zobów' 'ciężarek' 'ciężarka', weight 50;
Object -> "stuzobow/y odważnik/"
  with name 'sto' 'zobów' 'ciężarek' 'ciężarka', weight 100;

[ WeightOf obj t i;
   t = obj.weight;
   objectloop (i in obj) t = t + WeightOf(i);
   return t;
];

Object weight_monitor
  with
       players_strength,
       warning_level 5,

       activate
       [;  self.players_strength = CARRYING_STRENGTH; StartDaemon(self);
       ],
       daemon
       [ w s b bw;
            if (location ~= Weights_Room) { StopDaemon(self); return; }

            s = self.players_strength
                - WeightOf(player) + HEAVINESS_THRESHOLD;
            if (s<0) s=0; if (s>CARRYING_STRENGTH) s=CARRYING_STRENGTH;
            self.players_strength = s;

            if (s==0)
            {   bw=-1;
                objectloop(b in player)
                    if (WeightOf(b) > bw) { bw = WeightOf(b); w=b; }
                self.players_strength = self.players_strength + bw;
                print "^Wyczerpan", (nop) Gracz("y", "a"), " dźwiganiem
                    takiego ciężaru, postanawiasz porzucić ", (bie) w, ": ";
                <<Drop w>>;
            }

            w=s/100; if (w==self.warning_level) return;

            self.warning_level = w;
            switch(w)
            {   3: "^Czujesz się trochę zmęczon", (nop) Gracz("y", "a"), ".";
                2: "^Rzeczy zaczynają ci ciążyć.";
                1: "^Dźwiganie takiego ciężaru wyczerpuje cię.";
                0: "^Jesteś już tak wyczerpan", (nop) Gracz("y", "a"), ", że
                     zaraz wszystko upuścisz w najmniej odpowiednim momencie.";
            }
       ];

