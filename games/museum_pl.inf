       [;  Drop: remove self; "Klucz rozbija się w drobny mak!";
       ];

Object -> martha "Marth/a"
   has animate female concealed proper crewmember
  with name 'marta' 'marty' 'marcie' 'martę' 'martą',
       desc_cel "Marcie", desc_mie "Marcie",
       orders
       [ r; r=parent(self);
           Give:
               if (noun notin r) "~To przekracza moją telekinezę.~";
               if (noun==self) "~Teleportacja jest dla mnie za trudna.~";
               move noun to player;
               "~No to jazda...~ i telekinetyczne zdolności Marthy w magiczny
                sposób przenoszą ", (bie) noun, " do twoich rąk.";
           Look:
               print "~", (string) r.description;
               if (children(r)==1) ".  Nie ma tu nic poza mną.~";
               print ".  Widzę ";
               ListaWPrzypadku(r, PRZYP_BIE);
               WriteListFrom(child(r),CONCEAL_BIT+ENGLISH_BIT);
               ListaWPrzypadku(0);
              ".~";
           default: "~Obawiam się, że w tym nie pomogę.~";
       ],
       life
       [;  Ask: "~Tym razem radzisz sobie sam", (nop) Gracz("", "a"), ".~";
           Tell: "Martha cmoka ze współczuciem.";
           Answer: "~No proszę~, odpowiada Martha.";
       ];

