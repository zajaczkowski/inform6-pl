Global cherub_warning_given;
Class  Cherub
  with parse_name
       [ i j flag;
         for (::)
         {   if (wn > NumberWords()) return i;
             j=NextWord(); flag=0;
             if (j=='cherubin' or 'cherubina' or 'cherubinowi' or 'cherubinem'
                 or 'cherubinie' || Refers(self, wn-1)) flag=1;
             if (j=='cherubini')
             {   parser_action=##PluralFound; flag=1;
                 if (cherub_warning_given==0)
                     print "(Puszczę to płazem, ale po polsku liczba mnoga od
                         ~cherubin~ to ~cherubiny~.)^";
                 cherub_warning_given = true;
             }
             if (j=='cherubiny' or 'cherubinów' or 'cherubinom' or 'cherubinami'
                 or 'cherubinach')
             {   parser_action=##PluralFound; flag=1; }
             if (flag==0) return i;
             i++;
         }
       ],
  has  scenery;

Cherub -> "północno-wschodni cherubin"
  with name 'północno-wschodni' 'północno-wschodniego';
Cherub -> "południowo-wschodni cherubin"
