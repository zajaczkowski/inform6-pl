!% -Cu
!% +language_name=polski
! ==============================================================================
!   MUZEUM INFORMU - polska wersja "Museum" (Graham Nelson, wydanie 2,
!   961111), jednej z przykładowych gier Inform 6.
!
!   Ta "gra" to zbiór rozwiązanych ćwiczeń z podręcznika projektanta
!   (Designer's Manual).  Numery sal odpowiadają numerom rozdziałów trzeciego
!   wydania.  Wiele z tych ćwiczeń jest trudnych, podobnie jak część kodu.
!
!   Zmiany względem oryginału:
!   - nazwy obiektów są w notacji automatycznej odmiany (lib/odmiana.h),
!     a procedury short_name dobierają przypadek same (PoPrzyp);
!   - polecenia do maszyn i postaci są po polsku ("komputer, gdzie jest
!     kapitan Picard", "zen, ustaw kurs na centauro", "charlotte, szymon
!     mówi pomachaj");
!   - własna linia statusu (DrawStatusLine) działa tylko w maszynie Z;
!     w Glulx zostaje standardowa;
!   - dostęp do tablicy parse idzie przez UstawSlowo/NumberWords, więc gra
!     kompiluje się też dla Glulx.
! ==============================================================================

Include "PolskiZ";

Constant Story "MUZEUM INFORMU";
Constant Headline
    "^Interaktywny przewodnik po podręczniku projektanta (wydanie trzecie)^
      Wersja polska.^";

!   Grę tworzono do eksperymentowania, więc zawsze definiujemy:
Constant DEBUG;

Release 2;
Serial "961111";

#Ifdef TARGET_ZCODE;
Replace DrawStatusLine;
#Endif;
Include "Parser";

! ------------------------------------------------------------------------------

Object samples_bag "torb/a na próbki"
  with description "Pojemny SACK_OBJECT (zob. rozdział 20).",
       name 'próbki' 'próbek',
       when_closed "Na podłodze leży twoja torba na próbki.",
       when_open "Na podłodze leży twoja otwarta torba na próbki.",
  has  container open openable female;

Constant SACK_OBJECT = samples_bag;

Include "VerbLib";

! ------------------------------------------------------------------------------
!   Kilka narzędzi dla nazw drukowanych przez procedury short_name
!   (zob. też "Równowaga", balances_pl.inf).
! ------------------------------------------------------------------------------

[ Przyp o;
    if (short_name_case == PRZYP_MIAN && pl_lista_rodzic && parent(o) == pl_lista_rodzic)
        return pl_lista_przyp;
    return short_name_case;
];

[ PoPrzyp o s0 s1 s2 s3 s4 s5;
    switch (Przyp(o)) {
      PRZYP_MIAN: print (string) s0;
      PRZYP_DOP:  print (string) s1;
      PRZYP_CEL:  print (string) s2;
      PRZYP_BIE:  print (string) s3;
      PRZYP_NAR:  print (string) s4;
      PRZYP_MIE:  print (string) s5;
    }
];

!   Zmienia wartość słownikową n-tego słowa polecenia (tablica parse ma inny
!   układ w maszynie Z i w Glulx).

[ UstawSlowo n w;
    #Ifdef TARGET_ZCODE;
    parse-->(n*2-1) = w;
    #Ifnot;
    parse-->(n*3-2) = w;
    #Endif;
];

! ------------------------------------------------------------------------------

Attribute crewmember;

Property weight 10;

Class Key
  with name 'klucz' 'klucza' 'kluczem' 'kluczyk' 'kluczyka';

! ------------------------------------------------------------------------------

Object  Foyer "Hol"
 has    light
 with   description
           "Hol wspaniałego Muzeum Informu.  Szerokie schody prowadzą na górę,
            do rozdziałów V i VI, a na tym poziomie korytarze rozchodzą się
            do rozdziału IV.  Prowadzą:^
            ^  na północ do Sali 10 (Sale Zmysłów i Kierunków),
            ^  na południe Korytarzem 12 (drzwi) do Sali 13 (przełączniki),
            ^  na @00 do Sali 11 (Cudowny Świat Pojemników)
            ^  i na @01 do Sali 14 (w której stoją większe eksponaty).^^
            (Do piwnicy schodzi zwykła drabina, a można też wyjść na
             balkon.)",
        e_to Room11, u_to Second_Floor, n_to Room10,
        s_to Corridor12, w_to Room14,
        d_to basement, out_to balcony;

Object -> "plan/ parteru"
  with name 'mapa' 'mapę' 'parter' 'parteru',
       initial "W jednej ze ścian wytłoczono plan parteru.",
