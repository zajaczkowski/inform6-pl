       [;  return 'alarm,';
       ],
       orders
       [;  SwitchOn: give self general; StartDaemon(self); "~Alarm nastawiony.~";
           SwitchOff: give self ~general; StopDaemon(self);
               "~Alarm odwołany.~";
           SetTo:   self.number=noun; <<Examine self>>;
           default: "~Polecenia: włącz, wyłącz albo godzina, bardzo proszę.~";
       ],
       life
