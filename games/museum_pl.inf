Constant SUNRISE  360;  ! czyli 6:00
Constant SUNSET  1140;  ! czyli 19:00
Global day_state = 2;

Object balcony "Balkon"
  with description
       [;  print "Odkryty balkon na skalnej ścianie, na której wznosi się podobne do katedry muzeum, setki stóp nad ";
           if (day_state==1) "skąpanymi w słońcu równinami pól i osad.";
           "mroczną równiną.  Przyćmione światło ze ścian w górze to jedyna
            latarnia w tej bezkresnej nocy.";
       ],
       in_to Foyer,
       cant_go "Jedyna droga prowadzi z powrotem do środka.",
       each_turn
       [ f;
           if (the_time >= SUNRISE && the_time < SUNSET) f=1;
           if (day_state == f) return;
           if (day_state==2) { day_state = f; return; }
           day_state = f;
           if (f==1) "^Wschodzi słońce i oświetla krajobraz!";
         "^Słońce zachodzi i krajobraz pogrąża się w ciemności.";
       ],
  has  light;

