! ------------------------------------------------------------------------------
!   Monety I Ching.  Każda moneta ma własną nazwę (koza, jeleń...), a grupa
!   monet na podłodze pokazuje trygram.
! ------------------------------------------------------------------------------

[ CoinsTogether cla i x y;
  objectloop (i ofclass cla)
  {   x=parent(i);
      if (y==0) y=x; else { if (x~=y) return 0; }
  }
  return y;
];

[ Face x; if (x.number==1) print "orzeł"; else print "reszka"; ];

Array gold_trigrams -->   "szczęście" "zmiana" "płynąca rzeka" "przypadek"
                          "niezmienność" "sześć kamieni w kręgu"
                          "łaska" "boska pomoc";
Array silver_trigrams --> "radość" "smutek" "ambicja" "żal"
                          "chwała" "urok" "słodycz natury"
                          "oblicze Zakapturzonego";

[ Trigram cla i k state;
  objectloop (i ofclass cla)
  {   print (Face) i; if (k++<2) print ","; print " ";
      state=state*2 + (i.number-1);
  }
  if (cla == GoldCoin) i=gold_trigrams; else i=silver_trigrams;
  print "(", (string) i-->state, ")";
];

[ CoinsLT cla k i c r;
  if (inventory_stage==1)
  {   if (cla == GoldCoin) print "złote"; else print "srebrne";
      print " monety: ";
      k=CoinsTogether(cla);
      r = pl_lista_rodzic; pl_lista_rodzic = 0;  ! nazwy monet w mianowniku
      if (k==location || k has supporter)
      {   objectloop (i ofclass cla)
          {   print (mian) i;
              switch(++c)
              {  1: print ", "; 2: print " i ";
                 3: print " (pokazują trygram: ", (Trigram) cla, ")";
              }
          }
          pl_lista_rodzic = r;
          rtrue;
      }
      pl_lista_rodzic = r;
      c_style = c_style | (ENGLISH_BIT+NOARTICLE_BIT);
      if (c_style & NEWLINE_BIT ~= 0) c_style = c_style - NEWLINE_BIT;
      if (c_style & INDENT_BIT ~= 0)  c_style = c_style - INDENT_BIT;
  }
  rfalse;
];

Class  Coin
  with number 1,
       parse_name
       [ i j;
         if (parser_action==##TheSame) return -2;
         for (::i++)
         {   if (wn > NumberWords()) return i;
             j=NextWord();
             if (j=='monety' or 'monet' or 'monetami') parser_action=##PluralFound;
             else if (j=='moneta' or 'monetę' or 'monetą' or 'monecie') ;
             else if (~~Refers(self, wn-1)) return i;
         }
       ],
       after
       [ j;
           Drop, PutOn:
                 self.number=random(2); print (Face) self, ".  ";
                 if (self ofclass GoldCoin) j=GoldCoin; else j=SilverCoin;
                 if (CoinsTogether(j)~=0)
                 {   print "Trygram ";
                     if (j == GoldCoin) print "złotych"; else print "srebrnych";
                     " monet to teraz ", (Trigram) j, ".";
                 }
                 new_line; rtrue;
       ];

Class  GoldCoin class Coin
  with name 'złota' 'złotą' 'złotej' 'złote' 'złotych',
       list_together [; return CoinsLT(GoldCoin); ];
Class  SilverCoin class Coin
  with name 'srebrna' 'srebrną' 'srebrnej' 'srebrne' 'srebrnych',
       list_together [; return CoinsLT(SilverCoin); ];

