[ MagnifySub;
   if (magnifier notin player)
      "Nie trzymasz lupy.";
   if (noun==magnifier) "Światło nie jest aż tak giętkie.";
   print "Ledwie udaje ci się dostrzec, że na ", (mie) noun,
      " jest napis ~obiekt ", noun, "~.^";
   if (magnifier hasnt general)
   {   give magnifier general;
      "^(Kiedy masz przy sobie lupę, możesz w ten sposób odwoływać się do
        rzeczy przez ich numery; możesz nawet użyć # na oznaczenie
        ~dowolnego jednego przedmiotu~ i * na oznaczenie ~wszystkich
        przedmiotów~.)";
   }
];

[ ParseNoun obj;
  if (magnifier notin player) return -1;
  if (NextWord() == 'obiekt' && TryNumber(wn) == obj) return 2;
  wn--;
  if (WordLength(wn)==1 && WordAddress(wn)->0 == '#') return 1;
  if (WordLength(wn)==1 && WordAddress(wn)->0 == '*')
  {   parser_action = ##PluralFound; return 1; }
  return -1;
];

Object -> "/?%?/ (artystka znana wcześniej jako Księżniczka)"
  with name 'księżniczka' 'artystka' 'artystkę' 'znana' 'jako',
       description "Jakoś czujesz, że należałoby pocałować Księżniczkę.",
       short_name
       [;   if (self hasnt general)
            {   PoPrzyp(self, "Księżniczka", "Księżniczki", "Księżniczce",
                    "Księżniczkę", "Księżniczką", "Księżniczce");
                rtrue;
            }
       ],
       react_before
       [;  Listen: print_ret (CMian) self, " śpiewa cichą, uwodzicielską pieśń.";
       ],
       initial
       [;  print_ret (CMian) self, " cicho śpiewa.";
       ],
       parse_name
       [ x n; if (self hasnt general)
            {   if (NextWord()=='księżniczka' or 'księżniczki' or 'księżniczce'
                    or 'księżniczkę' or 'księżniczką') return 1;
                return 0;
            }
            x=WordAddress(wn);
            if (   x->0 == '/' && x->1 == '?' && x->2 == '%'
                && x->3 == '?' && x->4 == '/')
            {   while (wn<=NumberWords() && WordAddress(wn++)<x+5) n++;
                return n;
            }
            return -1;
       ],
       life
       [;   Kiss: give self general; self.life = NULL;
                "Jak w baśniowej przemianie Księżniczka cofa się o krok i ku
                 zdumieniu świata ogłasza, że odtąd będzie znana jako
                 ~/?%?/~.";
       ],
  has  animate proper female;

