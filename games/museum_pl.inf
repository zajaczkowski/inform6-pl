Object Room15 "Sala Rękopisów"
  with description
          "To Sala 15, przylegająca do korytarza na @00.",
       e_to Corridor12,
  has  light;

Object -> "czarna Biblia Tyndale'a"
  with name 'biblia' 'biblię' 'biblii' 'biblią' 'czarna' 'czarną' 'czarnej'
            'księga' 'księgę' 'tyndale',
       desc_dop "czarnej Biblii Tyndale'a", desc_cel "czarnej Biblii Tyndale'a",
       desc_bie "czarną Biblię Tyndale'a", desc_nar "czarną Biblią Tyndale'a",
       desc_mie "czarnej Biblii Tyndale'a",
       initial "Na pulpicie w kształcie orła o rozpostartych skrzydłach leży czarna Biblia.",
       description "Wspaniała Biblia wysoka na stopę, która musiała przetrwać
           palenie ksiąg w 1520 roku.",
       before
       [ w x; Consult:
               wn = consult_from; w = NextWord();
               switch(w)
               {   'mateusz', 'mateusza', 'mateuszu': x="Mateusza";
                   'marek', 'marka', 'marku': x="Marka";
                   'łukasz', 'łukasza', 'łukaszu': x="Łukasza";
                   'jan', 'jana', 'janie': x="Jana";
                   default: "Są tu tylko cztery Ewangelie.";
               }
               if (consult_words==1)
                   "Czytasz całą Ewangelię według świętego ", (string) x, ".";
               w = TryNumber(wn);
               if (w==-1000)
                   "Spodziewałem się numeru rozdziału Ewangelii według
                    świętego ", (string) x, ".";
               "Rozdział ", w, " Ewangelii według świętego ", (string) x,
                     " jest zbyt święty, żebyś mógł", (nop) Gracz("", "a"),
                     " go teraz zrozumieć.";
       ],
  has  female;

