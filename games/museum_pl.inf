[ Initialise;
  location = Foyer; move samples_bag to player;
  thedark.short_name = "Dziwnie pachnąca ciemność";
  thedark.initial = GoMothGo;
  NormalWorld(); lookmode=2;
  SetTime(SUNRISE-10,1);

 "^^^^^Witaj zatem w...^";
];

[ InScope actor;

   if (actor==martha) PlaceInScope(player);
   if (actor==player && scope_reason==TALKING_REASON && player in booth)
       PlaceInScope(martha);

   if (location==window_w && window_e has light)
       ScopeWithin(window_e);
   if (location==window_e && window_w has light)
       ScopeWithin(window_w);
   rfalse;
];

!   "mucha w bursztynie": słowo 'w//' zamieniamy na 'bursztyn', żeby parser
!   nie wziął go za przyimek.  Po potarciu lampy dżin zamienia biel z czernią.

[ BeforeParsing i w;
  for (i=1 : i+2<=NumberWords() : i++)
  {   wn=i;
      w = NextWord();
      if ((w=='mucha' or 'muchy' or 'musze' or 'muchę' or 'muchą' ||
           w==0 or PL_NIEZNANE) && NextWord()=='w//' &&
          NextWord()=='bursztynie')
          UstawSlowo(i+1, 'bursztyn');
  }
  if (genies_lamp hasnt general) return;
  for (i=1 : i<=NumberWords() : i++)
  {   wn=i;
      switch(NextWord())
      {   'biały':    UstawSlowo(i, 'czarny');
          'białego':  UstawSlowo(i, 'czarnego');
          'białemu':  UstawSlowo(i, 'czarnemu');
          'białym':   UstawSlowo(i, 'czarnym');
          'czarny':   UstawSlowo(i, 'biały');
          'czarnego': UstawSlowo(i, 'białego');
          'czarnemu': UstawSlowo(i, 'białemu');
          'czarnym':  UstawSlowo(i, 'białym');
      }
  }
];

! ------------------------------------------------------------------------------
!   Własna linia statusu (tylko maszyna Z)
! ------------------------------------------------------------------------------

#Ifdef TARGET_ZCODE;

Constant U_POS 28; Constant W_POS 30; Constant C_POS 31;
Constant E_POS 32; Constant IN_POS 34;

Array printed_text table 64;

[ DrawStatusLine j posa posb width;
  if (location==0) rfalse;
  width = 0->33; if (width==0) width=80;
  switch(status_style)
  {   1: @split_window 0;
      2: font off;
         @split_window 1; @buffer_mode 0; @set_window 1;
         style reverse; @set_cursor 1 1; spaces width;
         printed_text-->0 = 64;
         @output_stream 3 printed_text;
         print (name) location;
         @output_stream -3;
         j=(width-(printed_text-->0))/2;
         @set_cursor 1 j; print (name) location; spaces(j-1);
         style roman;
         @buffer_mode 1; @set_window 0; font on;
      3: @split_window 1; @set_window 1; @set_cursor 1 1; style reverse;
         posa = width-26; posb = width-13;
         spaces width;
         @set_cursor 1 2; print (name) location;
         if (width > 76)
         {   @set_cursor 1 posa; print "Wynik: ", sline1;
             @set_cursor 1 posb; print "Ruchy: ", sline2;
         }
         if (width > 63 && width <= 76)
         {   @set_cursor 1 posb; print sline1, "/", sline2;
         }
         @set_cursor 1 1; style roman; @set_window 0;
      4: if (e_obj.door_dir~=e_to)
         {   @split_window 1; @set_window 1; style reverse; font off;
             @set_cursor 1 1; spaces width;
             @set_cursor 1 2;
             print "W tym odbitym świecie zupełnie tracisz orientację";
             @set_cursor 1 1; style roman; @set_window 0; font on;
             rfalse;
         }
         @split_window 3; @set_window 1; style reverse; font off;
         @set_cursor 1 1; spaces width;
         @set_cursor 2 1; spaces width;
         @set_cursor 3 1; spaces width;
         @set_cursor 1 2;  print (name) location;
         @set_cursor 1 51; print "Wynik: ", sline1;
         @set_cursor 1 64; print "Ruchy: ", sline2;
         if (location ~= thedark)
         {   ! Pierwszy wiersz
             if (location.u_to ~= 0)  { @set_cursor 1 U_POS; print "G"; }
             if (location.nw_to ~= 0) { @set_cursor 1 W_POS; print "@@92"; }
             if (location.n_to ~= 0)  { @set_cursor 1 C_POS; print "@@124"; }
             if (location.ne_to ~= 0) { @set_cursor 1 E_POS; print "/"; }
             if (location.in_to ~= 0) { @set_cursor 1 IN_POS; print "W"; }
             ! Drugi wiersz
             if (location.w_to ~= 0)  { @set_cursor 2 W_POS; print "-"; }
                                        @set_cursor 2 C_POS; print "o";
             if (location.e_to ~= 0)  { @set_cursor 2 E_POS; print "-"; }
             ! Trzeci wiersz
             if (location.d_to ~= 0)  { @set_cursor 3 U_POS; print "D"; }
             if (location.sw_to ~= 0) { @set_cursor 3 W_POS; print "/"; }
             if (location.s_to ~= 0)  { @set_cursor 3 C_POS; print "@@124"; }
             if (location.se_to ~= 0) { @set_cursor 3 E_POS; print "@@92"; }
             if (location.out_to ~= 0){ @set_cursor 3 IN_POS; print "Z"; }
         }
         @set_cursor 1 1; style roman; @set_window 0; font on;
  }
];

#Endif; ! TARGET_ZCODE

! ------------------------------------------------------------------------------

Include "PolskiG";

! ------------------------------------------------------------------------------
!   Liczby ułamkowe: "fp 3.14", "fp 3,14", "fp 3 przecinek 1 4"
! ------------------------------------------------------------------------------

[ FPXSub;
    "Wpisał", (nop) Gracz("eś", "aś"), " liczbę ułamkową ", noun/100, ",",
    (noun%100)/10, noun%10, " (zaokrągloną do 2 miejsc po przecinku).";
];

[ DigitNumber n type x;
  x = NextWordStopped(); if (x==-1) return -1; wn--;
  if (type==0)
  {   x = WordAddress(wn);
      if (x->n>='0' && x->n<='9') return (x->n) - '0';
      return -1;
  }
  if (x=='zero') { wn++; return 0; }
  x = TryNumber(wn++); if (x==-1000 || x>=10) x=-1; return x;
];
[ FloatingPoint a x b w d1 d2 d3 type;
  a = TryNumber(wn++);
  if (a==-1000) return -1;
  w = NextWordStopped(); if (w==-1) return a*100;
  x = NextWordStopped(); if (x==-1) return -1; wn--;
  if (w=='przecinek' or 'kropka') type=1;
  else
  {   if ((WordAddress(wn-1)->0~='.' && WordAddress(wn-1)->0~=',')
          || WordLength(wn-1)~=1)
          return -1;
  }
  d1 = DigitNumber(0,type);
  if (d1==-1) return -1;
  d2 = DigitNumber(1,type); d3 = DigitNumber(2,type);
  b=d1*10; if (d2>=0) b=b+d2; else d3=0;
  if (type==1)
  {   x=1; while (DigitNumber(x,type)>=0) x++; wn--;
  }
  else wn++;
  parsed_number = a*100 + b;
  if (d3>=5) parsed_number++;
  return 1;
];

Verb 'fp' * FloatingPoint -> FPX;

! ------------------------------------------------------------------------------

Constant MAX_PHONE_LENGTH 30;
Array dialled_number -> MAX_PHONE_LENGTH+1;
[ PhoneNumber f a l ch pp i;
  pp=1; if (NextWordStopped()==-1) return 0;
  do
  {   a=WordAddress(wn-1); l=WordLength(wn-1);
      for (i=0:i<l:i++)
      {   ch=a->i;
          if (ch<'0' || ch>'9')
          {   if (ch~='-') { f=1; if (i~=0) return -1; } }
          else
          {   if (pp<MAX_PHONE_LENGTH)
                  dialled_number->(pp++)=ch-'0';
          }
      }
  } until (f==1 || NextWordStopped()==-1);
  if (pp==1) return -1;
  dialled_number->0 = pp-1;
  return 0;
];

[ DialPhoneSub i;
  print "Wybrał", (nop) Gracz("eś", "aś"), " numer <";
  for (i=1:i<=dialled_number->0:i++) print dialled_number->i;
  ">";
];
Verb 'wybierz' 'wykręć' 'zadzwoń' * PhoneNumber -> DialPhone;

! ------------------------------------------------------------------------------
!   "zamknij szafkę" i "otwórz szafkę" same domyślają się klucza, jeśli gracz
!   ma przy sobie dokładnie jeden.  "Zamknij" już zamkniętej (ale nie na
!   klucz) rzeczy zamyka ją na klucz, a "otwórz" rzeczy zamkniętej na klucz
!   najpierw ją odblokowuje.
! ------------------------------------------------------------------------------

Global assumed_key;
[ DefaultLockSub;
  print "(", (nar) assumed_key, ")^"; <<Lock noun assumed_key>>;
];
[ DefaultUnlockSub;
  print "(", (nar) assumed_key, ")^"; <<Unlock noun assumed_key>>;
];

[ DefaultKeyTest i count;
  if (noun hasnt lockable) rfalse;

  objectloop (i in player && i ofclass Key)
  {   count++; assumed_key = i; }

  if (count==1) rtrue; rfalse;
];
[ DefaultLockTest;
  if (noun has open || noun has locked) rfalse;
  return DefaultKeyTest();
];
[ DefaultUnlockTest;
  if (noun hasnt locked) rfalse;
  return DefaultKeyTest();
];

Extend 'zamknij' first * noun = DefaultLockTest -> DefaultLock;
Extend 'otwórz' first * noun = DefaultUnlockTest -> DefaultUnlock;

! ------------------------------------------------------------------------------
!   Godzina: "czas 12:02", "czas 7", "czas 7 30", "czas wpół do ósmej",
!   "czas kwadrans po 7", "czas za kwadrans 7", "czas 10 po 7",
!   "czas za 10 7", "czas północ", "czas południe".
! ------------------------------------------------------------------------------

Constant TWELVE_HOURS 720;

[ GodzinaSlownie w;
  switch (w)
  {   'pierwszej': return 1;  'drugiej': return 2;   'trzeciej': return 3;
      'czwartej': return 4;   'piątej': return 5;    'szóstej': return 6;
      'siódmej': return 7;    'ósmej': return 8;     'dziewiątej': return 9;
      'dziesiątej': return 10; 'jedenastej': return 11; 'dwunastej': return 12;
  }
  return -1;
];

[ LiczbaGodziny wordnum  i w;
  i = TryNumber(wordnum);
  if (i ~= -1000) return i;
  i = wn; wn = wordnum; w = NextWordStopped(); wn = i;
  return GodzinaSlownie(w);
];

[ TimeOfDay i j k flag loop ch hr mn;
  i=NextWord();
  if (i=='północ') { parsed_number=0; return 1; }
  if (i=='południe') { parsed_number=TWELVE_HOURS; return 1; }
  !   Najpierw postać 12:02
  j=WordAddress(wn-1); k=WordLength(wn-1);
  flag=0;
  for (loop=0:loop<k:loop++)
  {   ch=j->loop;
      if (ch==':' && flag==0 && loop~=0 && loop~=k-1) flag=1;
      else { if (ch<'0' || ch>'9') flag=-1; }
  }
  if (k<3 || k>5) flag=0;
  if (flag==1)
  {   for (loop=0:j->loop~=':':loop++, hr=hr*10)
          hr=hr+j->loop-'0';
      hr=hr/10;
      for (loop++:loop<k:loop++, mn=mn*10)
          mn=mn+j->loop-'0';
      mn=mn/10;
      if (hr>=24 || mn>=60) return -1;
      parsed_number=hr*60+mn;
      return 1;
  }
  !   "wpół do ósmej" = 7:30
  if (i=='wpół')
  {   if (NextWord()~='do') return -1;
      hr=LiczbaGodziny(wn++); if (hr<1 || hr>24) return -1;
      parsed_number=((hr-1)*60+30)%(2*TWELVE_HOURS); return 1;
  }
  !   "za kwadrans 7", "za 10 7"
  if (i=='za')
  {   if (NextWord()=='kwadrans') mn=15;
      else { mn=TryNumber(wn-1); if (mn<1 || mn>=60) return -1; }
      hr=LiczbaGodziny(wn++); if (hr<0 || hr>24) return -1;
      parsed_number=(hr*60-mn+2*TWELVE_HOURS)%(2*TWELVE_HOURS); return 1;
  }
  !   "kwadrans po 7", "10 po 7"
  if (i=='kwadrans') mn=15;
  else
  {   mn=TryNumber(wn-1); if (mn<0) return -1;
  }
  if (NextWordStopped()=='po')
  {   hr=LiczbaGodziny(wn++); if (hr<0 || hr>=24 || mn>=60) return -1;
      parsed_number=hr*60+mn; return 1;
  }
  wn--;
  if (i=='kwadrans') return -1;
  !   "7" albo "7 30"
  hr=mn; mn=0;
  if (hr>=24) return -1;
  k=TryNumber(wn);
  if (k>=0 && k<60) { mn=k; wn++; }
  parsed_number=hr*60+mn;
  return 1;
];

[ SetTheTimeSub;
  SetTime(noun,1);
  "Ustawiono godzinę ", (PrintTime) noun, ".";
];
Verb 'czas' 'godzina' * TimeOfDay -> SetTheTime;

! ------------------------------------------------------------------------------

Global third;
[ ThreefoldSub; "Robisz coś z ", (nar) noun, ", ", (nar) second, " i ",
      (nar) third, ".";
];
[ GhostObject x;
  x=NounDomain(player,location,0);
  if (x==REPARSE_CODE) return x;
  if (x==0 or 1) return -1;
  third = x;
  return 0;
];
Verb 'potrój' * noun noun GhostObject -> Threefold;

! ------------------------------------------------------------------------------

[ MegaExam obj; print (CMian) obj, ": "; <Examine obj>; ];
[ MegaLookSub; <Look>; LoopOverScope(MegaExam); ];
Verb meta 'megaspójrz' 'megaopis'  *              -> MegaLook;

! ------------------------------------------------------------------------------

[ ClapSub; "Klaszczesz."; ];
Verb 'klaśnij' 'klaszcz' 'klaskaj' * -> Clap;

! ------------------------------------------------------------------------------

Verb 'powiększ' * noun                          -> Magnify;

! ------------------------------------------------------------------------------
!   Słowa poleceń dla przedmiotów, które słuchają rozkazów: procedura grammar
!   przedmiotu zwraca słowo w rodzaju 'alarm,', które parser bierze za
!   czasownik.
! ------------------------------------------------------------------------------

Verb 'alarm,' * 'włącz'    -> SwitchOn
              * 'wyłącz'   -> SwitchOff
              * TimeOfDay  -> SetTo
              * topic      -> Inv;

!   "marta, daj mi rybę": prośba o przedmiot (bez drugiego dopełnienia).
Extend 'daj' first * 'mi'/'mnie' noun -> Give;

Verb 'tc,'    * noun       -> Examine
              * topic      -> Inv;

[ Crew i;
  switch(scope_stage)
  {  1: rfalse;
     2: objectloop (i has crewmember) PlaceInScope(i); rtrue;
  }
];

Verb 'stc,'   * 'gdzie' 'jest' scope=Crew      -> Examine
              * 'gdzie' 'są' scope=Crew        -> Examine
              * 'zlokalizuj'/'znajdź' scope=Crew -> Examine;

Verb 'rc,'    * held       -> Give
              * topic      -> Inv;

[ Planet;
  switch(NextWord())
  {   'centauro', 'ziemię', 'ziemia': return 1;
      default: return -1;
  }
];

Verb 'zen,'   * 'skanuj' number 'po' 'orbicie'         -> Show
              * 'ustaw' 'kurs' 'na' Planet             -> Go
              * 'prędkość' 'standardowa' number        -> SetTo
              * 'podnieś' held                         -> Take
              * 'przygotuj' held 'do' 'strzału'        -> Drop;

! ------------------------------------------------------------------------------
