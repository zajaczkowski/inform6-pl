  with react_before
       [;  Look: "Nic nie widać przez otaczającą cię pomarańczową chmurę.";
           Go, Exit: "Krążysz w kółko, krztusząc się.";
           Smell: if (noun==0 or self) "Cynamon?  Nie, gałka muszkatołowa.";
       ],
  has  scenery female;

! ------------------------------------------------------------------------------
!   Do odbicia wschodu i zachodu.  Zmienne napisowe @00-@03 to:
!   @00 "wschód", @01 "zachód" (po "na"), @02 "wschodnia", @03 "zachodnia".
! ------------------------------------------------------------------------------

#Ifdef TARGET_ZCODE;
Lowstring east_str "wschód"; Lowstring west_str "zachód";
Lowstring east_adj "wschodnia"; Lowstring west_adj "zachodnia";
#Ifnot;
Constant east_str "wschód"; Constant west_str "zachód";
Constant east_adj "wschodnia"; Constant west_adj "zachodnia";
#Endif;
[ NormalWorld; string 0 east_str; string 1 west_str;
  string 2 east_adj; string 3 west_adj;
  e_obj.door_dir = e_to; w_obj.door_dir = w_to;
];
[ ReversedWorld; string 0 west_str; string 1 east_str;
  string 2 west_adj; string 3 east_adj;
  w_obj.door_dir = e_to; e_obj.door_dir = w_to;
];

Object Room10a "Sala Kierunków"
  with name 'lustro' 'lustra' 'lustrze',
       description
          "Przybudówka Sali 10: główne wyjście prowadzi z powrotem na @01,
           a na północnej ścianie wisi dziwnie zamglone lustro.  Jest też
           wyjście w czwartym, ~hiper~ wymiarze (widocznym tylko w dziwnej
           geometrii tej sali).",
       initial
       [;  move hyper to compass; StartDaemon(hyper);
       ],
       w_to Room10,
       n_to
       [;  print "Przechodzisz przez lustro i kręci ci się w głowie...^";
           if (self has general) NormalWorld(); else ReversedWorld();
           if (self has general) give self ~general; else give self general;
           <<Look>>;
       ],
       in_to [; print "Niesamowite!  Przechodząc, skręcasz się jak korkociąg.^";
                return Room11; ],
  has  light;

Object hyper "hiperwymiarow/y kierun/e/k/"
  with name 'hiper' 'czwarty' 'czwartym' 'wymiar' 'wymiarze', door_dir in_to,
       daemon
       [;  if (location ~= Room10a) { remove self; StopDaemon(self); }
       ],
  has  scenery;

