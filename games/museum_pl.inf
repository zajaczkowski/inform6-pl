               teraz ", the_time/60, ":", (the_time%60)/10,
               the_time%10, ".";
           default: "Tarcza zegara jest za wysoko nad tobą.";
       ],
       react_after [; Look: new_line; <Examine self>; ],
  has  static concealed;

