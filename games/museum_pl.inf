Object -> -> "przycisk automatu"
  has  scenery
 with  parse_name
       [ i flag type;
            for (: flag == 0: i++)
            {   flag = 1;
                switch(NextWord())
                {   'przycisk', 'przycisku', 'guzik', 'guzika', 'z//', 'ze', 'na':
                        flag = 0;
                    'kawa', 'kawę', 'kawy', 'kawą':
                        if (type == 0) { flag = 0; type = 1; }
                    'herbata', 'herbatę', 'herbaty', 'herbatą':
                        if (type == 0) { flag = 0; type = 2; }
                    'cola', 'colę', 'coli', 'colą', 'kola', 'kolę':
                        if (type == 0) { flag = 0; type = 3; }
                }
            }
            if (type==drink.number && i==2 && type~=0 && drink in player)
                return 0;
            self.number=type; return i-1;
        ],
        short_name
        [;  PoPrzyp(self, "przycisk", "przycisku", "przyciskowi", "przycisk",
                "przyciskiem", "przycisku");
            print " automatu"; rtrue;
        ],
        number 0,
        before
        [; Push, SwitchOn:
             if (self.number == 0)
                "Musisz powiedzieć, który przycisk nacisnąć.";
             if (parent(drink) ~= 0) "Automat się zepsuł.";
             drink.number = self.number; move drink to player;
             PronounNotice(drink);
             "Wrrr!  Automat wkłada ci do rąk ", (bie) drink, ".";
           Attack: "Automat się trzęsie i pryska na ciebie colą.";
           Drink:  "Nie da się pić, dopóki nie uruchomisz automatu.";
        ];
Object  drink "napój"
  with  parse_name
        [ i flag type;
            for (: flag == 0: i++)
            {   flag = 1;
                switch(NextWord())
                {   'napój', 'napoju', 'kubek', 'kubka', 'kubkiem', 'z//':
                        flag = 0;
                    'kawa', 'kawę', 'kawy', 'kawą':
                        if (type == 0) { flag = 0; type = 1; }
                    'herbata', 'herbatę', 'herbaty', 'herbatą':
                        if (type == 0) { flag = 0; type = 2; }
                    'cola', 'colę', 'coli', 'colą', 'kola', 'kolę':
                        if (type == 0) { flag = 0; type = 3; }
                }
            }
            if (type ~= 0 && type ~= self.number) return 0;
            return i-1;
        ],
        short_name
        [;  PoPrzyp(self, "kubek", "kubka", "kubkowi", "kubek", "kubkiem",
                "kubku");
            switch (self.number)
            { 1: print " kawy"; 2: print " herbaty"; 3: print " coli"; }
            rtrue;
        ],
        number 0,
        before
        [; Drink: remove self;
            "Fuj, to było okropne.  Zgniatasz kubek i odpowiedzialnie go
             wyrzucasz.";
        ];

