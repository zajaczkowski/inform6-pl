Object -> "torb/a z makramy"
  with name 'makrama' 'makramy' 'siatka' 'siatkę' 'siatki' 'worek' 'worka',
       react_before
       [;  Examine, Search, Listen, Smell: ;
           default:
               if (inp1>1 && inp1 in self)
                   print_ret (CMian) inp1, " ", (nop) PL(inp1, "jest", "są"),
                       " schowan", (nop) Forma(inp1, "y", "a", "e", "e", "i"),
                       " w torbie.";
               if (inp2>1 && inp2 in self)
                   print_ret (CMian) inp2, " ", (nop) PL(inp2, "jest", "są"),
                       " schowan", (nop) Forma(inp2, "y", "a", "e", "e", "i"),
                       " w torbie.";
       ],
       describe
       [;  print "^Z sufitu zwisa ciasno zawiązana torba z makramy";
           if (child(self)==0) ".";
           print ".  W środku widać ";
           ListaWPrzypadku(self, PRZYP_BIE);
           WriteListFrom(child(self), ENGLISH_BIT);
           ListaWPrzypadku(0);
           ".";
       ],
  has  container transparent static female;
