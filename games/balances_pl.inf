       [;  if (self notin location)
           {   remove self; rtrue;
           }
           deadflag = true; remove mace; remove cyclops;
           "Uznawszy, że dał ci już dość czasu na wyjaśnienie, czemu tak mu
            namieszał", (nop) Gracz("eś", "aś"), " w życiu, cyklop w szale
            opuszcza na ciebie wielką maczugę!";
       ],
       each_turn
       [ i; i=random(4); if (i==1) "^Cyklop skacze i ryczy!";
            if (i==2)
              "^Kręcąc maczugą młynka, cyklop bełkocze coś do ciebie.";
            if (i==3)
              "^Cyklop traci cierpliwość (odpowiednie słowo cyklopów jest nie
                do przetłumaczenia, ale z grubsza znaczy ~wstrzemięźliwość
                w nierozbijaniu wszystkich czaszek w pobliżu~).";
            "^Cyklop dźga cię maczugą i prawie łamie ci żebro.";
       ],
  has  animate male transparent;

Object -> mace "maczug/a"
  with name 'ciężka' 'ciężką' 'buzdygan' 'buzdygana' 'topór' 'topora',
