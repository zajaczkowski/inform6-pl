Place Grasslands "Łąki koło chaty"
  with name 'łąki' 'łąka' 'trawa' 'chata' 'chatę' 'chaty' 'ścieżka' 'ścieżkę',
       description
          "Trawy falują nad niskimi wzgórzami we wszystkich kierunkach: to
           spokojna dzicz, której ciszę mącą tylko ta chata i ledwo widoczna
           ścieżka na północ.",
       in_to Hut, e_to Hut,
       n_to Valley,
       cant_go "Przez chwilę błądzisz, ale w końcu wracasz pod chatę.";

Place Valley "Ukryta dolinka"
  with name 'dolina' 'dolinka' 'szlak' 'szlaku',
       description
          "Miła, ukryta dolinka wśród trawiastych wzgórz.  Przebiega przez nią
           szlak z północy na południe.",
       n_to "Szlak się urywa i zawracasz w obawie, że zgubisz się tak, że do
             zmroku nie znajdziesz drogi do chaty.",
       cant_go "Wędrujesz po miłej dolince, ale boisz się stracić z oczu szlak.",
       s_to Grasslands;

[ RideSub; print_ret "Na ", (mie) noun, " raczej się nie pojeździ."; ];

Object -> horse "koń"
  with name 'koń' 'konia' 'koniowi' 'koniem' 'koniu' 'kasztanowy' 'kasztanowego'
            'kasztanowemu' 'kasztanowym' 'kasztan' 'kasztana' 'wierzchowiec'
            'wierzchowca',
       skrzydla 'skrzydlaty' 'skrzydlatego' 'skrzydlatemu' 'skrzydlatym'
            'pegaz' 'pegaza',
       short_name
       [;  if (self has general)
               PoPrzyp(self, "skrzydlaty koń", "skrzydlatego konia",
                   "skrzydlatemu koniowi", "skrzydlatego konia",
                   "skrzydlatym koniem", "skrzydlatym koniu");
           else
               PoPrzyp(self, "kasztanowy koń", "kasztanowego konia",
                   "kasztanowemu koniowi", "kasztanowego konia",
                   "kasztanowym koniem", "kasztanowym koniu");
           rtrue;
       ],
       parse_name
       [ i;
          while (wn <= NumberWords())
          {   if (SlowoW(self, name, wn) ||
                  (self has general && SlowoW(self, skrzydla, wn))) { i++; wn++; }
              else return i;
          }
          return i;
       ],
       describe
       [;  print_ret
              "^Stoi tu ", (mian) self, " i skubie kupkę owsa.";
       ],
       before
       [;  Cast: if (the_spell_was == bozbar_spell)
                 {   give self general;
                    "Na potężnych łopatkach konia nagle wyrastają piękne
                     brązowe skrzydła.  Koń obraca się w kółko z wyrazem
                     zdziwienia na pysku.";
                 }
                 if (the_spell_was == yomin_spell)
                    "Myśli głównie o owsie.  Trochę o tym, kim jesteś i co
                     knujesz, ale głównie o owsie.";
           Enter: <<Ride self>>;
           Ride: if (horse hasnt general)
                    "Jeździsz przez chwilę w kółko, dając koniowi trochę ruchu,
                     ale szybko ma tego dość i z naciskiem odwozi cię z powrotem
                     do owsa.  Uprzejmie zsiadasz, a on znów zaczyna się paść.";

           print "Ruszasz na północ.  Potem, z początku powoli, ale coraz
                  pewniej, koń zaczyna bić potężnymi skrzydłami.  Wznosisz się
                  majestatycznie w powietrze i szybujesz z gracją nad
                  przepaścią, w której urywają się wzgórza.  Koń ląduje
                  łagodnie po drugiej stronie, zostawia cię tam i znów wzbija
                  się w niebo.^";
           PlayerTo(Edge); rtrue;
       ],
  has  animate male;


Object -> oats "kupk/a owsa"
  with name 'owies' 'owsa' 'owsem' 'owsie' 'kupa' 'kupę' 'sterta' 'stertę',
       before
       [;  Examine, Search, LookUnder:
               self.before=NULL;
               move shiny_scroll to player; score=score+5;
               PronounNotice(shiny_scroll);
               "Przesiewając owies, znajdujesz lśniący zwój!  Szczęście, że
                trafił", (nop) Gracz("eś", "aś"), " na niego przed koniem.
                Obracasz go w dłoniach: wygląda na nieuszkodzony.";
           Take:  "Po co ci cały ten owies?";
       ],
  has  scenery female;

Scroll shiny_scroll "lśniąc/y zw/ó=o/j/+u";

Spell -> bozbar_spell
  with name 'bozbar',
       purpose "sprawia, że zwierzęciu wyrastają skrzydła",
       magic
       [;  if (second==0 || second hasnt animate)
               "Zaklęcie gaśnie bez żadnego skutku.";
           if (second==player)
               "Drgają ci łokcie, ale nic poza tym.";
           print_ret "Przez chwilę ", (mian) second,
               " czuje się wyraźnie nieswojo, ale to szybko mija.";
       ],
       unmagic
       [;  if (second==0 || second hasnt animate)
               "Zaklęcie gaśnie bez żadnego skutku.";
           if (second==player) "Jakie skrzydła?";
           if (second==horse && horse has general)
           {   give horse ~general;
               "Zaklinacz dał, Zaklinacz odebrał.  Koń wygląda na
                niepocieszonego, ale wraca do owsa.";
           }
           print_ret (CMian) second, " nie ma skrzydeł, które mógłby stracić.";
       ];

