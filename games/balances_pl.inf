Place In_Cave "W jaskini"
  with description
       [; "Szeroka, ale płytka jaskinia niedaleko w głębi wzgórza.  Nie widać
           żadnego wyjścia poza tym, którym przyszł", (nop) Gracz("eś", "aś"), ".";
       ],
       out_to
       [;  if (CoinsIn(left_pan)+CoinsIn(right_pan) < 6)
               "Coś zagradza ci drogę i słyszysz, jak waga wojowniczo pobrzękuje.
                Chciał", (nop) Gracz("eś", "aś"), " ukraść jej monety!";
           if (scales.number~=0) "Coś zagradza ci drogę i słyszysz, jak waga
               pobrzękuje lekko, pełna energii.";
           return Iron_Door;
       ],
       e_to
       [;  return self.out_to();
       ],
       cant_go "Jedyna droga prowadzi z powrotem ~na zewnątrz~ przez żelazne
                drzwi.",
  has  ~light;

FeaturelessCube -> cave_cube "sześcian"
  with initial "Na skalnym występie balansuje gładki biały sześcian.";

Object -> scales "wag/a"
  with name 'para' 'wagi' 'wagę' 'wagą' 'szale',
       desc_cel "wadze", desc_mie "wadze",
       number 0,
       describe
       [;  print "^Na wsporniku w ścianie jaskini wisi spora waga z dwiema
                  szalkami.  ";
           if (self.number==0)  "Szalki są w równowadze.";
           if (self.number==1)  "Lewa szalka jest wyżej.";
           "Prawa szalka jest wyżej.";
       ],
       before
       [;  "Waga ma lewą i prawą szalkę i o każdej trzeba mówić osobno.";
       ],
  has  static supporter female;

Class  ScalePan
  with name 'szalka' 'szalki' 'szalce' 'szalkę' 'szalką' 'szala' 'szalę',
       before
       [;  Receive:
           if (noun ofclass Scroll or Coin) rfalse;
           if (noun==feather) rfalse;
           "Szalki błyszczą niemal chciwie i jakimś sposobem odpychają ci rękę razem z tym bezwartościowym, nudnym przedmiotem.";
       ],
       after
       [ i j d w1 w2;  Receive, LetGo: i=scales.number;
           objectloop (j in left_pan) w1=w1 + WeightOf(j);
           objectloop (j in right_pan) w2=w2 + WeightOf(j);
           if (w1==w2) scales.number=0;
           if (w1 > w2) scales.number=-1;
           if (w1 < w2) scales.number=1;
           j=scales.number; d=(w2-w1)*(scales.number);
           if (j==i) rfalse;
           if (j==0) "Szalki wagi wyrównują się.";
           if (j==1) print "Lewa szalka "; else print "Prawa szalka ";
           if (d==1) "bardzo powoli unosi się w górę.";
           "unosi się w górę.";
       ],
  has  supporter scenery female;

[ WeightOf obj;
  if (obj==bronze_coin) return 2;
  if (obj ofclass Scroll || obj==feather) return 1;
  return 3;
];

[ CoinsIn obj i c;
  objectloop (i in obj) if (i ofclass Coin) c++;
  return c;
];

ScalePan -> right_pan "praw/a szalk/a" with name 'prawa' 'prawej' 'prawą';
GoldCoin -> ->;
GoldCoin -> ->;
GoldCoin -> ->;

ScalePan -> left_pan "lew/a szalk/a" with name 'lewa' 'lewej' 'lewą';
BronzeCoin -> -> bronze_coin;
GoldCoin -> ->;
GoldCoin -> ->;

Scroll -> -> crumpled_scroll "pognieciony zw/ó=o/j/+u";
Spell  -> -> -> urbzig_spell
  with name 'urbzig',
       purpose "zmienia groźny przedmiot w nieszkodliwy",
       magic
       [;  if (second==0) "Zaklęcie się rozmywa.";
           if (second==player) "To kwestia gustu, prawda?";
           if (second==helistars_book or mace || second ofclass FeaturelessCube)
           {   print (CMian) second; remove second;
               if (second==mace && cyclops in location)
               {   remove cyclops; move eye_cube to location;
                   " zmienia się w gładki biały sześcian dokładnie w chwili, gdy
                    cyklop miał cię nią uderzyć.  Strasznie zawstydzony
                    upuszcza sześcian i ucieka!";
               }
               print " ", (nop) PL(second, "zmienia", "zmieniają"),
                   " się w ćmę i odfruwa.^";
               rtrue;
           }
           print_ret "Nic widocznego się nie dzieje.  Może ", (mian) second,
                     " nie ", (nop) PL(second, "jest", "są"), " wcale
                     aż tak groźn", (nop) Forma(second, "y", "a", "e", "e", "i"), ".";
       ],
       unmagic
       [;  if (second==0) "Zaklęcie się rozmywa.";
           if (second==player) "To kwestia gustu, prawda?";
           if (second has static || second has scenery)
           {   print_ret "Zaklęcie jest za słabe na coś tak monumentalnie
                          nieszkodliwego jak ", (mian) second, ".";
           }
           if (second==helistars_book or snake or cyclops or mace
               || second ofclass FeaturelessCube)
               "Nic widocznego się nie dzieje.";
           if (second in player)
           {   remove second; deadflag = true;
               "Nagle po ramieniu wbiega ci do gardła tarantula!
                Może nie było mądrze zamieniać czegoś, co się akurat
                trzyma w ręce.";
           }
           if (cyclops has general)
               "Nic się nie dzieje.  Może to i lepiej, po tym, co było
                ostatnio.";
           move cyclops to location;
           remove second; give cyclops general; StartTimer(cyclops, 5);
           print_ret "Na miejscu ", (dop) second, " pojawia się zębaty cyklop
                wymachujący maczugą!";
       ];

Object cyclops "zębat/y cyklop/"
  with name 'olbrzym' 'olbrzyma',
       initial "Grozi ci ogromny zębaty cyklop, uzbrojony w ciężką maczugę!",
