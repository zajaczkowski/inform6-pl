Place Edge "Krawędź przepaści"
  with name 'przepaść' 'przepaści' 'droga' 'drogę' 'drogi' 'żonkile' 'kępa',
       description
          "Droga nagle kończy się nad szeroką przepaścią.  Prowadzi pod górę
           na północ, a po południowej stronie przepaści widać, jak biegnie
           dalej.",
       u_to Up_Road, n_to Up_Road,
       cant_go "Do przepaści strach podchodzić.  Jedyna bezpieczna droga
               prowadzi w górę, na północ.",
       before
       [;  Jump, JumpIn, JumpOver: deadflag = true;
              "Dzielnie skaczesz w przepaść i spadasz... z gracją przez
               powietrze.  (Potem robi się nieco mniej szlachetnie
               i przewiewnie.)";
       ];

Object -> snake "sycząc/y w/ą=ę/ż/"
  with name 'żmija' 'żmiję' 'gad' 'gada',
       initial
         "Na krawędzi przepaści leży zwinięty w ciasny kłębek syczący wąż.",
       description
         "Ma jakieś znaki w kształcie litery V, trochę łusek i barwy od
          szarej po rudobrązową.  Czy to coś pomaga?",
       life
       [; "Wąż syczy wściekle!"; ],
       before
       [;  Cast:
               switch(the_spell_was)
               {   urbzig_spell:
                       remove self;
                       snakes_cube.initial =
                    "Obok kępy żonkili leży gładki biały sześcian.";
                       "Na miejscu węża pojawia się kępa żonkili.";
                   bozbar_spell:
                       deadflag = true; remove self;
                       snakes_cube.initial =
                      "W miejscu, z którego wystartował wąż, leży gładki sześcian.";
                      "Wąż zmienia się w ogromnego skrzydlatego gada, smoka,
                       który z rykiem skacze w przepaść, wściekle machając
                       skrzydłami... i zupełnie przypadkiem strąca cię
                       z krawędzi.";
                   yomin_spell:
                      "Wsączają się w ciebie okropne gadzie myśli.";
               }
           Take, Remove:
              "Śliska skóra to tylko jeden z wielu powodów, dla których to
               kiepski pomysł.";
       ],
  has  animate male;

FeaturelessCube -> snakes_cube "sześcian"
  with initial
         "Wąż jest chyba owinięty wokół gładkiego białego sześcianu.",
       before
       [; if (snake notin nothing) "Wąż nie pozwoli ci podejść do tego sześcianu!";
       ];

! ------------------------------------------------------------------------------
!   Grzbiet wzgórza; żółw Ikar; przeżuty zwój
! ------------------------------------------------------------------------------

Place Up_Road "Grzbiet wzgórza"
  with description
          "Droga przecina tu szczyt grzbietu i opada na południe i na
           północny zachód.  Na wschód odchodzi ścieżka.",
       nw_to Cave_Mouth, s_to Edge, d_to Edge, e_to Track;

Object -> tortoise "żółw"
  with name 'żółw' 'żółwia' 'żółwiowi' 'żółwiem' 'żółwiu' 'żółwie',
       desc_dop "żółwia", desc_cel "żółwiowi", desc_bie "żółwia",
       desc_nar "żółwiem", desc_mie "żółwiu",
       initial "Drogą niezwykle powoli człapie żółw.",
       life
       [; "Żółw (powoli) obraca szyję i patrzy na ciebie (tępo).";
       ],
       before
       [; Cast: switch(the_spell_was)
                {   urbzig_spell:
                       "Jak bardzo bezpiecznie ma tu jeszcze być?";
                    bozbar_spell:
                        move chewed_scroll to parent(self); remove self;
                        StartDaemon(self); score=score+5;
                       "Żółw nie jest chyba zdolny do okazania zdziwienia, ale
                        teraz szybuje wysoko w niebie.  Zostawia za sobą coś
                        dość brudnego.";
                    yomin_spell:
                       "Przez chwilę wydaje ci się, że nic tam nie ma, gdy
                        w zamyśleniu przeżuwasz liść.  Ale gdzieś w środku
                        żółwia jest zachwyt nad cudownym błękitnym sklepieniem
                        nieba.";
                }
          Take, Remove:
               "Rodzice zawsze cię ostrzegali, żeby nie zabierać przypadkowych
                znajomych poznanych przy drodze.";
       ],
       daemon
       [ i; if (location ~= Up_Road or Track || random(6)~=1) rfalse;
          if (random(4)==1 && self hasnt general)
          {   move feather to location; give self general;
              "^Pod nogi spływa ci żółwie pióro!";
          }
          i=random(3);
          switch(i)
          {   1: print "^Wysoko na niebie";
              2: print "^Daleko nad tobą";
              3: print "^Maleńki na błękitnym niebie";
          }
          " żółw przelatuje przez tarczę słońca.";
       ],
  has  animate male;

Scroll torn_scroll "podart/y zw/ó=o/j/+u";

Spell -> lobal_spell
  with name 'lobal',
       purpose "wyostrza słuch",
       magic
       [;  if (second==0 || second hasnt animate)
               "W uchu rozlega się głośny huk, ale nic poza tym.";
           if (second==player)
           {   if (hearing_good) "Nic więcej się nie dzieje.";
               hearing_good=1; StartTimer(self, 5);
               "Nic się nie dzieje, może dlatego, że ciągle rozpraszają cię te
                motyle po drugiej stronie wzgórza.";
           }
           print_ret (CMian) second,
              " jest bez wątpienia wdzięczny za dar wyostrzonego słuchu.";
       ],
       unmagic
       [;  if (second==0 || second hasnt animate)
               "Zapada krótka cisza, ale nic poza tym.";
           if (second==player) { StopTimer(self); hearing_good=0; "Słucham?"; }
           print_ret (CMian) second,
              " jest bez wątpienia wdzięczny, że nie musi cię słuchać.";
       ],
       time_left 0,
       time_out
       [;  if (hearing_good)
           {   hearing_good = false;
               "^Te przeklęte motyle wreszcie się zamknęły.";
           }
       ];

Scroll chewed_scroll "przeżut/y zw/ó=o/j/+u"
  with initial "Wygląda na to, że żółw coś jadł - kiedyś mógł to być zwój,
                ale teraz leży tu przeżuty jak liść sałaty.",
       before
       [;  Cast: if (the_spell_was == caskly_spell)
                 {   move torn_scroll to parent(self);
                     remove self; score=score+5;
                     "Na twoich oczach zwój zaczyna się naprawiać i nie udaje
                      mu się to dopiero przy ostatnim rozdarciu.  Może nie
                      całkiem doskonały, ale z pewnością czytelny, choć
                      podarty zwój.";
                 }
           Eat:  "~Zjadanie własnych słów~ jest dla czarodzieja wyjątkowo
                  niebezpieczne.  Przestawione w żołądku zaklęcie mogłoby
                  zrobić cokolwiek!";
       ];

