Object -> dusty_podium "zakurzon/y postument/+u"
  with name 'podium' 'kurz' 'kurzu' 'pajęczyny' 'pajęczyn' 'zakurzone',
       initial "Daleko pod wagą, pośrodku ~podłogi~, stoi postument
                o łatwym do przewidzenia kształcie, ale jest tak zakurzony
                i oblepiony pajęczynami, że nie widać, czym kiedyś był.",
       before
       [;  Cast: if (the_spell_was == caskly_spell)
                    "Niezła próba, ale postument jest chroniony przed czarami.";
                "Choć jest zakurzony, postument wciąż jest chroniony przed
                 przypadkowymi czarami.";
           Rub:  remove self; move balance_key to Balance_Room;
                 PronounNotice(balance_key);
                "Czasem nic nie zastąpi staroświeckiej ciężkiej pracy i po
                 długim, cierpliwym (i pełnym kichania) szorowaniu postument
                 ukazuje się w całej swojej białej chwale.  Osadzone są
                 w nim cztery gniazda, ułożone w kwadrat dwa na dwa.";
       ],
  has  static;

Object balance_key "postument/+u"
  with name 'podium' 'piedestał' 'piedestału' 'platforma' 'platformę'
            'sześcienny' 'sześciennego',
       description "Tak jak można było przewidzieć, jest sześcienny.",
       initial "Daleko pod wagą, pośrodku ~podłogi~, stoi postument o łatwym
                do przewidzenia kształcie.  Osadzone są w nim cztery gniazda,
                ułożone w kwadrat dwa na dwa.",
  has  static supporter;

Object -> sockets "kwadrat/+u dwa na dwa"
  with name 'kwadrat' 'kwadratu',
       before
       [ i;  if (action~=##Examine || number_filled==0)
              "Musisz powiedzieć, o które gniazdo ci chodzi.
               (Nazwijmy je ~lewe górne~, ~prawe dolne~ i tak dalej.)";
           objectloop (i in parent(self))
             if (i ofclass Socket)
             {   print (CMian) i;
                 if (child(i)==0) print " jest puste.^";
                 else { print " zawiera ", (bie) child(i), ".^"; }
             }
           rtrue;
       ],
  has  static;

Class Socket
  with name 'gniazdo' 'gniazda' 'gniazdu' 'gniazdem' 'gnieździe' 'otwór' 'otworu',
       before
       [;  Cast:  "Gniazda są odporne na magię.";
           Examine: print (CMian) self, ", sześcienne i o boku nieco ponad
                    cztery cale, jest ozdobione ", (string) self.description;
                    if (child(self) == nothing) ".";
                    print_ret " i zawiera ", (bie) child(self), ".";
           Receive: if (~~(noun ofclass FeaturelessCube))
                       "Gniazdo tego nie przyjmuje.";
                    if (child(self) ~= nothing)
                       "W tym gnieździe już jest sześcian.";
       ],
       after
       [;  LetGo:  number_filled--;
                   "Z wielkim trudem udaje ci się wyciągnąć sześcian.";
           Receive: number_filled++;
           if (number_filled==4)
           {   if (snakes_cube in bl_socket
                   && barker_cube in ul_socket
                   && cave_cube in br_socket
                   && eye_cube in ur_socket)
               {   deadflag=2; score=score+5;
                  "Kiedy wkładasz ostatni sześcian do gniazda, czujesz, jak
                   przenika cię niebiańska mądrość (bardziej niż zwykle).
                   Rośniesz aż do wysokości sześcianu, tak że możesz ręcznie
                   wyrównać szale wagi, a potem rośniesz jeszcze bardziej, aż
                   wyrastasz ze świątyni, która staje się ledwie sześcianem
                   w twojej dłoni, a ty olbrzymem górującym nad krainą.
                 ^^A potem, rzecz jasna, budzisz się i ponuro uświadamiasz
                   sobie, że czas iść do pracy w nowych Laboratoriach
                   Borphee i do tych wszystkich doświadczeń z mostkiem
                   Wheatstone'a.  Ale przynajmniej możesz pomarzyć
                   o dawnych czasach.";
               }
              "Wszystkie gniazda są już pełne, ale to jeszcze nie znaczy, że
               cokolwiek się stało.";
           }
          "Sześcian pasuje do gniazda doskonale, jak można się było
           spodziewać.";
       ],
  has  static container open neuter;

Socket -> bl_socket "lew/e doln/e gniazd/o"
  with name 'wąż' 'węża' 'wężem',
       desc_mie "lewym dolnym gnieździe",
       description "wężem";

Socket -> ul_socket "lew/e górn/e gniazd/o"
  with name 'bazar' 'bazaru' 'bazarem',
       desc_mie "lewym górnym gnieździe",
       description "sceną z bazaru";

Socket -> br_socket "praw/e doln/e gniazd/o"
  with name 'jaskinia' 'jaskini' 'jaskinią',
       desc_mie "prawym dolnym gnieździe",
       description "rytem skalistej jaskini";

Socket -> ur_socket "praw/e górn/e gniazd/o"
  with name 'oko' 'oka' 'okiem',
       desc_mie "prawym górnym gnieździe",
       description "okiem";

! ------------------------------------------------------------------------------
!   To wszystkie obiekty: zostało jeszcze trochę kodu i gramatyka
! ------------------------------------------------------------------------------

[ Initialise;

  location = Hut;
  move burin to player;
  move players_coin to player;
  move players_book to player;

  thedark.description = OpisCiemnosci;
  ! (W rzeczywistości masz absolutną pewność, że nie, ale mniejsza z tym.)

  players_book.learn_spell(gnusto_spell);
  players_book.learn_spell(frotz_spell);
  players_book.learn_spell(yomin_spell);
  players_book.learn_spell(rezrov_spell);

  helistars_book.learn_spell(frotz_spell);
  helistars_book.learn_spell(lleps_spell);
  helistars_book.learn_spell(mortin_spell);

  give gnusto_spell known_about;

 "^^^^^[Witaj w krótkim opowiadaniu ~Równowaga~, jednej z przykładowych gier
       systemu Inform.  Niektórzy rozpoznają ten świat, a inni mogą zechcieć
       wpisać ~jak działają zaklęcia~ - gra odpowiada na kilka takich
       pytań.]
     ^^Nie bardzo wiesz, jak się tu znalazł", (nop) Gracz("eś", "aś"),
       ".  Coś to miało wspólnego z Helistar!  No właśnie, i z tym, jak
       bardzo świat stracił ostatnio równowagę po Wielkiej Zmianie.^^";
];

[ OpisCiemnosci;
  "Jest zupełnie ciemno.  Możesz tu zostać pożart", (nop) Gracz("y", "a"),
  " przez grue.";
];

[ PrintRank;
  print ", co daje ci tytuł: ";
  if (score >= 50)  "Naukowiec.";
  if (score >= 40)  "Łamacz Zaklęć.";
  if (score >= 30)  "Czarnoksiężnik.";
  if (score >= 20)  "Zaklinacz.";
  if (score >= 10)  "początkujący Zaklinacz.";
  "zagubiony marzyciel.";
];

[ DiagnoseSub;
  switch(memory.capacity)
  {   5: "Czujesz się dobrze, a pamięć masz nienaruszoną.";
      4: "Po otarciu się o śmierć trochę się trzęsiesz, ale umysł masz
          chyba sprawny.";
      3: "Jak na kogoś, kto umarł dwa razy, jesteś w niezłej formie.";
  }
  "Ile razy już umarł", (nop) Gracz("eś", "aś"), "?  Pamięć już nie ta.";
];

! ------------------------------------------------------------------------------
!   Rozszerzenia gramatyki potrzebne do rzucania zaklęć i pisania na
!   sześcianach:
! ------------------------------------------------------------------------------

Include "PolskiG";

[ AnyWord; from_char=0; to_char=0; the_named_word=wn++; return burin; ];

[ QuotedText i j f start len;
   #Ifdef TARGET_ZCODE;
   start = 2; len = buffer->1;
   #Ifnot;
   start = WORDSIZE; len = buffer-->0;
   #Endif;
   i = WordAddress(wn++); i=i-buffer;
   if (buffer->i=='"')
   {   for (j=i+1:j<start+len:j++)
           if (buffer->j=='"') f=j;
       if (f==0) return -1;
       from_char = i+1; to_char=f-1;
       if (from_char>to_char) return -1;
       while (wn <= NumberWords() && buffer+f > WordAddress(wn)) wn++;
       wn++;
       return burin;
   }
   return -1;
];

Verb 'napisz' 'wypisz' 'wyryj' 'wygraweruj'
                * AnyWord 'na' held              -> WriteOn
                * QuotedText 'na' held           -> WriteOn;
Verb 'skopiuj' 'przepisz'
                * scope=CopyableSpell 'na'/'do' noun  -> CopyTo;
Verb 'kim' 'kto' 'czym' 'jak'
                * 'czuję'                        -> Diagnose
                * scope=Topic                    -> Query
                * 'jest'/'był'/'była'/'było'/'to' scope=Topic -> Query
                * 'to' 'jest'/'był'/'była'/'było' scope=Topic -> Query;
Extend 'co'
                * scope=Topic                    -> Query
                * 'jest'/'był'/'była'/'było'/'to' scope=Topic -> Query
                * 'to' 'jest'/'był'/'była'/'było' scope=Topic -> Query;
Verb 'zaklęcia' 'czary' 'pamięć'
                *                                -> Spells;
Verb 'naucz' 'ucz' 'zapamiętaj' 'wykuj'
                * scope=ReadableSpell            -> Learn;
Extend 'obejrzyj' first
                * scope=ReadableSpell            -> Examine;
Extend 'przeczytaj' first
                * scope=ReadableSpell            -> Examine;
Verb 'c,cast'
                *                                -> CastOne
                * noun                           -> CastOne
                * 'na'/'w//' noun                -> CastOne;
Extend 'rzuć' first
                * is_spell                       -> Cast
                * is_spell 'na'/'w//' noun       -> Cast;
Verb 'czaruj' 'zaczaruj'
                * noun is_spell                  -> Cast reverse
                * is_spell                       -> Cast;
Verb 'diagnoza' 'zdrowie' 'stan'
                *                                -> Diagnose;
Extend 'zetrzyj'
                * 'kurz' 'z//'/'ze' noun         -> Rub;

! ------------------------------------------------------------------------------
!   I jeszcze gramatyka samej opowieści.
! ------------------------------------------------------------------------------

Verb 'dosiądź' 'ujeżdżaj' 'osiodłaj'
                * creature                       -> Ride
                * noun                           -> Enter;
Verb 'jedź' 'pojedź' 'galopuj' 'leć' 'poleć'
                * creature                       -> Ride
                * 'na' creature                  -> Ride
                * 'na' noun                      -> Enter;
Verb 'podrzuć'  * is_coin                        -> TossCoin;
! ------------------------------------------------------------------------------
