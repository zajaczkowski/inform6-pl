Place Cave_Mouth "Wylot jaskini"
  with name 'janowiec' 'janowca' 'ścieżka' 'ścieżkę' 'jaskinia' 'jaskini' 'wylot',
       description
          "To wylot jaskini na końcu drogi, która wije się na południowy
           wschód po wznoszącym się terenie.  Wejście do jaskiń na zachodzie
           to ciemny tunel, a na północ, w zarośla janowca, prowadzi już
           tylko wąska ścieżka.",
       u_to Up_Road, se_to Up_Road, in_to Iron_Door, w_to Iron_Door,
       n_to Footpath;

Object -> Iron_Door "żelazn/e drzwi/"
  with name 'ciężkie' 'ciężkich' 'wrota',
       description "Wyglądają jak zwyczajne ciężkie żelazne drzwi.",
       door_dir
       [; if (location==Cave_Mouth) return w_to; return e_to;
       ],
       door_to
       [; if (location==Cave_Mouth) return In_Cave;
          return Cave_Mouth;
       ],
       describe
       [; if (self has open) "^Żelazne drzwi stoją otworem.";
          if (self hasnt locked) "^Żelazne drzwi są zamknięte, ale nie na klucz.";
          "^Wylot jaskini zagradzają ciężkie żelazne drzwi.";
       ],
       found_in  In_Cave  Cave_Mouth
  has  static door openable locked lockable pluralname;

!  Por. T. S. Eliot, "Burnt Norton" II
!  (ale zob. też sonet Mallarmégo, z którego Eliot zapożyczył ten obraz)

Object -> sapphire "doskonał/y szafir/+u"
  with name 'klejnot' 'klejnotu' 'kamień' 'kamienia',
       initial "Przy drzwiach tkwi w błocie doskonały szafir.",
       before
       [;  Examine: remove self; move caskly_spell to memory;
                    players_book.learn_spell(caskly_spell);
                    caskly_spell.number=100;
                    "Kiedy wpatrujesz się w doskonały błękit szafiru, w głowie
                     zaczyna ci się kręcić.  Nie mogąc znieść nagiego widoku
                     doskonałości, ze wstydem odwracasz wzrok.  Wtedy szafir
                     pęka i rozsypuje się w cienki, gorący pył.  Ale coś
                     zostaje, coś w umyśle...";
       ];

Spell caskly_spell
  with name 'caskly',
       purpose "sprawia, że rzecz staje się doskonała",
       magic
       [;  if (second==0) "Próba uczynienia doskonałym wszystkiego naraz była
                           odrobinę zbyt ambitna.";
           if (second==player) "Oj, nie bądź dla siebie zbyt surow",
                               (nop) Gracz("y", "a"), ".";
           if (second==helistars_book)
               "Zaklęcie jest za słabe, żeby odtworzyć brakujące strony.";
           print_ret (CMian) second, " ", (nop) PL(second, "wygląda", "wyglądają"),
               " na wystarczająco doskonał", (nop) Forma(second, "y", "ą", "e", "e"),
               " i bez tego.";
       ];

