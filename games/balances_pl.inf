Object -> carpet "piękn/y czerwon/y dywan/+u"
  with name 'magiczny' 'magicznego' 'magicznym' 'kobierzec' 'kobierca',
       initial
          "Na jednym z krzaków janowca jest przewieszony piękny czerwony dywan.",
       description
          "To dywan o niezwykłym wzorze.  Jest czerwony, pięknie tkany
           i ozdobiony deseniem z sześcianów.",
       before
       [ i;  Receive:
                 if (self notin location || self hasnt moved)
                     "Dopóki dywan nie leży na ziemi, nic z tego.";
           Ride: <<Enter self>>;
           Enter:
                 if (self notin location || self hasnt moved)
                     "Dopóki dywan nie leży na ziemi, nic z tego.";
                 if (location==Balance_Room)
                     "Dywan tajemniczo marszczy się i szarpie, aż cię z siebie
                      zrzuca.  Potem z zadowolonym westchnieniem układa się
                      z powrotem na białej podłodze.";
                 if (location==In_Cave)
                     "Dywan nagle się wznosi, uderza w strop jaskini i zrzuca
                      cię z siebie.  Boleśnie.";
                 if (location==Bazaar) i=Up_Road; else i=Bazaar;
                 print "Dywan nagle wzbija się w puszyste białe obłoki i po
                        szaleńczej podróży wysadza cię...^";
                 move self to i;
                 PlayerTo(i,1); move player to self; <<Look>>;
           Take: if (player in self) "Nie wtedy, gdy na nim jesteś!";
                 for (i=child(self):i~=0:i=child(self))
                 {   move i to location;
                     print "(Spada z niego ", (mian) i, ".)^";
                 }
       ],
  has  supporter enterable;

! ------------------------------------------------------------------------------
!   Loteria na bazarze
!
!   Losy są tworzone w czasie gry (Ticket.create()): klasa Ticket(6) oznacza,
!   że może istnieć najwyżej sześć takich obiektów naraz.
! ------------------------------------------------------------------------------

Global last_called = 1;
Global explicit_flag = 0;
Global tickets_taken = 0;

Class Ticket(6)
  with number -1,
       description
       [;  if (self.number==2306) "Napisano na nim: ~Pierwsza nagroda~!";
           if (self.number==5802) "Napisano na nim: ~Dziewiętnasta nagroda~.";
           "~Przegrywasz~, mówi los z uśmiechniętą buźką.  ~Spróbuj jeszcze raz!~";
       ],
       short_name
       [;  if (self.number==-1)
           {   PoPrzyp(self, "zwinięty los", "zwiniętego losu", "zwiniętemu
                   losowi", "zwinięty los", "zwiniętym losem", "zwiniętym losie");
               print " z tablicy";
               rtrue;
           }
           PoPrzyp(self, "los", "losu", "losowi", "los", "losem", "losie");
           print " numer ", self.number; rtrue;
       ],
       parse_name
       [ i j w;
           i=0;
           if (NextWord()=='loteryjny' or 'loteryjnego' or 'loteryjnemu'
                   or 'loteryjnym' or 'zwinięty' or 'zwiniętego') i++; else wn--;
           if (NextWord()=='losy' or 'losów' or 'losom' or 'losami' or 'losach')
           {   parser_action=##PluralFound; return i+1; } else wn--;
           if (NextWord()~='los' or 'losu' or 'losowi' or 'losem' or 'losie'
                   or 'bilet' or 'biletu') return 0;
           i++;
           if (NextWord()=='numer' or 'nr' or 'numerze' or 'numerem') i++; else wn--;
           w=TryNumber(wn);
           if (w==-1000) { explicit_flag = false; return i; }
           if (w==0) return 0;
           if (self.number==-1)
           {   objectloop(j ofclass Ticket)
                   if (w == j.number) return 0;
           }
           else
           {   if (self.number~=w) return 0;
           }
           i++; last_called = w; explicit_flag = true; return i;
       ],
       before
       [;  Examine:
               if (self in board)
                  "Zaglądanie do zwiniętych losów, które jeszcze tkwią
                   w tablicy, byłoby oszustwem.";
           Cast: "~Spadaj stąd, koleś!~, mówi naganiacz z obrzydzeniem.";
       ];

Place Bazaar "Zatłoczony bazar"
  with description
           "To zatłoczony, gwarny bazar.  Tuż przed tobą jest loteria!  Ale
            pogardliwie wyglądającemu naganiaczowi idzie bardzo słabo: mało
            kto chce jego pierwszą nagrodę, wielkiego pluszowego słonia,
            a nawet dziewiętnastą, gładki biały sześcian.",
       each_turn
       [;   switch(random(4))
            {   1: "^~Podchodźcie!  Podchodźcie!  Jedna srebrna moneta za trzy
                    losowania!~";
                2: "^~No dalej!  Za jedną srebrną monetę aż trzy losy!~";
                3: "^~Pomyślcie, co można wygrać za jedną srebrną monetę!~";
                4: "^~To może być wasz szczęśliwy dzień!~";
            }
       ],
       before
       [;   Learn:
                "~Żadnych takich!~ warczy ze złością naganiacz i wybija cię
                 z rytmu nauki.  Mamrocze coś o ~oszustach Zaklinaczach~, ale
                 w tych okolicznościach postanawiasz puścić tę zniewagę
                 płazem.";
       ],
       cant_go "Wszędzie tłumy trajkoczących tubylców zagradzają ci drogę do
           co lepszych straganów.  Właściwie jedyny, do którego możesz się
           dopchać, to ta żałosna loteria.";

Object -> board "tablic/a loteryjn/a!"
  with credit 0,
       name 'otwory' 'otworów' 'dziurki' 'dziurek' 'loteria' 'loterię' 'loterii',
       description
           "Ma po sto otworów w każdą stronę, co daje, hm, zaraz, tak,
            dziesięć tysięcy losów.  Ale nagród jest dziewiętnaście, więc
            szanse muszą być, no, w każdym razie nie najgorsze.",
       before
       [ i; LetGo:
                if (self.credit == 0)
                   "Naganiacz dźga cię palcem w pierś.  ~Najpierw srebrna
                    moneta, koleś!~";

                if (explicit_flag)
                {   objectloop (i ofclass Ticket)
                        if (last_called == i.number)
                            "Ten los ktoś już wyciągnął.";
                }
                else
                {   .RandomChoice;
                    last_called = random(10000);
                    objectloop (i ofclass Ticket)
                        if (last_called == i.number)
                            jump RandomChoice;
                }

                tickets_taken++;
                self.credit--;

                i = Ticket.create();
                if (i == 0)
                   "Naganiacz wygląda na metafizycznie zakłopotanego.  ~Yyy,
                    system tworzenia obiektów Informu chyba nie zadziałał.~";

                i.number = last_called; PronounNotice(i);

                move i to player; give i moved proper;
                if (explicit_flag==0)
                    print "Losując spośród ", 10001-tickets_taken,
                          " numerowanych otworów, w których są jeszcze losy,
                          wyciągasz z tablicy ";
                    else print "Wyciągasz z tablicy ";
                print_ret (bie) i, ".";

            Examine: ;
            Receive:
                if (noun ofclass Ticket)
                   "~Nie ma zmieniania zdania, ten los jest teraz twój!  Daj mi
                     go, jeśli chcesz zagrać.~";
                <<Push self>>;
            default:
                "Naganiacz jest krzepki i nie pozwoli ci majstrować przy
                 tablicy.";
       ],
       initial
           "Za naganiaczem stoi ogromna nawiercona tablica, a w każdym
            numerowanym otworku tkwi zwinięty los na loterię."
  has  static container open female;

Ticket -> -> ticket_in_board;

Object -> barker "naganiacz/"
  with name 'krzepki' 'krzepkiego' 'mężczyzna' 'mężczyznę' 'mężczyzny' 'facet'
            'faceta' 'sprzedawca' 'sprzedawcę' 'sprzedawcy',
       number 0,
       description
       [; "Podstarzały bokser, któremu nie wyszło jako magikowi na całym
            wybrzeżu, tak byś obstawiał", (nop) Gracz("", "a"), ".";
       ],
       life
       [;  Attack, Kiss: "Nie ma mowy.  Waży chyba dwa razy tyle co ty.";
           Ask:  switch(second)
                 {   'nagroda', 'nagrodę', 'nagrody', 'nagród', 'nagrodach':
                         "~Tylko jedna srebrna moneta i nagroda może być
                          twoja!~";
                     'biały', 'gładki', 'sześcian', 'białym', 'gładkim',
                     'sześcianie', 'sześciany', 'sześcianach':
                         "Zdmuchuje z niego kurz.  ~Prawdziwy antyk.~";
                     'słoń', 'słoniu', 'słonia', 'zabawka', 'zabawkę',
                     'zabawce', 'pluszowy', 'pluszowym', 'pluszaku':
                         "~Towar dobrej jakości~, mówi tonem, który sugeruje,
                          że z tych trzech słów potrafiłby przeliterować
                          najwyżej jedno.";
                     'los', 'losy', 'losie', 'losach', 'loteria', 'loterię',
                     'loterii', 'bilet', 'bilety':
                         "~Trzy losy za jedną srebrną monetę!~";
                     default: "~Po prostu graj, koleś.~";
                 }
           Order, Answer: "Naganiacz patrzy na ciebie spode łba.";
           Give: if (noun ofclass Ticket)
                 {   remove noun;
                     if (noun.number==2306)
                     {   move elephant to player; give elephant moved;
                         remove pelephant;
                         Bazaar.description =
           "To zatłoczony, gwarny bazar.  Tuż przed tobą jest loteria!";
                         "Z bardzo kwaśną miną naganiacz wciska ci w ramiona
                          pluszowego słonia.";
                     }
                     if (noun.number==5802)
                     {   move barker_cube to player; give barker_cube moved;
                         remove pcube;
                         Bazaar.description =
           "To zatłoczony, gwarny bazar.  Tuż przed tobą jest loteria!";
                         score=score+5;
                         "Z ukrywaną ulgą naganiacz wciska ci do rąk gładki
                          biały sześcian.";
                     }
                     "~Pech!  Przegrywasz!~";
                 }
                 if (self.number==2) "~Dość już się nagrał", (nop) Gracz("eś",
                     "aś"), "!~ warczy.  Nic dziwnego, że interes kiepsko idzie.";
                 if (~~(noun ofclass Coin))
                     "~A to co ma być?  Jedna srebrna moneta i grasz!~";
                 if (noun.typ == 3)
                     "~Brązowa!  Nie ma mowy, słoneczko.~";
                 remove noun;
                 board.credit = board.credit + 3;
                 self.number++;
                 if (noun.typ == 1)
                     "Naganiacz z radością chwyta złotą monetę.  ~Sorry,
                      koleś, nie wydaję reszty.  Interes dziś słabo idzie!~";
                 "Naganiacz niechętnie bierze srebrną monetę, zakłada ręce i odsuwa się, żeby dopuścić cię do tablicy.";
       ],
       before
       [;  Cast: switch(the_spell_was)
                 {   bozbar_spell:
                        "Aż takie zwierzę to on nie jest.";
                     lobal_spell:
                        "Jego problemem jest słuchanie, nie słyszenie.";
                     caskly_spell:
                        "Przez chwilę jego włosy jakby same się czeszą.
                         Zirytowany, znów je mierzwi i zaklęcie umiera
                         haniebną śmiercią.";
                     yomin_spell:
                         if (elephant has moved || barker_cube has moved)
                         "W głowie naganiacza kłębią się utyskiwania na
                          stracone nagrody i chuderlawych Zaklinaczy.";
                         if (self hasnt general)
                         {   give self general;
                            "~Oby ten chuderlawy Zaklinacz nie wyciągnął 2306!~
                             myśli naganiacz (powoli).";
                         }
                         "~Jeśli ten frajer już wygra, to oby tylko bezwartościowe
                          stare 5802~, rozmyśla naganiacz.";
                 }
       ],
  has  animate male scenery;

Object -> prizes "nagrod/y"
  with name 'nagroda' 'nagrodę',
       desc_dop "nagród",
       before [; "~Łapy precz od nagród!~"; ],
  has  scenery pluralname female;

Object -> pelephant "pluszowy słoń"
  with name 'nagroda' 'słoń' 'słonia' 'słoniowi' 'słoniem' 'słoniu' 'pluszowy'
            'pluszowego' 'pluszowym' 'zabawka' 'zabawkę' 'pluszak' 'pluszaka',
       desc_dop "pluszowego słonia", desc_cel "pluszowemu słoniowi",
       desc_bie "pluszowego słonia", desc_nar "pluszowym słoniem",
       desc_mie "pluszowym słoniu",
       description "Różowy.  Pluszowy.  Zabawkowy.  Słoń.  Wszystko jasne.",
       before [; Examine: ; default: "~Łapy precz od nagród!~"; ],
  has  scenery;

Object -> pcube "biał/y sześcian/+u"
  with name 'nagroda' 'nagrodę' 'gładki' 'gładkiego' 'kostka' 'kostkę',
       description
       [; "Nie chciał", (nop) Gracz("byś", "abyś"), " go wygrać?";
       ],
       before [; Examine: ; default: "~Łapy precz od nagród!~"; ],
  has  scenery;

Object elephant "pluszowy słoń"
  with name 'słoń' 'słonia' 'słoniowi' 'słoniem' 'słoniu' 'pluszowy'
            'pluszowego' 'pluszowym' 'zabawka' 'zabawkę' 'pluszak' 'pluszaka',
       desc_dop "pluszowego słonia", desc_cel "pluszowemu słoniowi",
       desc_bie "pluszowego słonia", desc_nar "pluszowym słoniem",
       desc_mie "pluszowym słoniu",
       description "Różowy.  Pluszowy.  Zabawkowy.  Słoń.  Wszystko jasne.",
       before
       [;  Cast: if (the_spell_was == bozbar_spell)
                     "Niech no się upewnię.  Ty, Zaklinacz, który pokonał
                      Krilla, samego przywódcę Gildii z Borphee...  próbujesz
                      wyhodować skrzydła różowemu pluszowemu słoniowi?";
                 if (the_spell_was == yomin_spell) "Puchato.";
       ];

FeaturelessCube barker_cube "sześcian";

! ------------------------------------------------------------------------------
!   Zaklęcia z księgi czarów Helistar
! ------------------------------------------------------------------------------

Spell lleps_spell
  with name 'lleps',
       purpose "odwraca działanie zapamiętanego zaklęcia",
       magic
       [;   if (second==0 || second notin memory)
                "Zaklęcie obraca się przeciwko tobie.  Boli.";
            if (second.number==100)
                "Znasz to zaklęcie zbyt dobrze, żeby umysł mógł przyjąć
                 taką zmianę.";
            if (second has reversed) give second ~reversed;
            else give second reversed;
            if (second==lleps_spell)
            {    memory.forget_spell(second);
                "Coś skręca ci się w głowie, gdy dwa zaklęcia lleps znoszą się
                 nawzajem, zostawiając tylko uczucie bardzo podobne do kaca.";
            }
            print_ret "Coś skręca ci się w głowie, gdy ", (mian) second,
                      " odwraca się na drugą stronę.";
       ],
       unmagic
       [;   return self.magic();         !  odwrotnością "lleps" jest "lleps"
       ];

Spell mortin_spell
  with name 'mortin',
       purpose "powoduje natychmiastową śmierć rzucającego",
       magic
       [;   deadflag = true;
            "W tym przypadku naprawdę nie można nic zarzucić Helistar.
             Śmierć jest absolutnie natychmiastowa, jak nagle zaciągnięta czarna kotara...";
       ],
       unmagic
       [;   prepared_flag = true;
            "Właściwie nic się nie dzieje... a jednak czujesz się o wiele
             pewniej w tym niebezpiecznym świecie.";
       ];

! ------------------------------------------------------------------------------
!   Śmierć i kostnica
! ------------------------------------------------------------------------------

[ AfterLife;
  if (~~prepared_flag) rfalse;

  if (player in Balance_Room)
      "^^Zapobiegliwe przygotowanie zmartwychwstania poszło na marne.  Splątana magia Komnaty Równowagi owinęła się wokół twojego
         marnego zaklęcia jak dusiciel.";

  prepared_flag = false; deadflag = false; hearing_good = false;

  if (memory.capacity >= 2) memory.capacity--;

  while (child(player)~=0) move child(player) to parent(player);
  move players_book to player;

  print "^^Z wielką zapobiegliwością przygotował", (nop) Gracz("eś", "aś"),
        " się na zmartwychwstanie...  Umysł masz trochę słabszy, ale
        przynajmniej żyjesz.^";
  PlayerTo(Boneyard);
];

Place Boneyard "Kostnica"
  with name 'kości' 'kość' 'łopatki' 'czaszki' 'czaszka',
       description
          "To komnata z kości.  Podłogę tworzą łopatki, ściany czaszki,
           a futryny drzwi kości nóg.  Wyjście na zachodzie prowadzi
           w ciemność, ale przez drzwi na północy widać na pozór całkiem
           zwyczajny widok.",
       n_to
       [;  if (scales.number ~= 0) return In_Cave;
           return Grasslands;
       ],
       w_to "Drogę zagradza ci jakaś magiczna siła, jakby te drzwi prowadziły
             do przygód z twojej przeszłości, do których nie możesz już wrócić.",
       before
       [;  Examine, Search:
               if (noun==w_obj) "Na zachodzie nie da się niczego dojrzeć.";
       ];

Scroll -> worthless_scroll "bezwartościow/y zw/ó=o/j/+u"
  with initial "Prawie depczesz po bezwartościowym zwoju.";

Spell -> -> filfre_spell
  with name 'filfre',
       purpose "wytwarza zbędne fajerwerki",
       magic
       [;    if (self hasnt scored) { score++; give self scored; }
            "Krótki pokaz zbędnych fajerwerków układa się w napis:
           ^^Mistrzowską trylogię Enchanter napisali Marc Blank,
             Dave Lebling i Steve Meretzky.";
       ],
       unmagic
       [;   "Długi pokaz artystycznie uzasadnionych fajerwerków układa się
             w napis:
           ^^Mistrzowską trylogię Enchanter napisali Jane Austen,
             Emily Brontë i Edgar Allan Poe.";
       ];

! ------------------------------------------------------------------------------
!   Sześcienna świątynia
! ------------------------------------------------------------------------------

Place Track "Ścieżka przed świątynią"
  with description
          "Tu kończy się długa ścieżka, która wije się przez pustkowie wzgórz
           i biegnie z powrotem na zachód, w górę, na grzbiet.",
       before
       [;   Listen:
                if (~~hearing_good) "Śpiew jest za cichy, żeby go zrozumieć.";
                "Niekończący się, powtarzany tren mnichów opowiada legendę
                 o kimś, kto pewnego dnia oświeci ich zakon i dzięki temu
                 zostanie wyniesiony na wyższy poziom istnienia.  On (albo
                 ona, jak można przypuszczać) nazywany jest Tym, Który Jest
                 Czterema Sześcianami.";
       ],
       w_to Up_Road, u_to Up_Road;

Object -> Temple "sześcienna świątynia"
  with name 'świątynia' 'świątyni' 'świątynię' 'świątynią' 'sześcienna'
            'sześcienną' 'sześciennej' 'sześcian' 'ogromna' 'ogromną',
       desc_dop "sześciennej świątyni", desc_cel "sześciennej świątyni",
       desc_bie "sześcienną świątynię", desc_nar "sześcienną świątynią",
       desc_mie "sześciennej świątyni",
       before
       [ i j;
         Enter: "Świątynia jest gładka i bez żadnej skazy.  Może jest otwarta
                 od góry, bo dźwięk musi skądś dochodzić... ale nie
                 założył", (nop) Gracz("byś", "abyś"), " się o to.";
         Cast:   switch(the_spell_was)
                 {   rezrov_spell:
                        "Ogromna świątynia pozostaje niewzruszona wobec twojego
                         stosunkowo marnego zaklęcia.";
                     frotz_spell:
                         objectloop (i in player)
                             if (i ofclass FeaturelessCube) j++;
                         if (j==0)
                             "Świątynia drży, ale zaraz znów nieruchomieje.";
                         if (j<4) "Świątynia drży!  Białe światło igra na twoich
                             dłoniach i rzeczach, ale potem wszystko znów
                             nieruchomieje.";
                         print "Świątynia drży, a ciebie zalewa białe światło.
                             Płynnie rozkłada się w czterowymiarowy sposób,
                             który zmysły ledwie ogarniają.  Wiesz
                             tylko tyle, że kiedy jest po wszystkim,
                             znajdujesz się w...^";
                         hearing_good = false; score=score+5;
                         PlayerTo(Balance_Room); rtrue;
                 }
       ],
       describe
       [;   print "^Stoisz przed ogromną świątynią w kształcie doskonałego,
                   gładkiego białego sześcianu o boku czterystu stóp.  Gdzieś
                   z jej wnętrza dochodzi ";
            if (hearing_good) print "ryczący";
            else print "cichutki";
            " śpiew mnichów.";
       ],
       description
       [;  "Wygląda zupełnie jak każda inna gigantyczna świątynia
            w kształcie gładkiego białego sześcianu, jaką kiedykolwiek
            widział", (nop) Gracz("eś", "aś"), ".  Nie widać żadnego wejścia.";
       ],
  has  static female;

! ------------------------------------------------------------------------------
!   W świątyni
! ------------------------------------------------------------------------------

Place Balance_Room "Komnata Równowagi"
  with description
           "To chyba wnętrze gładkiego białego sześcianu o boku czterdziestu
            stóp.  Powietrze jest stęchłe i nie ma stąd wyjścia.";

Object -> balance_meter "obraz/+u wagi"
  with name 'wizerunek' 'wizerunku' 'waga' 'wagę' 'szalki' 'szale',
       initial "Wysoko w powietrzu wisi obraz wagi.  Jedna szalka jest
                o wiele niżej niż druga.",
       before
       [; "To tylko obraz.";
       ],
