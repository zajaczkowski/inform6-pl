! DM4 §17, zmieniony w §18 i §23
Object  priest "zmumifikowan/y kapłan/"
  with  name 'mumia' 'mumii' 'mumię' 'mumią' 'kapłan-kalendarzysta',
        initial
            "Za płytą stoi i czeka zmumifikowany kapłan, w najlepszym razie
             ledwie żywy, niewyobrażalnie sędziwy.",
        description
            "Jest wysuszony i trzyma się w całości wyłącznie siłą woli.
             Choć jego pierwszym językiem był zapewne miejscowy dialekt Majów,
             masz dziwne przeczucie, że zrozumie twoją mowę.",
        life [;
            Answer:
                "Kapłan kaszle i omal nie rozpada się na kawałki.";
            Ask: switch (second) {
                'słownik', 'słownika', 'słowniku', 'książkę', 'książka',
                'książce', 'księgę', 'księga', 'księdze':
                    if (dictionary.correct == false)
                        "~Glif @<<ptak@>>... bardzo zabawne.~";
                    "~Słownik? Doprawdy?~";
                'glif', 'glify', 'glifach', 'glifie', 'majów', 'majach',
                'dialekt', 'dialekcie', 'pismo', 'piśmie':
                    "~W naszej kulturze kapłani zawsze umieją czytać.~";
                'władcę', 'władca', 'władcy', 'grób', 'grobie', 'grobowiec',
                'grobowcu', 'sanktuarium', 'świątynię', 'świątynia',
                'świątyni':
                    "~To sprawa prywatna.~";
                'malowidła', 'malowidło', 'malowidłach', 'malowidle':
                    "Kapłan od kalendarza marszczy brwi. ~10 baktunów,
                     4 katuny, to daje 1 468 800 dni od początku czasu:
                     w waszym kalendarzu 19 stycznia 909 roku.~";
                'ruiny', 'ruinach', 'ruinę':
                    "~Ruiny zawsze pokonają złodziei. W podziemnym świecie
                     rabusie są torturowani przez całą wieczność.~ Pauza.
                     ~Tak samo jak archeolodzy.~";
                'sieć', 'sieci', 'chodniki', 'chodnikach', 'robacze',
                'robaczych':
                    "~Nikt nie przejdzie przez Robacze Chodniki.~";
                'xibalba', 'xibalbę', 'xibalbie', 'xibalby':
                    if (Shrine.sw_to == Junction)
                        "Kapłan grozi ci kościstym palcem.";
                    Shrine.sw_to = Junction;
                    "Kapłan wyciąga kościsty palec na południowy zachód,
                     w stronę sopli, które znikają jak szron, gdy przemawia.
                     ~Xibalb@'a, Podziemny Świat.~";
                }
                print "~Odpowiedź musisz znaleźć ";
                Gracz("sam", "sama");
                ".~";
            Tell:
                "Kapłana nie interesuje twoje nędzne życie.";
            Attack, Kiss:
                remove self;
                "Kapłan wysycha i rozsypuje się w pył, aż nic po nim nie
                 zostaje - ani podmuch, ani kość.";
            ThrowAt:
                move noun to location; <<Attack self>>;
            Show, Give:
                if (noun == dictionary && dictionary.correct == false) {
                    dictionary.correct = true;
                    "Kapłan czyta fragment księgi, śmiejąc się głuchym,
                     szepczącym śmiechem. Nie mogąc powstrzymać wesołości,
                     nanosi gdzieś poprawkę, po czym oddaje ci księgę.";
                }
                if (noun == newspaper)
                    "Kapłan spogląda na datę. ~12 baktunów 16 katunów 4 tuny
                     1 uinal 12 kinów~, oznajmia, po czym przegląda pierwszą
                     stronę. ~Ach. Postęp, jak widzę.~";
                "Kapłana nie interesują rzeczy ziemskie.";
            ],
        orders [;
            Go:
                "~Nie wolno mi opuszczać sanktuarium.~";
            NotUnderstood:
                "~Mówisz zagadkami.~";
            default:
                "~Nie twoim rozkazom służę.~";
            ],
  has   animate male;

