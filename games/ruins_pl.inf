! DM4 ćwiczenie 22, zmieniona w ćwiczeniu 55
Object  -> cage "żelazn/a klatk/a"
  with  name 'kraty' 'krat' 'kratami' 'kratach' 'pręty' 'prętów' 'prętami'
             'rama' 'ramy' 'ramę' 'ramie' 'glify' 'glifów' 'glifach',
        description
            "Glify głoszą: Ptak Strzała Guziec.",
        inside_description [;
            if (self.floor_open)
                "Z dna klatki w głąb komory grobowej prowadzi otwarty
                 ziemny szyb.";
            "Otaczają cię pręty klatki.";
            ],
        when_open
            "Złowieszczo majaczy tu klatka z żelaznych prętów, dość duża,
             by zmieścić się w niej w pochyleniu. Jej drzwiczki są otwarte.
             Na ramie widnieją jakieś glify.",
        when_closed
            "Żelazna klatka jest zamknięta.",
        after [;
            Enter:
                print "Szkielety zamieszkujące klatkę ożywają, zaciskają na
                       tobie kościste dłonie, miażdżą cię i okładają. Tracisz
                       przytomność, a gdy ją odzyskujesz, okazuje się, że
                       wydarzyło się coś groteskowego i niemożliwego...^";
                move warthog to Antechamber;
                remove skeletons;
                give self ~open;
                give warthog light;
                self.after = 0;
                ChangePlayer(warthog, 1);
                <<Look>>;
            ],
        react_before [;
            Go:
                if (noun == d_obj && self.floor_open) {
                    PlayerTo(Burial_Shaft);
                    rtrue;
                }
            ],
        floor_open false,
  has   enterable transparent container openable open static female;

! ćwiczenie 55
Object  -> -> skeletons "obłąkan/e szkielet/y"
  with  name 'szkielet' 'szkieletu' 'kości' 'kośćmi' 'czaszka' 'czaszki'
             'czaszek' 'czaszkę' 'czaszkami',
  has   pluralname static;

! ------------------------------------------------------------------------------
!   SZYB GROBOWY (ćwiczenie 55)
! ------------------------------------------------------------------------------

Object  Burial_Shaft "Szyb grobowy"
  with  description
            "W twoich przyszłych notatkach terenowych zostanie to zapisane
             tak: ~Krypta o sklepieniu wspornikowym, zamknięta od góry ubitym
             ziemnym czopem, z malowanymi postaciami przedstawiającymi
             przypuszczalnie Dziewięciu Władców Nocy. Rozproszone kości
             należą najpewniej do jednego starszego mężczyzny i kilkorga dzieci
             złożonych w ofierze; wśród innych szczątków grobowych są łapy
             jaguara.~ (W notatkach terenowych nie wolno w żadnym razie
             zdradzić, kiedy było się śmiertelnie przerażonym.)",
        n_to Wormcast,
        u_to [;
            cage.floor_open = true;
            self.u_to = self.opened_u_to;
            move selfobj to self;
            print "Potężnym skokiem guźca uderzasz łbem w ziemny czop
                   zamykający komorę od góry i cały twój świat zapada się
                   w popiół i ziemię. Coś martwego i strasznie ciężkiego spada
                   prosto na ciebie: tracisz przytomność, a gdy ją odzyskujesz,
                   okazuje się, że stało się coś niemożliwego
                   i groteskowego...^";
            ChangePlayer(selfobj);
            give warthog ~light;
            <<Look>>;
            ],
        cant_go
            "Architekci tej komory nie byli zbyt hojni, jeśli chodzi
             o wyjścia. Wygląda jednak na to, że jakiś guziec wkopał się tu
             od północy.",
        before [; Jump: <<Go u_obj>>; ],
        opened_u_to [; PlayerTo(cage); rtrue; ],
  has   light;

