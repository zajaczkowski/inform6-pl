! DM4 ćwiczenie 46
Object  tiny_claws "chrobot/+u drobnych pazurków" thedark
  with  name 'pazurki' 'pazurków' 'pazurkami' 'drobne' 'drobnych'
             'dźwięk' 'dźwięku' 'odgłos' 'odgłosu' 'stworzenia' 'stworzeń'
             'stworzeniami' 'potwory' 'potworów' 'owady' 'owadów' 'owadami'
             'chrobotanie' 'chrobotania',
        initial
            "Gdzieś chrobocą drobne pazurki.",
        before [;
            Listen:
                "Jak na zwykłe owady brzmią zaskakująco inteligentnie.";
            Touch, Taste:
                "Lepiej nie. Naprawdę.";
            Smell:
                "Czujesz jedynie zapach własnego strachu.";
            Attack:
                "Bez trudu unikają twoich chaotycznych ciosów.";
            default:
                "Stworzenia wymykają ci się, cykając.";
            ],
        each_turn [; StartDaemon(self); ],
        daemon [;
            if (location ~= thedark) {
                self.turns_active = 0;
                StopDaemon(self);
                rtrue;
            }
            switch (++(self.turns_active)) {
                1:  "^Chrobot zbliża się odrobinę, a twój oddech staje się
                     głośny i chrapliwy.";
                2:  "^Pot przerażenia spływa ci z czoła. Stworzenia są już
                     prawie tutaj!";
                3:  "^Czujesz łaskotanie w kończynach i odruchowo kopiesz,
                     strząsając z siebie coś chitynowego. Sam ich odgłos to
                     złowieszczy zgrzyt.";
                4:  deadflag = true;
                    "^Nagle czujesz drobne ukłucie kła, ostrego jak igła
                     strzykawki, w łydce. Niemal natychmiast kończyny wpadają
                     w skurcz, barki i kolana sztywnieją, język puchnie...";
            }
            ],
        turns_active 0;

! ------------------------------------------------------------------------------
!   Procedury pomocnicze
! ------------------------------------------------------------------------------

! DM4 §4, zmieniona w §21 i §23
[ Initialise;
    TitlePage();
    location = Forest;
    move map to player;
    move sodium_lamp to player;
    move dictionary to player;
    StartDaemon(sodium_lamp);
    thedark.description =
        "Ciemność wieków napiera na ciebie ze wszystkich stron i zaczynasz
         czuć klaustrofobię.";
    "^^^Dni poszukiwań, dni przedzierania się przez cierniste zarośla
     lasu z wyschniętym gardłem, ale w końcu twoja cierpliwość została
     nagrodzona. Odkrycie!^";
];

! DM4 ćwiczenie 123 (zamiast opcodów maszyny Z: procedury biblioteki, żeby
! gra działała także w Glulx)
[ TitlePage i;
    ClearScreen(WIN_ALL); print "^^^^^^^^^^^^^";
    i = ScreenWidth(); if (i > 30) i = (i-30)/2;
    style bold; font off; spaces(i);
    print " RUINY^";
    style roman; print "^^"; spaces(i);
    print "[Naciśnij SPACJĘ, aby rozpocząć.]^";
    font on;
    box "Lecz Aligator nie kopał dna jamy,"
        "która miała być jego grobem,"
        "lecz kopał własną jamę,"
        "by mieć w niej schronienie."
        ""
        "-- z Popol Vuh";
    KeyCharPrimitive();
    ClearScreen(WIN_ALL);
];

! DM4 §22
[ PrintRank;
    print ", co czyni cię ";
    if (score == 30) "dyrektorem Instytutu Carnegie.";
    if (score >= 20) "archeologiem.";
    if (score >= 10) "poszukiwaczem osobliwości.";
    if (score >= 5) "odkrywcą.";
    "turystą.";
];

! DM4 §21
[ DeathMessage;
    if (deadflag == 3) Gracz("Zostałeś pojmany", "Zostałaś pojmana");
];

! Bezokolicznik czasownika fotografowania w pytaniach parsera ("Co chcesz
! sfotografować?"). Bez tego parser wypisałby słowo ze słownika, obcięte
! do 9 znaków: "Co chcesz sfotograf?".
[ PrintVerb v;
    if (v == 'sfotografuj' or 'fotografuj' or 'uwiecznij' or 'zrób') {
        print "sfotografować"; rtrue;
    }
    rfalse;
];

! ------------------------------------------------------------------------------

Include "PolskiG";

! DM4 §6
[ PhotographSub;
    if (camera notin player) "Nie bez aparatu.";
    if (noun == player) "Lepiej nie. Nie golisz się od wyjazdu z Meksyku.";
    if (children(player) > 1)
        "Fotografowanie to kłopotliwe zajęcie, wymagające obu rąk. Musisz
         odłożyć wszystko inne.";
    if (location == Forest) "W tym przesiąkniętym deszczem lesie lepiej nie.";
    if (location == thedark) "Jest o wiele za ciemno.";
    if (AfterRoutines()) return;
    print_ret "Rozstawiasz ogromny jak słoń, wielkoformatowy aparat na mokre
               płyty, ustawiasz lampę sodową i cierpliwie naświetlasz zdjęcie ",
               (dop) noun, ".";
];

Verb 'sfotografuj' 'fotografuj' 'uwiecznij'
    * noun                                      -> Photograph;

Verb 'zrób'
    * 'zdjęcie'/'fotografię' noun               -> Photograph;
