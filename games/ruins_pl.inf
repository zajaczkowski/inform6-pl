! ------------------------------------------------------------------------------
!   Obiekty przenoszone na miejsce w trakcie gry.
! ------------------------------------------------------------------------------

! DM4 §14, zmieniona w §23
Object  sodium_lamp "lamp/a sodow/a!"
  with  name 'ciężka' 'ciężkiej' 'ciężką' 'latarnia' 'latarni' 'latarnię'
             'latarnią',
        describe [;
            if (self has on)
                "^Lampa sodowa przycupnęła na ziemi i płonie.";
            "^Lampa sodowa ciężko przycupnęła na ziemi.";
            ],
        before [;
            Examine:
                print "To solidna lampa archeologiczna, ";
                if (self hasnt on) "obecnie wyłączona.";
                if (self.battery_power < 10) "świecąca słabym, żółtawym
                    blaskiem.";
                "płonąca jaskrawym żółtym światłem.";
            Burn:
                <<SwitchOn self>>;
            SwitchOn:
                if (self.battery_power <= 0)
                    "Niestety, bateria chyba się wyczerpała.";
                if (parent(self) hasnt supporter && self notin location)
                    "Zanim zapalisz lampę, trzeba ją pewnie postawić.";
            Take, Remove:
                if (self has on)
                    "Żarówka jest zbyt delikatna, a metalowy uchwyt zbyt
                     gorący, żeby podnosić lampę, gdy jest włączona.";
            PushDir:
                if (location == Shrine && second == sw_obj)
                    "Najdalej możesz dopchnąć lampę sodową do samej krawędzi
                     sanktuarium, tam gdzie dno jaskini się urywa.";
                AllowPushDir();
                rtrue;
            ],
        after [;
            SwitchOn:
                give self light;
            SwitchOff:
                give self ~light;
            ],
        daemon [;
            if (self hasnt on) return;
            if (--self.battery_power == 0) give self ~light ~on;
            if (self in location) {
                switch (self.battery_power) {
                    10: "^Lampa sodowa przygasa!";
                    5:  "^Lampa sodowa długo już nie wytrzyma.";
                    0:  "^Lampa sodowa blednie i nagle gaśnie.";
                }
            }
            ],
        battery_power 100,
  has   switchable female;

! DM4 §16
Object  dictionary "słownik/ dialektu Majów Waldecka"
  with  name 'przewodnik' 'przewodnika' 'przewodnikiem' 'przewodniku'
             'książka' 'książki' 'książkę' 'książką' 'księga' 'księgi'
             'księgę' 'księgą' 'majów' 'waldeck' 'waldecka',
        description
            "Opracowany na podstawie niewiarygodnych litografii legendarnego
             gawędziarza i podróżnika, ~hrabiego~ Jeana Fr@'ed@'erica
             Maximiliena Waldecka (1766??-1875), ten przewodnik zawiera to
             niewiele, co wiadomo o glifach starożytnego miejscowego
             dialektu.",
        before [ w1 w2 glyph;
            Consult:
                wn = consult_from;
                w1 = NextWord();    ! pierwsze słowo tematu
                w2 = NextWord();    ! drugie słowo tematu (jeśli jest)
                if (consult_words == 1 && (~~PL_Glif(w1))) glyph = w1;
                else if (consult_words == 2 && PL_Glif(w1)) glyph = w2;
                else if (consult_words == 2 && PL_Glif(w2)) glyph = w1;
                else "Spróbuj ~sprawdź <nazwa glifu> w słowniku~.";
                switch (glyph) {
                    'q1':
                        "(To jedyny glif, który znasz na pamięć!)^^
                         Q1: ~miejsce święte~.";
                    'półksiężyc', 'półksiężyca', 'półksiężycu':
                        "Półksiężyc: przypuszczalnie wymawiany ~xibalba~,
                         choć jego znaczenie nie jest znane.";
                    'strzała', 'strzały', 'strzałę', 'strzale':
                        "Strzała: ~podróż; stawanie się~.";
                    'czaszka', 'czaszki', 'czaszkę', 'czaszce':
                        "Czaszka: ~śmierć, zguba; los (niekoniecznie zły)~.";
                    'koło', 'koła', 'kole':
                        "Koło: ~Słońce; także życie, czas życia~.";
                    'jaguar', 'jaguara', 'jaguarze':
                        "Jaguar: ~władca~.";
                    'małpa', 'małpy', 'małpę', 'małpie':
                        "Małpa: ~kapłan?~.";
                    'ptak', 'ptaka', 'ptaku':
                        if (self.correct) "Ptak: ~martwy jak kamień~.";
                        "Ptak: ~bogaty, zamożny?~.";
                    default:
                        "Tego glifu jak dotąd nie odnotowano.";
                }
            ],
        correct false,
  has   proper;

[ PL_Glif w; return (w == 'glif' or 'glifu' or 'glifie' or 'glify' or 'glifów'); ];

