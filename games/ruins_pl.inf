!% -Cu
!% +language_name=polski
! ==============================================================================
!   RUINY - polska wersja przykładowej gry "Ruins" z podręcznika DM4.
!
!   Tłumaczenie z oryginału angielskiego (wersja Rogera Firtha z maja 2001,
!   złożona z fragmentów "Ruins" cytowanych w DM4).  Nazwy obiektów są
!   zapisane w notacji automatycznej odmiany (zob. lib/odmiana.h).
!
!                       GRACZ
!                             lampa, słownik, mapa
!                       WIELKI PLAC
!                           | grzyb, skrzynia, aparat, gazeta, schody
!                           |
!                       KWADRATOWA KOMNATA ---------------- ROBACZE CHODNIKI
!                           | inskrypcje, snop światła, (klucz)   kokon
!                           |
!                       NISKI KORYTARZ
!                           | figurka, drzwi
!                           |
!   GÓRNY KONIEC        SANKTUARIUM
!   KANIONU                /     \ malowidła, ołtarz, maska, (kapłan)
!       | kula     --------       --------
!       |        /                        \
!   XIBALBÁ                                PRZEDSIONEK
!       | stela                                | klatka, szkielety, (guziec)
!       |                                      |
!   DOLNY KONIEC KANIONU                     SZYB GROBOWY
!       | przepaść                               plaster miodu
!       |
!   PÓŁKA Z PUMEKSU
!         kość
! ==============================================================================

Include "PolskiZ";

Constant Story "RUINY";
Constant Headline "^Interaktywny przykład z podręcznika^
                    Copyright (c) 1999 by Angela M. Horns.^
                    Wersja polska.^";

Constant MAX_CARRIED = 7;       ! DM4 §22
Constant MAX_SCORE = 30;        ! DM4 §22

Include "Parser";
Include "VerbLib";

! ------------------------------------------------------------------------------
!   Klasa SKARB (DM4 §5, zmieniona w §23)
! ------------------------------------------------------------------------------

Class   Treasure
  with  before [;
            Take, Remove:
                if (self in packing_case)
                    "Rozpakowywanie tak bezcennego zabytku lepiej zostawić
                     ludziom z Instytutu Carnegie.";
                if (self.photographed_in_situ == false)
                    "Są lata trzydzieste, a nie dawne złe czasy. Zabranie
                     zabytku bez udokumentowania jego kontekstu to zwykły
                     rabunek.";
            Photograph:
                if (self has moved) "Co, i sfałszować dokumentację wykopalisk?";
                if (self.photographed_in_situ) "Nie po raz drugi.";
            ],
        after [;
            Insert:
                if (second == packing_case) {
                    score = score + self.cultural_value;
                    if (score == MAX_SCORE) {
                        deadflag = 2;
                        print_ret "Gdy ostrożnie pakujesz ", (bie) noun,
                                  ", z wierzchołków drzew sfruwa ara o
                                   czerwonym ogonie, z piórami ciężkimi od
                                   niedawnego deszczu. Łopot jej skrzydeł jest
                                   niemal ogłuszający, kamień uderza o
                                   kamień... Gdy niebo się przejaśnia, nad
                                   spokojną dżunglą wschodzi sierp księżyca.
                                   Jest koniec marca 1938 roku i czas wracać do
                                   domu.";
                    }
                    print "Bezpiecznie zapakowan"; KoncY(noun); ".";
                }
            Photograph:
                self.photographed_in_situ = true;
            ],
        cultural_value 5,
        photographed_in_situ false;

! ------------------------------------------------------------------------------
!   WIELKI PLAC - tu zaczyna się gra (DM4 §4, zmieniony w §8, §9 i §23)
! ------------------------------------------------------------------------------

Object  Forest "~Wielki Plac~"
  with  description
            "Tak przynajmniej nazywasz w notatkach tę niską wapienną skarpę,
             choć las deszczowy dawno już ją sobie odebrał. Ciemne,
             oliwkowe drzewa napierają ze wszystkich stron, powietrze paruje
             mgiełką po ciepłym, niedawnym deszczu, w górze wiszą chmary
             muszek. ~Budowla 10~ to bezładne rumowisko kamieni, które mogło
             kiedyś być piramidą grobową. Niewiele z niej ocalało poza
             wykutymi w kamieniu schodami, prowadzącymi w dół, w ciemność.",
        d_to steps,
        in_to steps,
        u_to
            "Drzewa są kolczaste. Próba wspinaczki skończyłaby się dłońmi
             pociętymi do krwi.",
        cant_go
            "Las deszczowy jest gęsty, a nie po to przedzierasz się przez
             niego od wielu dni, żeby teraz porzucić swoje odkrycie. Zanim
             będzie można usprawiedliwić koniec wyprawy, trzeba zabrać do
             cywilizacji kilka porządnych znalezisk.",
        before [; Listen: "Wyjce, nietoperze, papugi, ary."; ],
  has   light;

! DM4 §4, zmieniony w ćwiczeniu 1 i §23
Object  -> mushroom "cętkowan/y grzyb/"
  with  name 'grzybek' 'grzybka' 'grzybkowi' 'grzybkiem' 'grzybku'
             'muchomor' 'muchomora' 'muchomorowi' 'muchomorem' 'muchomorze',
        initial
            "Z rozmokłej ziemi wyrasta na długiej nóżce cętkowany grzyb.",
        description
            "Kapelusz grzyba pokrywają plamy i wcale nie masz pewności,
             czy to nie muchomor.",
        after [;
            Take:
                if (self.mushroom_picked)
                    "Podnosisz powoli rozpadający się grzyb.";
                self.mushroom_picked = true;
                "Zrywasz grzyb, zgrabnie przecinając jego cienką nóżkę.";
            Drop:
                "Grzyb spada na ziemię, lekko poobijany.";
            Eat:
                steps.rubble_filled = false;
                "Nadgryzasz brzeg kapelusza i nie potrafisz określić, skąd
                 bierze się ten cierpki smak, bo rozprasza cię ara
                 przelatująca nad głową - zdaje się wyłaniać prosto ze słońca.
                 Łopot jej skrzydeł jest niemal ogłuszający, kamień uderza
                 o kamień.";
            ],
        mushroom_picked false,
  has   edible;

! DM4 §12
Object  -> packing_case "skrzyni/a transportow/a!"
  with  name 'skrzynka' 'skrzynki' 'skrzynce' 'skrzynkę' 'skrzynką'
             'kufer' 'kufra' 'kufrowi' 'kufrem' 'kufrze'
             'pudło' 'pudła' 'pudłu' 'pudłem' 'pudle',
        initial
            "Stoi tu twoja skrzynia transportowa, gotowa pomieścić każde
             cenne znalezisko, które trzeba będzie odesłać do cywilizacji.",
        before [;
            Take, Remove, PushDir:
                "Skrzynia jest zbyt ciężka, żeby się z nią szarpać, dopóki
                 wyprawa nie jest zakończona.";
            ],
  has   static container open openable female;

! DM4 §6
Object  -> -> camera "aparat/+u na mokre płyty"
  with  name 'fotograficzny' 'fotograficznego' 'fotograficznemu'
             'fotograficznym' 'kamera' 'kamery' 'kamerę' 'kamerą' 'kamerze'
             'mokre' 'płyty',
        description
            "Nieporęczny, solidny i uparty aparat w drewnianej obudowie,
             na mokre płyty kolodionowe. Jak każdy archeolog, darzysz swój
             aparat miłością pomieszaną z nienawiścią.";

! DM4 §23
Object  -> -> newspaper "gazet/a sprzed miesiąca"
  with  name 'times' 'dziennik' 'dziennika' 'dziennikowi' 'dziennikiem'
             'dzienniku' 'stara' 'starą' 'starej',
        description
            "~The Times~ z 26 lutego 1938 roku. Po miesiącu w tym klimacie
             gazeta jest zarazem wilgotna i krucha - mniej więcej tak jak ty.
             Może w Londynie jest mgła. Może spadają bomby.",
  has   female;

! DM4 §4, zmienione w §5 i §23
Object  -> steps "kamienn/e schod/y"
  with  name 'stopnie' 'stopni' 'stopniom' 'stopniami' 'stopniach'
             'piramida' 'piramidy' 'piramidę' 'piramidzie' 'piramidą'
             'grobowa' 'grobowej' 'grobową' 'budowla' 'budowli' 'budowlę'
             'budowlą' 'dziesięć' '10',
        description [;
            if (self.rubble_filled)
                "Już po kilku stopniach drogę tarasuje gruz.";
            print "Popękane, wytarte stopnie schodzą do mrocznej komnaty.
                   Być może twoje stopy jako pierwsze od pięciuset lat ";
            if (Square_Chamber hasnt visited) print "będą je deptać";
            else print "je deptały";
            ". Na najwyższym stopniu wyryto glif Q1.";
            ],
        door_to [;
            if (self.rubble_filled)
                "Już po kilku stopniach drogę tarasuje gruz.";
            return Square_Chamber;
            ],
        door_dir d_to,
        rubble_filled true,
  has   scenery door open pluralname;

! ------------------------------------------------------------------------------
!   KWADRATOWA KOMNATA (DM4 ćwiczenie 2, zmieniona w §8 i §9)
! ------------------------------------------------------------------------------

Object  Square_Chamber "Kwadratowa Komnata"
  with  name 'nadproże' 'nadproża' 'nadprożami' 'przejście' 'przejścia'
             'przejściami',
        description
            "Zagłębiona w ziemi, posępna kamienna komnata, szeroka na
             dziesięć jardów. Od schodów u góry wpada snop słonecznego
             światła i wypełnia ją rozproszonym blaskiem, ale w cieniu niskie
             przejścia pod kamiennymi nadprożami prowadzą na wschód i na
             południe, w głębszy mrok Świątyni.",
        u_to Forest,
        e_to Wormcast,
        s_to Corridor,
        before [;
            Insert:
                if (noun == eggsac && second == sunlight) {
                    remove eggsac;
                    move stone_key to self;
                    "Upuszczasz kokon w jaskrawy snop słonecznego światła.
                     Kokon obscenicznie bulgocze, nabrzmiewa, po czym pęka,
                     wypuszczając setkę maleńkich owadów, które rozbiegają się
                     na wszystkie strony w ciemność. Na posadzce zostają tylko
                     bryzgi śluzu i dziwny klucz z żółtego kamienia.";
                }
            ],
  has   light;

! DM4 §8
Object  -> "wyryt/e inskrypcj/e+y"
  with  name 'rzeźby' 'rzeźb' 'rzeźbom' 'rzeźbami' 'rzeźbach'
             'znaki' 'znaków' 'znakom' 'znakami' 'znakach'
             'symbole' 'symboli' 'symbolami' 'napisy' 'napisów' 'napisami',
        initial
            "Wyryte inskrypcje pokrywają ściany, posadzkę i sufit.",
        description
            "Ilekroć przyglądasz się rzeźbom z bliska, wydają się nieruchome.
             Gdy jednak odwracasz wzrok, masz nieprzyjemne wrażenie, że
             przemykają i przebierają odnóżami. Wyróżniają się dwa glify:
             Strzała i Koło.",
  has   static pluralname female;

! DM4 §8
Object  -> sunlight "snop/ światła"
  with  name 'słońce' 'słońca' 'słońcem' 'promień' 'promienia' 'promieniem'
             'promienie' 'promieni' 'promieniach' 'słoneczny' 'słonecznego'
             'słonecznym' 'pyłki' 'pyłków' 'kurz' 'kurzu' 'powietrze',
        description
            "Pyłki kurzu migoczą w rozświetlonym powietrzu, tak że snop
             wydaje się niemal namacalny.",
        before [;
            Examine, Search:
                ;
            default:
                "To tylko nieuchwytny snop słonecznego światła.";
            ],
  has   scenery;

! ------------------------------------------------------------------------------
!   NISKI KORYTARZ (DM4 §13)
! ------------------------------------------------------------------------------

Object  Corridor "Niski Korytarz"
  with  description
            "Niski korytarz o kwadratowym przekroju biegnie z północy na
             południe i zmusza cię do pochylenia głowy.",
        n_to Square_Chamber,
        s_to StoneDoor;

! DM4 §5
Treasure -> statuette "pigmejsk/a figurk/a"
  with  name 'wąż' 'węża' 'wężem' 'majańska' 'majańskiej' 'majańską'
             'duch' 'ducha' 'duchem' 'cenna' 'cennej' 'cenną' 'statuetka'
             'statuetki' 'statuetkę' 'statuetką' 'statuetce',
        initial
            "Spoczywa tu cenna majańska figurka!",
        description
            "Groźna, niemal karykaturalna figurka pigmejskiego ducha z wężem
             owiniętym wokół szyi.",
  has   female;

! DM4 §13
Object  -> StoneDoor "kamienn/e drzwi/"
  with  name 'masywne' 'masywnych' 'masywnymi' 'wielkie' 'wielkich'
             'wielkimi' 'żółte' 'żółtych' 'żółtymi',
        description
            "To po prostu wielkie kamienne drzwi.",
        when_closed
            "Przejście zagradzają masywne drzwi z żółtego kamienia.",
        when_open
            "Wielkie drzwi z żółtego kamienia stoją otworem.",
        door_to [; if (self in Corridor) return Shrine; return Corridor; ],
        door_dir [; if (self in Shrine) return n_to; return s_to; ],
        with_key stone_key,
        found_in Corridor Shrine,
  has   static door openable lockable locked pluralname;

! ------------------------------------------------------------------------------
!   SANKTUARIUM (DM4 §23)
! ------------------------------------------------------------------------------

Object  Shrine "Sanktuarium"
  with  description
            "To wspaniałe sanktuarium wydrążono najwyraźniej w istniejących
             już wcześniej wapiennych jaskiniach. Najlepiej widać to w
             zachodnim z dwóch długich skalnych okapów po stronie południowej.",
        n_to StoneDoor,
        se_to Antechamber,
        sw_to
            "Okap zwęża się w szczelinę, która ciągnęłaby się dalej, gdyby
             nie była szczelnie zatkana soplami lodu. Lód nie całkiem zakrywa
             glif Półksiężyca.";

! DM4 §23
Object  -> paintings "malowidł/a+e"
  with  name 'malowidło' 'malowidła' 'malowidle' 'obraz' 'obrazy' 'obrazów'
             'władca' 'władcy' 'władcę' 'jeniec' 'jeńca' 'jeńcu',
        initial
            "Jaskrawe, roiące się od postaci malowidła, przedstawiające
             opancerzonego Władcę depczącego jeńca, są tak barwne, że aż
             trudno na nie patrzeć - graffiti zorganizowanej tłuszczy.",
        description
            "Ciała mają barwę krwistej czerwieni. Znaki Długiej Rachuby datują
             przedstawione wydarzenie na 10 baktun 4 katun 0 tun 0 uinal
             0 kin - na rocznicę tego rodzaju, w którą jakiś Władca mógł
             wreszcie ściąć pojmanego rywala, torturowanego rytualnie przez
             kilka lat, w zbałkanizowanym szaleństwie majańskich
             miast-państw.",
  has   static pluralname neuter;

! DM4 §12 i §15
Object  -> stone_table "kamienn/y ołtarz/"
  with  name 'stół' 'stołu' 'stołowi' 'stołem' 'stole'
             'płyta' 'płyty' 'płycie' 'płytę' 'płytą'
             'wielki' 'wielkiego' 'wielkim',
        initial
            "Sanktuarium dominuje wielka kamienna płyta - stół albo ołtarz.",
  has   enterable supporter static;

! DM4 §11
Treasure -> -> mask "mozaikow/a mask/a z jadeitu"
  with  name 'jadeitowa' 'jadeitowej' 'jadeitową' 'jadeit' 'jadeitu'
             'twarz' 'twarzy',
        initial
            "Na ołtarzu spoczywa mozaikowa maska z jadeitu.",
        description
            "Jak wspaniale wyglądałaby w Muzeum.",
        after [;
            Wear:
                move priest to Shrine;
                if (location == Shrine)
                    "Gdy patrzysz przez obsydianowe szczeliny oczu mozaikowej
                     maski, ukazuje ci się upiorna obecność: zmumifikowany
                     kapłan od kalendarza, oczekujący twojego słowa.";
            Disrobe:
                remove priest;
            ],
        cultural_value 10,
  has   clothing female;

! ------------------------------------------------------------------------------
!   GÓRNY KONIEC KANIONU (DM4 §23)
! ------------------------------------------------------------------------------

Object  Canyon_N "Górny koniec kanionu"
  with  description
            "Wyższy i szerszy, północny kraniec kanionu wznosi się tylko do
             nierównej ściany wulkanicznego krasu.",
        s_to Junction,
        d_to Junction,
  has   light;

! DM4 §15, zmieniona w ćwiczeniu 24 i §23
Object  -> huge_ball "ogromn/a kul/a z pumeksu"
  with  name 'pumeks' 'pumeksu' 'pumeksem' 'pumeksowa' 'pumeksowej'
             'pumeksową' 'kamień' 'kamienia' 'kamieniem' 'głaz' 'głazu'
             'głazem',
        initial
            "Leży tu ogromna kula z pumeksu, szeroka na osiem stóp.",
        description
            "Ma dobre osiem stóp średnicy, choć jest dość lekka.",
        before [;
            PushDir:
                if (location == Junction && second == ne_obj)
                    "Wejście do sanktuarium jest dużo węższe niż osiem stóp.";
                AllowPushDir();
                rtrue;
            Pull, Push, Turn:
                "Nie byłoby wcale tak trudno wprawić ją w ruch.";
            Take, Remove:
                "W kuli o średnicy ośmiu stóp jest naprawdę dużo kamienia.";
            ],
        after [;
            PushDir:
                if (second == n_obj) "Z wysiłkiem pchasz kulę pod górę.";
                if (second == u_obj) <<PushDir self n_obj>>;
                if (second == s_obj) "Raz rozpędzoną kulę trudno zatrzymać.";
                if (second == d_obj) <<PushDir self s_obj>>;
            ],
  has   static female;

! ------------------------------------------------------------------------------
!   XIBALBÁ (DM4 §23)
! ------------------------------------------------------------------------------

Object  Junction "Xibalb@'a"
  with  description
            "Pięćdziesiąt metrów pod lasem deszczowym, a szum wody słychać
             wszędzie: te głębokie, wypłukane wapienne jaskinie rozchodzą się
             jak korzenie. Wąskie przejście na północny wschód, obok szerokiej,
             zawalonej kolumny skalnej pokrytej lodem, prowadzi z powrotem do
             sanktuarium, a coś w rodzaju dna kanionu ciągnie się w górę na
             północ i w dół na południe, blade jak zęby rekina w rozproszonym
             świetle sodowej lampy, padającym z góry.",
        ne_to Shrine,
        n_to Canyon_N,
        u_to Canyon_N,
        s_to Canyon_S,
        d_to Canyon_S,
 has    light;

! DM4 §23
Treasure -> stela "stel/a"
  with  name 'kamień' 'kamienia' 'kamieniem' 'graniczny' 'granicznego'
             'granicznym' 'znacznik' 'znacznika' 'znacznikiem',
        initial
            "Na skalnej półce, na wysokości głowy, stoi niewielka stela,
             czyli kamień graniczny.",
        description
            "Ryciny zdają się ostrzegać, że granica Xibalb@'a, Miejsca Grozy,
             jest już blisko. Wyróżnia się glif Ptaka.",
  has   female;

! ------------------------------------------------------------------------------
!   DOLNY KONIEC KANIONU (DM4 §23)
! ------------------------------------------------------------------------------

Object  Canyon_S "Dolny koniec kanionu"
  with  description
            "Na niższym i węższym, południowym krańcu kanion urywa się nagle
             nad przepaścią, której czerń przyprawia o zawrót głowy. Z dołu
             nic nie widać ani nie słychać.",
        n_to Junction,
        u_to Junction,
        s_to "W przepaść?",
        d_to nothing,
  has   light;

! DM4 §12, zmieniona w §21 i §23
Object  -> chasm "przerażając/a przepa/ść=ści/"
  with  name 'czerń' 'czerni' 'otchłań' 'otchłani' 'dziura' 'dziury'
             'dziurę' 'dziurze' 'bezdenna' 'bezdennej' 'bezdenną',
        before [;
            Enter:
                deadflag = 3;
                "Spadasz w cichą pustkę ciemności i roztrzaskujesz czaszkę
                 o skalny występ. Pośród bólu i czerwieni niewyraźnie
                 dostrzegasz Boga w Sowim Pióropuszu...";
            JumpOver:
                "Jest o wiele za szeroka.";
            ],
        after [;
            Receive:
                remove noun;
                print (CMian) noun, " "; PL(noun, "spada", "spadają");
                " bezgłośnie w ciemność przepaści.";
            Search:
                "Przepaść jest głęboka i mroczna.";
            ],
        react_before [;
            Jump:
                <<Enter self>>;
            Go:
                if (noun == d_obj) <<Enter self>>;
            ],
        each_turn [;
            if (huge_ball in parent(self)) {
                remove huge_ball;
                Canyon_S.s_to = On_Ball;
                Canyon_S.description =
                    "Południowy koniec kanionu przechodzi teraz w kulę
                     z pumeksu, zaklinowaną w przepaści.";
                "^Kula z pumeksu toczy się bezwładnie przez ostatnie stopy
                 kanionu, po czym z drżeniem wpada w paszczę przepaści, odbija
                 się lekko i uderza cię w bok czoła. Osuwasz się do przodu,
                 krwawiąc, i... pumeks maleje, a może to twoja dłoń rośnie,
                 bo nagle trzymasz go w ręku i patrzysz na Aligatora, syna
                 Siedem-Ary, po drugiej stronie boiska do gry w piłkę na
                 Placu. Głowy jego ostatnich przeciwników tkwią nabite na
                 pale, tłum wyje, domagając się twojej krwi, i nie pozostaje
                 nic innego, jak mimo wszystko rzucić, i... ale to wszystko
                 bzdury, a ciebie potwornie boli głowa.";
            }
            ],
  has   scenery open container female;

! ------------------------------------------------------------------------------
!   PÓŁKA Z PUMEKSU (DM4 §23)
! ------------------------------------------------------------------------------

Object  On_Ball "Półka z pumeksu"
  with  description
            "Prowizoryczna półka, którą tworzy kula z pumeksu zaklinowana
             w przepaści. Mimo to kanion kończy się tutaj.",
        n_to Canyon_S,
        d_to Canyon_S,
        u_to Canyon_S,
  has   light;

! DM4 §23
Treasure -> "rytowan/a ko/ść=ści/"
  with  name 'rzeźbiona' 'rzeźbionej' 'rzeźbioną' 'kostka' 'kostki'
             'kostkę' 'kostką',
        initial
            "Ze wszystkich ofiar wrzuconych w przepaść być może nic nie da
             się odzyskać - nic poza rytowaną kością, lżejszą, niż się
             wydaje, która wystaje z kieszeni mokrego mułu w ścianie kanionu.",
        description
            "Z paszczy Itzamn@'a, wynalazcy pisma, przedstawionego pod
             postacią węża, wyłania się dłoń trzymająca pędzelek.",
  has   female;

