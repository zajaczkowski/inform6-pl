Treasure -> honeycomb "starożytn/y plast/e/r/ miodu"
  with  name 'stary' 'starego' 'staremu' 'starym' 'miód' 'miodu' 'miodem',
        initial
            "Spoczywa tu przepięknie zachowany, starożytny plaster miodu!",
        description
            "Być może to jakaś grobowa ofiara wotywna.",
        after [;
            Eat:
                "Chyba najdroższy posiłek w twoim życiu. Miód smakuje
                 dziwnie, być może dlatego, że przechowywano w nim wnętrzności
                 pochowanego tu Władcy, ale wciąż smakuje jak miód.";
            ],
  has   edible;

! ------------------------------------------------------------------------------
!   ROBACZE CHODNIKI (DM4 ćwiczenia 7 i 8, zmienione w ćwiczeniu 54)
! ------------------------------------------------------------------------------

Object  Wormcast "Robacze Chodniki"
  with  description
            "Niepokojące miejsce pełne zagłębień wyżłobionych na kształt
             pajęczej sieci - pasma pustej przestrzeni zawieszone w kamieniu.
             Jedyne nory dość szerokie, by się przez nie przeczołgać, biegną
             na północny wschód, na południe i w górę.",
        w_to Square_Chamber,
        s_to [;
            print "Chodnik robi się wokół ciebie śliski, jakby ciepło twojego
                   ciała topiło dawno stwardniałe żywice, a ty mocno zaciskasz
                   oczy, przekopując się przez ciemność.^";
            if (eggsac in player) return Square_Chamber;
            return random(Square_Chamber, Corridor, Forest);
            ],
        ne_to [; return self.s_to(); ],
        u_to [; return self.s_to(); ],
        cant_go [;
            if (player ~= warthog)
                "Choć nabierasz pewności, że coś kryje się za tymi chodnikami
                 i pośród nich, ta droga to w najlepszym razie zwierzęca
                 ścieżka: o wiele za wąska na brzuszek archeologa zza
                 biurka.";
            print "Chodnik robi się śliski wokół twojego ciała guźca,
                   mimowolnie kwiczysz, przekopując się przez ciemność, aż
                   wreszcie spadasz na południe, do...^";
            PlayerTo(Burial_Shaft);
            rtrue;
            ],
        after [;
            Drop:
                move noun to Square_Chamber;
                print (CMian) noun, " "; PL(noun, "wpada", "wpadają");
                print " do jednej z nor i szybko "; PL(noun, "znika", "znikają");
                " z oczu.";
            ],
  has   light;

! DM4 §23
Object  -> eggsac "lśniąc/y biał/y kokon/+u"
  with  name 'jaja' 'jaj' 'jajami' 'jajo' 'skrzek' 'skrzeku'
             'worek' 'worka' 'workiem' 'worku',
        initial
            "Lśniący biały kokon, przypominający grudę żabiego skrzeku
             wielkości piłki plażowej, przylgnął do czegoś w szczelinie jednej
             ze ścian.",
        after [; Take: "O rany."; ],
        react_before [;
            Go:
                if (location == Square_Chamber && noun == u_obj) {
                    deadflag = true;
                    "W chwili gdy pada na niego naturalne światło, kokon
                     obscenicznie bulgocze i nabrzmiewa. Zanim zdążysz go
                     odrzucić, pęka, wypuszczając setkę maleńkich owadów,
