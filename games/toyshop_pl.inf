            "Zachodni koniec sklepu jest niebieski, a na półkach stoją
             żołnierzyki i modele samolotów. Na południu znajduje się małe
             biuro.",
        e_to Toyshop, s_to Office;

! ------------------------------------------------------------------------------
! >BL  Klasa Block: klocki, które można układać jeden na drugim.
!
!   Bez procedury describe gra też poprawnie opisywałaby stosy klocków,
!   tylko trochę mniej zgrabnie.
! ------------------------------------------------------------------------------

Class   Block
  with  description "Zwykły dziecięcy klocek o boku czterech cali.",

        !   Procedura parse_name sprawia, że "weź klocki" działa poprawnie:

        parse_name [ i j;
            for (::) {
                j = NextWord();
                if (j == 'klocki' or 'klocków' or 'klockom' or 'klockami'
                    or 'klockach' or 'sześciany' or 'sześcianów') {
                    parser_action = ##PluralFound; i++;
                }
                else if (j == 'sześcian' or 'sześcianu' or 'sześcianem'
                         or 'kostka' or 'kostkę' or 'kostki' || Refers(self, wn-1))
                    i++;
                else return i;
            }
        ],

        describe [ c d e;
            d = child(self);
            while (d ~= 0 && d ofclass Block) { c++; e = d; d = child(d); }
            if (c == 0) rfalse;
            print "^Stoi tu stos klocków: ", (mian) e;
            e = parent(e);
            while (c > 0) { print " na ", (mie) e; c--; e = parent(e); }
            ".";
        ],
        before [ c;
          PutOn:
            if (second ofclass Block) {
                if (child(second) ~= 0 && child(second) ofclass Block)
                    "Na jednym klocku nie zmieszczą się obok siebie dwa
                     kolejne.";
            }
            else
                print "(Właściwie służą do układania jeden na drugim.)^";
            c = second; while (c ofclass Block) c = parent(c);
            if (c ~= location or mantelpiece) "Zbyt chwiejna podstawa.";
        ],
        after [ c stack;
          PutOn:
            stack = noun;
            while (parent(stack) ofclass Block) { stack = parent(stack); c++; }
            if (c < 2) {
                if (Chris has general) rtrue;
                rfalse;
            }
            if (c == 2) "Stos trzech klocków się chwieje, ale jakoś się trzyma.";
            if (Chris has general) {
                Achieved(3);
                "^Krzysztof wprawnie utrzymuje stos czterech klocków
                 w równowadze.";
            }
            stack = noun;
            while (parent(stack) ofclass Block) {
                c = stack; stack = parent(stack); move c to location;
            }
            "Stos czterech klocków chwieje się, chwieje, uspokaja... i nagle
             się rozsypuje!";
          Take:
            stack = child(noun); if (stack == 0) rfalse;
            while (stack ~= 0) {
                c = stack; stack = child(stack); move c to location;
            }
            "Przez to twój stos klocków się rozsypuje.";
        ],
  has   supporter;

Block   -> "zielon/y kloc/e/k/";
Block   -> "czerwon/y kloc/e/k/";
Block   -> "żółt/y kloc/e/k/";
Block   -> "niebiesk/i kloc/e/k/";

! ------------------------------------------------------------------------------
! >CH  Gościnny występ mojego kuzyna Krzysztofa, lat sześć (*), który bawi się
!      jedną rzeczą naraz (i łatwo zapomina którą).  Jest "transparent"
!      (to nie przytyk!), więc parser pozwala graczowi oglądać to, czym się
!      bawi... ale nie zabrać mu tego.
!      (* W 1993 roku, kiedy powstała ta gra.)
! ------------------------------------------------------------------------------

Object  -> Chris "Krzysztof/"
  with  name 'chłopiec' 'chłopca' 'chłopcu' 'chłopcem' 'chłopcze'
             'dziecko' 'dziecka' 'dziecku' 'dzieckiem' 'krzysztofie'
             'krzyś' 'krzysia' 'krzysiowi' 'krzysiem' 'krzysiu' 'chris',
        describe [;
            print "^Siedzi tu chłopiec imieniem Krzysztof";
            if (child(Chris) ~= nothing)
                print " i bawi się ", (nar) child(Chris);
            ".";
        ],
        life [ x;
            Ask:
                switch (second) {
                  'piłka', 'piłkę', 'piłce', 'piłeczka', 'piłeczkę',
                  'piłeczce', 'żonglowanie', 'żonglowaniu',
                  'fluorescencyjna', 'fluorescencyjną':
                      "~To moje!~";
                  'balon', 'balonik', 'baloniku', 'balonie', 'hel':
                      "Krzysztof ziewa.";
                  'klocek', 'klocki', 'klockach', 'klocku', 'wieżę', 'wieży':
                      "~Założę się, że zbuduję wyższą wieżę niż ty.~";
                  'zabawki', 'zabawkach', 'sklep', 'sklepie':
                      "~Fajnie tu, prawda?~";
                  default: "~Nie wiem.~";
                }
            Answer:
                switch (noun) {
                  'cześć', 'hej', 'witaj', 'siema', 'dzień', 'hejka':
                      "~Cześć~ - odpowiada wesoło Krzysztof.";
                  default: "Krzysztof wydaje się zajęty czymś innym.";
                }
            Attack:
                remove self;
                "Krzysztof rzuca się do ucieczki i bez trudu przemyka obok
                 ciebie!";
            Kiss: "~Fuj, ale ckliwe.~";
            Give:
                if (noun == balloon) "Balonik zupełnie go nie interesuje.";
                x = child(Chris);
                if (x ~= 0) {
                    move x to location;
                    print "Zapomina o ", (mie) x, " i skwapliwie chwyta ";
                }
                else print "Skwapliwie chwyta ";
                print (bie) noun; move noun to Chris; ".";
        ],
        orders [;
            Drop: if (noun in Chris) "~Nie! To moje!~";
            Take: "Krzysztofowi się nie chce.";
            Give: if (second == player) "~Weź sobie własne!~";
            Go: "~Ale mi się tu podoba!~";
            PutOn: if (noun notin Chris) "Krzysztof zupełnie nie wie, o co chodzi.";
                   if (~~(noun ofclass Block && second ofclass Block))
                       "Krzysztof nie widzi w tym sensu.";
                   print "Krzysztof pochyla się w wielkim skupieniu i robi,
                          o co prosisz.^";
                   move noun to player; give self general;
                   <PutOn noun second>;
                   give self ~general; rtrue;
        ],
        each_turn [;
            if (random(3) ~= 1) rtrue;
            print "^Krzysztof ";
            switch (random(4)) {
              1: "ziewa.";      2: "marszczy brwi.";
              3: "przeciąga się."; 4: "nuci coś bez melodii.";
            }
        ],
  has   animate proper transparent male;

Object  "fluorescencyjn/a piłeczk/a do żonglowania" Chris
  with  initial "Na podłodze leży fluorescencyjna piłeczka do żonglowania!",
        name 'piłka' 'piłki' 'piłkę' 'piłką' 'piłce',
        description "Świeci łagodnym światłem."
  has   light female;

! ------------------------------------------------------------------------------
! >OF  Prosta reguła ruchu.
! ------------------------------------------------------------------------------

Toyroom Office "Biuro"
  with  description
            "Małe, szare biuro z szeroką kamienną półką nad kominkiem. We
             wschodniej ścianie są drzwi z napisem ~Wyjście~, a sklep
             z zabawkami leży oczywiście na północy.",
        cant_go "Sala sklepu leży na północy.",
        n_to West_End,
        e_to [;
            if (score ~= MAX_SCORE)
                "Rozlega się gong. ~Nie możesz opuścić sklepu z zabawkami,
                 dopóki nie zrobisz sześciu ciekawych rzeczy!~";
            deadflag = 2;
            "Rozlega się gong. ~Gratulacje! Możesz już opuścić sklep
             z zabawkami i zacząć pisać własną grę w Informie!~";
        ];

! ------------------------------------------------------------------------------
! >TB  Dość zachłanny pojemnik... ale da się go nauczyć manier.
! ------------------------------------------------------------------------------

Object  -> "zębat/a torb/a"
  with  name 'worek' 'worka' 'workiem' 'worku',
        initial "W kącie leży dziwna, zębata torba.",
        description "Pojemna torba z otworem pełnym zębów.",
        before [;
            LetGo: "Torba zatrzaskuje się wyzywająco na twojej dłoni, dopóki
                    nie dasz za wygraną.";
        ],
        after [;
            Receive:
                if (noun == cone) {
                    self.before = 0; self.after = 0;
                    "Torba bez końca wije się, usiłując połknąć ogromną masę
                     marcepanu. To ją czegoś nauczy.";
                }
                "Torba wije się ohydnie, połykając ", (bie) noun, ".";
        ],
  has   container open female;

! ------------------------------------------------------------------------------
! >SL  Poziomicę można położyć na półce nad kominkiem: za pierwszym razem gra
!      losuje, który koniec jest wyżej, i trzyma się tej decyzji.
! ------------------------------------------------------------------------------

Object  -> -> spirit_level "poziomic/a"
  with  name 'drewno' 'drewna' 'fiolka' 'fiolkę' 'fiolki' 'libella' 'libellę',
        number 0,
        description "Drewniana listwa z fiolką gęstego zielonego płynu,
                     w którym uwięziony jest pęcherzyk powietrza.",
        before [;
            Examine:
                if (spirit_level in mantelpiece) {
                    print "Pęcherzyk jest przy ";
                    if (self.number == 1) "północno-wschodnim końcu.";
                    "południowo-zachodnim końcu.";
                }
        ],
        after [;
            PutOn: if (second ~= mantelpiece) rfalse;
                if (spirit_level hasnt general) self.number = random(2);
                give spirit_level general; Achieved(4);
                print "Kładziesz poziomicę na półce nad kominkiem, a pęcherzyk
                       powoli przesuwa się na ";
                if (self.number == 1) "północny wschód.";
                "południowy zachód.";
        ],
  has   female;

Object  -> mantelpiece "półk/a nad kominkiem"
  with  name 'gzyms' 'gzymsu' 'gzymsie' 'kominek' 'kominka' 'kominku',
  has   scenery supporter female;

Object  -> -> key "żelazn/y klucz/";

! ------------------------------------------------------------------------------
! >BB  Tablica, na której można pisać i którą można wycierać.
! ------------------------------------------------------------------------------

Object  -> -> chalk "kawał/e/k/ kredy"
  with  name 'kreda' 'kredę' 'kredą';

Array boardtext string 64;

Object  -> blackboard "tablic/a"
  with  name 'czarna' 'czarną' 'czarnej',
        describe [; <<Examine self>>; ],
        before [ i f;
            Examine:
                for (i=1 : i<=boardtext->0 : i++)
                    if (boardtext->i ~= ' ' or 0) f = 1;
                if (f == 0) {
                    print "^Tablica w biurze jest czysto wytarta.^";
                    if (self hasnt general) {
                        give self general;
                        "^[Żeby coś na niej napisać, spróbuj   > napisz ~tekst...~]";
                    }
                    rtrue;
                }
                print "^Na tablicy w biurze widnieje napis:^    ";
                for (i=1 : i<=boardtext->0 : i++) {
                    f = boardtext->i;
                    if (f ~= 0) print (char) f;
                }
                new_line; rtrue;
            Rub:
                for (i=1 : i<=boardtext->0 : i++) boardtext->i = ' ';
                "Wycierasz tablicę do czysta.";
        ],
  has   static female;

Global from_char; Global to_char;

[ QuotedText i j f last;
    i = WordAddress(wn++); i = i-buffer;
    #Ifdef TARGET_ZCODE;
    last = buffer->1 + 1;
    #Ifnot; ! TARGET_GLULX
    last = buffer-->0 + WORDSIZE - 1;
    #Endif; ! TARGET_
    if (buffer->i == '"') {
        for (j=i+1 : j<=last : j++)
            if (buffer->j == '"') f = j;
        if (f == 0) return -1;
        from_char = i+1; to_char = f-1;
        if (from_char > to_char) return -1;
        while (buffer+f > WordAddress(wn)) wn++; wn++;
        return 1;
    }
    return -1;
];

[ WriteSub i j;
    if (chalk notin player) "Nie masz czym pisać.";
    if (blackboard notin location) "Tablica jest gdzie indziej.";
    for (i=from_char,j=1 : i<=to_char && j<boardtext->0 : i++,j++)
        boardtext->j = buffer->i;
    for (: j<boardtext->0 : j++) boardtext->j = 0;
    Achieved(5);
    <<Examine blackboard>>;
];

! ------------------------------------------------------------------------------
!   Koniec definicji obiektów.  Procedury i punkty wejścia.
! ------------------------------------------------------------------------------

[ Initialise;
    location = chair; move satchel to player;

    print "^^^^~Co jest takiego wyjątkowego w tym Informie?~ - tyle
           pamiętasz z rozmowy z szalonym alchemikiem. Wielki błąd...^^";

    StartDaemon(balloon);
];

! Nazwy zadań (biblioteka numeruje je od 0 do NUMBER_TASKS-1).

[ PrintTaskName achievement;
    switch (achievement) {
      0: "zjedzenie landrynki";
      1: "przejażdżka samochodzikiem";
      2: "zatrzymanie przeciągu";
      3: "zbudowanie wieży z czterech klocków";
      4: "sprawdzenie, w którą stronę przechyla się półka";
      5: "napisanie czegoś na tablicy";
    }
];

[ PrintRank;
    print ", co czyni cię ";
    if (score >= 6) "kierownikiem sklepu z zabawkami.";
    if (score >= 5) "stażystą w kierownictwie.";
    if (score >= 4) "studentem.";
    if (score >= 3) "uczniem.";
    if (score >= 2) "przedszkolakiem.";
    if (score >= 1) "brzdącem.";
    "noworodkiem.";
];

! Zastępcza procedura BurnSub, dostosowana do zasad sklepu z zabawkami:

[ BurnSub;
    if (match hasnt light) "Nie masz czym tego podpalić.";
    if (noun has animate) <<Attack noun>>;
    if (noun == padded_floor) {
        deadflag = 1;
        "Rozlega się gong, ale zanim grobowy głos skończy odchrząkiwać, cała
         wyściełana podłoga staje w płomieniach.";
    }
    "Rozlega się gong i grobowy, nieco rozczarowany głos oznajmia:
     ~W sklepie z zabawkami nie wolno bawić się ogniem.~";
];

! Nowa akcja Burst (przebij), która po prostu przechodzi w Attack, oraz
! pisanie na tablicy:

[ BurstSub; <<Attack noun>>; ];

! Bezokoliczniki nowych czasowników w pytaniach parsera ("Co chcesz przebić?").
[ PrintVerb v;
    switch (v) {
      'przebij':     print "przebić";
      'przekłuj':    print "przekłuć";
      'nakłuj':      print "nakłuć";
      'dźgnij':      print "dźgnąć";
      'przedziuraw': print "przedziurawić";
      default:       rfalse;
    }
    rtrue;
];

Include "PolskiG";

Verb 'przebij' 'przekłuj' 'nakłuj' 'dźgnij' 'przedziuraw'
    * noun                                      -> Burst;

Verb 'napisz' 'pisz' 'wypisz'
    * QuotedText                                -> Write
    * QuotedText 'na' noun                      -> Write;
