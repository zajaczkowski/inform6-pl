Object  -> "szklan/e pudełk/o z pokrywką"
  with  name 'pokrywka' 'pokrywki' 'pokrywkę',
  has   container transparent openable open neuter;

Object  -> "stalow/e pudełk/o z pokrywką"
  with  name 'pokrywka' 'pokrywki' 'pokrywkę',
  has   container openable open neuter;


Toyroom West_End "Zachodni koniec"
  with  name 'żołnierzyki' 'żołnierzyków' 'modele' 'modeli' 'samoloty'
             'samolotów' 'samoloci' 'samolociki' 'samolocików',
