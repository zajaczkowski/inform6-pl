Aboveground Outside_Grate "Przed kratą"
  with  name 'przed' 'kratą',
        description
            "Jesteś w zagłębieniu głębokim na dwadzieścia stóp, o dnie z gołej
             ziemi. W ziemi osadzono mocną stalową kratę zatopioną w betonie.
             Do zagłębienia prowadzi suche koryto strumienia.",
        e_to In_Forest_1,
        w_to In_Forest_1,
        s_to In_Forest_1,
        n_to At_Slit_In_Streambed,
        d_to [;
            if (Grate hasnt locked && Grate hasnt open) {
                print "(najpierw otwierasz kratę)^";
                give Grate open;
            }
            return Grate;
        ];

Scenic  -> "zagłębieni/e"
  with  name 'ziemia' 'ziemi' 'ziemię' 'dwudziestostopowe' 'dół' 'dołu'
             'dole' 'niecka' 'niecce' 'niecki',
        description "Właśnie w nim stoisz.",
  has   neuter;

Object  -> Grate "stalow/a krat/a"
  with  name 'zamek' 'zamka' 'brama' 'bramy' 'bramę' 'krata' 'kratka' 'kratkę'
             'kratownica' 'kratownicę' 'metalowa' 'metalową' 'metalowej'
             'mocna' 'mocną' 'mocnej',
        description "Wygląda jak zwykła krata zatopiona w betonie.",
        with_key set_of_keys,
        door_dir [;
            if (location == Below_The_Grate) return u_to;
            return d_to;
        ],
        door_to [;
            if (location == Below_The_Grate) return Outside_Grate;
            return Below_The_Grate;
        ],
        describe [;
            if (self has open) "^Krata stoi otworem.";
            if (self hasnt locked) "^Krata jest odblokowana, ale zamknięta.";
            rtrue;
        ],
        found_in Below_The_Grate Outside_Grate,
  has   static door openable lockable locked female;

