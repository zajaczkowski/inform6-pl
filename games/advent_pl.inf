Room    At_Window_On_Pit_2 "Przy oknie nad jamą"
  with  name 'okno' 'oknie' 'jamą',
        description
            "Stoisz przy niskim oknie, które wychodzi na ogromną jamę ginącą
             w górze poza zasięgiem wzroku. Ponad pięćdziesiąt stóp niżej
             niewyraźnie widać dno. Dno jamy pokrywają smużki białej mgły,
             gęstniejące w lewo. Ślady w kurzu wokół okna wskazują, że ktoś
             niedawno tu był. Dokładnie naprzeciwko, po drugiej stronie jamy,
             dwadzieścia pięć stóp dalej, jest podobne okno wychodzące na
             oświetloną komnatę. Widać w nim mroczną postać, która ci się
             przygląda.",
        w_to At_Junction_Of_Three,
        cant_go "Jedyne przejście prowadzi z powrotem na zachód, do
                 rozwidlenia.",
        before [;
          Jump:
            deadflag = 1;
            "Skaczesz i skręcasz kark!";
          WaveHands:
            "Mroczna postać macha ci w odpowiedzi!";
        ];

! ------------------------------------------------------------------------------

Room    At_Reservoir "Nad zbiornikiem"
  with  name 'zbiornik' 'zbiorniku',
        description
            "Jesteś na brzegu dużego podziemnego zbiornika. Komnatę wypełnia
             nieprzejrzysta chmura białej mgły, która szybko unosi się w górę.
             Jezioro zasila strumień, który wypada z dziury w ścianie jakieś
             dziesięć stóp nad tobą i z pluskiem wpada gdzieś do wody we
             mgle. Jedyny korytarz prowadzi z powrotem na południe.",
        s_to In_Mirror_Canyon,
        out_to In_Mirror_Canyon,
        before [;
          Swim:
            "Woda jest lodowata; w takiej wodzie szybko zamarza się na
             śmierć.";
        ];

! ------------------------------------------------------------------------------
!   Przepaść i most trolla
! ------------------------------------------------------------------------------

Room    In_Sloping_Corridor "Opadający korytarz"
  with  name 'opadający' 'korytarz' 'korytarzu',
        description
            "Jesteś w długim, krętym korytarzu, który w obu kierunkach opada
             poza zasięg wzroku.",
        d_to In_Large_Low_Room,
        u_to On_Sw_Side_Of_Chasm,
        cant_go "Korytarz stromo wznosi się i opada.";

Room    On_Sw_Side_Of_Chasm "Południowo-zachodnia strona przepaści"
  with  name 'strona' 'stronie' 'przepaści',
        description
            "Jesteś po jednej stronie wielkiej, głębokiej przepaści. Gęsta
             biała mgła unosząca się z dołu zasłania widok na drugi brzeg.
             Ścieżka na południowy zachód odchodzi od przepaści w kręty
             korytarz.",
        ne_to CrossRicketyBridge,
        sw_to In_Sloping_Corridor,
        d_to In_Sloping_Corridor,
        cant_go "Ścieżka wije się na południowy zachód.",
        before [;
          Jump:
            if (RicketyBridge in self)
                "Z szacunkiem sugeruję, żeby przejść przez most, zamiast
                 skakać.";
            deadflag = 1;
            "Nie udało się.";
        ];

[ CrossRicketyBridge;
    if (Troll.has_caught_treasure || Troll in nothing) {
        Troll.has_caught_treasure = false;
        if (Bear.is_following_you) {
            remove Bear;
            remove self;
            give Wreckage ~absent;
            remove RicketyBridge;
            give RicketyBridge absent;
            StopDaemon(Bear);
            deadflag = 1;
            "Gdy docierasz na drugą stronę, most ugina się pod ciężarem
             niedźwiedzia, który wciąż za tobą chodził. Rozpaczliwie szukasz
             oparcia, ale most się zawala, a ty tracisz równowagę i spadasz
             w przepaść.";
        }
        return RicketyBridge;
    }
    if (Troll in location) "Troll nie pozwala ci przejść.";
    move Troll to location;
    "Spod mostu wychodzi troll i zagradza ci drogę.";
];

Object  -> RicketyBridge "chybotliw/y most/+u"
  with  name 'mostek' 'mostku' 'niestabilny' 'niestabilnego' 'rozklekotany'
             'rozklekotanego' 'linowy' 'linowego' 'lina' 'liny',
        description "Wygląda jak zwykły, choć niestabilny most.",
        describe [;
            print
                "Nad przepaścią rozpięty jest chybotliwy drewniany most, który
                 znika we mgle.
                 ^^
                 Na moście wisi tabliczka: ~Stój! Zapłać trollowi!~^";
            if (Troll notin location)
                "Trolla nigdzie nie widać.";
            rtrue;
        ],
        door_dir [;
            if (location == On_Sw_Side_Of_Chasm) return ne_to;
            return sw_to;
        ],
        door_to [;
            if (location == On_Sw_Side_Of_Chasm) return On_Ne_Side_Of_Chasm;
            return On_Sw_Side_Of_Chasm;
        ],
        found_in On_Sw_Side_Of_Chasm On_Ne_Side_Of_Chasm,
  has   static door open;

Object  -> -> Troll "krzepk/i troll/"
  with  name 'trolla' 'trollem' 'trollu' 'trollowi',
        description
            "Trolle są bliskimi krewnymi skał i mają skórę grubą jak nosorożec.",
        initial
            "Przy moście stoi krzepki troll i żąda skarbu w zamian za
             przejście.",
        life [;
          Attack:
            "Troll śmieje się na głos z twojej żałosnej próby zrobienia mu
             krzywdy.";
          ThrowAt, Give:
            if (noun ofclass Treasure) {
                remove noun;
                move self to RicketyBridge;
                self.has_caught_treasure = true;
                score = score - 5;
                "Troll łapie twój skarb i umyka gdzieś poza zasięg wzroku.";
            }
            if (noun == tasty_food)
                "Obżarstwo nie należy do wad trolla. Chciwość - owszem.";
            "Troll zręcznie łapie ", (bie) noun, ", ogląda uważnie i odrzuca
             ci z powrotem, oznajmiając: ~Dobra robota, ale za mało cenne.~";
          Order:
            "Chyba śnisz.";
          Answer, Ask:
            "Trolle to kiepscy rozmówcy.";
        ],
        has_caught_treasure false,
  has   animate male;

Object  Wreckage "szczątk/i mostu"
  with  name 'szczątek' 'wrak' 'wraku' 'most' 'mostu' 'martwy' 'martwego'
             'niedźwiedź' 'niedźwiedzia',
        initial
            "Na dnie przepaści widać szczątki mostu trolla (i martwego
             niedźwiedzia).",
        before [;
            "Szczątki są za głęboko w dole.";
        ],
        found_in On_Sw_Side_Of_Chasm On_Ne_Side_Of_Chasm,
  has   static absent pluralname;

