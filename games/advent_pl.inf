Room    At_Top_Of_Small_Pit "Nad małą jamą"
  with  name 'nad' 'małą' 'jamą',
        description
            "U twoich stóp jest mała jama, z której unoszą się smużki białej
             mgły. Korytarz z zachodu kończy się tutaj, jeśli nie liczyć
             wąskiej szpary prowadzącej dalej.
             ^^
             W dół jamy prowadzą nierówne kamienne stopnie.",
        e_to In_Bird_Chamber,
        w_to "Szpara jest o wiele za wąska, żeby się przez nią przecisnąć.",
        d_to [;
            if (large_gold_nugget in player) {
                deadflag = 1;
                "Leżysz na dnie jamy ze skręconym karkiem.";
            }
            return In_Hall_Of_Mists;
        ],
        before [;
          Enter:
            if (noun == PitCrack)
                "Szpara jest o wiele za wąska, żeby się przez nią przecisnąć.";
        ],
  has   nodwarf;

