Room    At_Witts_End "Koniec Witta"
  with  name 'koniec' 'końcu' 'witta',
        description
            "Jesteś na Końcu Witta. Korytarze prowadzą we *wszystkich*
             kierunkach.",
        w_to
            "Przeczołgujesz się przez jakieś małe dziury i natrafiasz na
             świeże zawalisko. Jesteś z powrotem w głównym korytarzu.",
        before [;
          Go:
            if (noun ~= w_obj && random(100) <= 95)
                "Przeczołgujesz się przez jakieś małe dziury i lądujesz
                 z powrotem w głównym korytarzu.";
            PlayerTo(In_Anteroom);
            rtrue;
