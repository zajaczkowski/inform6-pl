            "Wchodzisz na wzgórze, wciąż w lesie. Po drugiej stronie wzgórza
             droga znów opada. W oddali widać jakiś budynek.",
        e_to At_End_Of_Road,
        n_to At_End_Of_Road,
        d_to At_End_Of_Road,
        s_to In_Forest_1;

Scenic  -> "wzgórz/e"
  with  name 'pagórek' 'pagórka' 'pagórku' 'wzniesienie' 'wzniesienia'
             'wzniesieniu',
        description "Zwyczajne wzgórze.",
