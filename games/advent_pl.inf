Aboveground Inside_Building "W budynku"
  with  name 'budynek' 'budynku' 'domek' 'domku' 'studnia' 'studni',
        description
            "Jesteś w budynku - w domku zbudowanym nad dużym źródłem.",
        cant_go
            "Strumień wypływa przez dwie rury kanalizacyjne o średnicy
             jednej stopy. Jedyne wyjście prowadzi na zachód.",
        before [;
          Enter:
            if (noun == Spring or SewerPipes)
                "Strumień wypływa przez dwie rury kanalizacyjne o średnicy
                 jednej stopy. Lepiej skorzystać z wyjścia.";
          Xyzzy:
            if (In_Debris_Room hasnt visited) rfalse;
            PlayerTo(In_Debris_Room);
            rtrue;
          Plugh:
            if (At_Y2 hasnt visited) rfalse;
            PlayerTo(At_Y2);
            rtrue;
        ],
        w_to At_End_Of_Road,
        out_to At_End_Of_Road,
        in_to "Rury są za małe.";

Scenic  -> Spring "źródł/o"
  with  name 'duże' 'dużego' 'dużym' 'zdrój' 'zdroju',
        description
            "Strumień wypływa przez dwie rury kanalizacyjne o średnicy
             jednej stopy.",
  has   neuter;

Scenic  -> SewerPipes "par/a rur kanalizacyjnych"
  with  name 'rury' 'rur' 'rurami' 'rurach' 'rura' 'rurę' 'rurze'
             'kanalizacyjna' 'kanalizacyjne' 'ściek' 'ścieku',
        description "Za małe. Jedyne wyjście prowadzi na zachód.",
