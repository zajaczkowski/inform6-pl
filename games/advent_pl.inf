             wyraźnie się rozszerza. Na wschód prowadzi niezwykle ciasny
             tunel. Wygląda na to, że trzeba się będzie przez niego
             przeciskać. Na drugim końcu widać niesamowite światło.",
        nw_to In_Misty_Cavern,
        e_to [ j;
            j = children(player);
            if (j == 0 || (j == 1 && egg_sized_emerald in player))
                return In_Plover_Room;
            "Coś, co niesiesz, nie zmieści się z tobą w tunelu. Lepiej
             sprawdź ekwipunek i coś odłóż.";
        ];

! ------------------------------------------------------------------------------

Room    In_Plover_Room "Komnata Siewki"
  with  name 'komnata' 'komnacie' 'siewki',
        description
            "Jesteś w niewielkiej komorze oświetlonej niesamowitym zielonym
             światłem. Na zachód prowadzi niezwykle wąski tunel, a na północny
             wschód ciemny korytarz.",
        ne_to In_Dark_Room,
        w_to [ j;
            j = children(player);
            if (j == 0 || (j == 1 && egg_sized_emerald in player))
                return In_Alcove;
            "Coś, co niesiesz, nie zmieści się z tobą w tunelu. Lepiej
             sprawdź ekwipunek i coś odłóż.";
        ],
        before [;
          Plover:
            if (egg_sized_emerald in player) {
                move egg_sized_emerald to In_Plover_Room;
                score = score - 5;
            }
            PlayerTo(At_Y2);
            rtrue;
          Go:
            if (noun == out_obj)
                <<Go w_obj>>;
        ],
  has   light;

