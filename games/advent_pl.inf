Room    In_Mirror_Canyon "Kanion Lustra"
  with  name 'kanion' 'kanionie' 'lustra',
        description
            "Jesteś w kanionie biegnącym z północy na południe, szerokim na
             jakieś dwadzieścia pięć stóp. Dno pokrywa biała mgła napływająca
             z północy. Ściany wznoszą się na grubo ponad sto stóp. Z jakiegoś
             niewidocznego punktu wysoko nad tobą zwisa ogromne dwustronne
             lustro, dokładnie pośrodku między ścianami kanionu i równolegle
             do nich.
             ^^
             W obu ścianach, jakieś pięćdziesiąt stóp nad tobą, widać małe
             okienko.",
        s_to In_Secret_N_S_Canyon_0,
        n_to At_Reservoir;

Object  -> "zawieszon/e lustr/o"
  with  name 'zwierciadło' 'zwierciadła' 'masywne' 'ogromne' 'ogromnego'
             'wiszące' 'wiszącego' 'dwustronne' 'dwustronnego' 'krasnoludów',
        description
            "Lustro najwyraźniej służy krasnoludom, które - jak wiadomo - są
             niezwykle próżne.",
        initial
            "Lustro najwyraźniej służy krasnoludom, które - jak wiadomo - są
             niezwykle próżne.",
        before [;
          Attack, Remove:
            "Nie dosięgniesz go stąd.";
        ],
  has   static neuter;

