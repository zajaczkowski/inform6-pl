Room    In_Immense_N_S_Passage "Ogromny korytarz północ-południe"
  with  name 'ogromny' 'korytarz' 'korytarzu',
        description "Jesteś na jednym końcu ogromnego korytarza biegnącego
                     z północy na południe.",
        s_to In_Giant_Room,
        n_to [;
            if (RustyDoor has locked) <<Open RustyDoor>>;
            if (RustyDoor hasnt open) {
                give RustyDoor open;
                print "(najpierw z wysiłkiem otwierasz drzwi)^";
            }
            return RustyDoor;
        ];

Object  -> RustyDoor "zardzewiał/e drzwi/"
  with  name 'zawias' 'zawiasy' 'zawiasów' 'zawiasach' 'masywne' 'masywnych'
             'żelazne' 'żelaznych' 'żelaznymi',
        description "To po prostu wielkie żelazne drzwi.",
        when_closed "Drogę na północ zagradzają masywne, zardzewiałe,
                     żelazne drzwi.",
        when_open "Droga na północ prowadzi przez masywne, zardzewiałe,
                   żelazne drzwi.",
        door_to In_Cavern_With_Waterfall,
        door_dir n_to,
        before [;
          Open:
            if (self has locked)
                "Zawiasy są dokumentnie zardzewiałe i ani drgną.";
          Close:
            if (self has open)
                "Po takim wysiłku przy otwieraniu tych drzwi nie radziłbym
                 ich znowu zamykać.";
            "Nie ma problemu - już są zamknięte.";
          Oil:
            if (bottle in player && oil_in_the_bottle in bottle) {
                remove oil_in_the_bottle;
                give self ~locked openable;
                "Olej uwolnił zawiasy i drzwi dadzą się teraz otworzyć,
                 choć wymaga to trochę wysiłku.";
            }
            else
                "Nie masz ich czym naoliwić.";
          Water:
            if (bottle in player && water_in_the_bottle in bottle) {
                remove water_in_the_bottle;
                give self locked ~open;
                "Zawiasy są dokumentnie zardzewiałe i ani drgną.";
            }
            else
                "Nie masz ich czym polać.";
        ],
        after [;
          Open:
            "Drzwi otwierają się ze zgrzytem, sypiąc rdzą.";
        ],
  has   static door locked pluralname;

