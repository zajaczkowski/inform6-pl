Room    At_Fork_In_Path "Rozwidlenie ścieżki"
  with  name 'rozwidlenie' 'rozwidleniu' 'ścieżki',
        description
            "Ścieżka się tu rozwidla. Lewa odnoga prowadzi na północny
             wschód; głuche dudnienie wydaje się w tamtą stronę coraz
             głośniejsze. Prawa odnoga łagodnie opada na południowy wschód.
             Główny korytarz dochodzi tu od zachodu.",
        w_to In_Corridor,
        ne_to At_Junction_With_Warm_Walls,
        se_to In_Limestone_Passage,
        d_to In_Limestone_Passage,
  has   nodwarf;

