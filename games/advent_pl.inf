! ------------------------------------------------------------------------------
!   Ptaszek w swoim naturalnym środowisku
! ------------------------------------------------------------------------------

Room    In_Bird_Chamber "Komnata Pomarańczowej Rzeki"
  with  name 'pomarańczowa' 'pomarańczowej' 'rzeka' 'rzeki' 'komnata'
             'komnacie',
        description
            "Jesteś we wspaniałej komnacie wysokiej na trzydzieści stóp.
             Ściany to zamarznięte rzeki pomarańczowego kamienia. Ze wschodniej
             i zachodniej strony komnaty wychodzą niewygodny kanion i porządny
             korytarz.",
        e_to In_Awkward_Sloping_E_W_Canyon,
        w_to At_Top_Of_Small_Pit,
  has   nodwarf;

Object  -> little_bird "mał/y ptasz/e/k/"
  with  name 'ptak' 'ptaka' 'ptakiem' 'ptaku' 'ptakowi' 'wesoły' 'wesołego'
             'wesołym' 'smutny' 'smutnego' 'smutnym' 'ptaszyna' 'ptaszynę'
             'ptaszyny',
        initial "Siedzi tu wesoły ptaszek i śpiewa.",
        before [;
          Examine:
            if (self in wicker_cage)
                "Ptaszek wygląda na nieszczęśliwego w klatce.";
            "Wesoły ptaszek siedzi tu i śpiewa.";
          Insert:
            if (second == wicker_cage)
                <<Catch self>>;
            else
                "Nie wkładaj biednego ptaszka do ", (dop) second, "!";
          Drop, Remove:
            if (self in wicker_cage) {
                print "(Ptaszek wylatuje z klatki.)^^";
                <<Release self>>;
            }
          Take, Catch:
            if (self in wicker_cage)
                "Przecież już masz ptaszka. Jeśli wyjmiesz go z klatki,
                 pewnie ci odleci.";
            if (wicker_cage notin player)
                "Ptaszka da się złapać, ale nie da się go nieść.";
            if (black_rod in player)
                "Kiedy wchodzisz, ptaszek się nie boi, ale gdy się zbliżasz,
                 zaczyna się niepokoić i nie udaje ci się go złapać.";
            move self to wicker_cage;
            give wicker_cage ~open;
            "Łapiesz ptaszka do wiklinowej klatki.";
          Release:
            if (self notin wicker_cage)
                "Ptaszek nie jest teraz w klatce.";
            give wicker_cage open;
            move self to location;
            if (Snake in location) {
                remove Snake;
                "Ptaszek atakuje zielonego węża i w zdumiewającym trzepocie
                 skrzydeł przepędza go.";
            }
            if (Dragon in location) {
                remove self;
                "Ptaszek atakuje zielonego smoka i w zdumiewającym trzepocie
                 skrzydeł spala się na popiół. Popiół rozwiewa wiatr.";
            }
            "Ptaszek odlatuje na wolność.";
        ],
        life [;
          Give:
            "Nie jest głodny. (On tylko tęskni za fiordami.) Poza tym
             podejrzewam, że wolałby ptasie ziarno.";
          Order, Ask, Answer:
            "Ćwir! Ćwir!";
          Attack:
            if (self in wicker_cage)
                "Och, zostaw w spokoju biednego, nieszczęśliwego ptaszka.";
            remove self;
            "Ptaszek nie żyje. Jego ciało znika.";
        ],
  has   animate male;

