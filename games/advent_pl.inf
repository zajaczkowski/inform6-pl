Class   FissureRoom
  class Room
  with  before [;
          Jump:
            if (CrystalBridge hasnt absent)
                "Z szacunkiem sugeruję, żeby przejść przez most, zamiast
                 skakać.";
            deadflag = 1;
            "Nie udało się.";
        ],
        d_to "Rozpadlina jest zbyt przerażająca!";

FissureRoom On_East_Bank_Of_Fissure "Wschodni brzeg rozpadliny"
  with  name 'wschodni' 'brzeg' 'brzegu' 'rozpadliny',
        description
            "Jesteś na wschodnim brzegu rozpadliny, która przecina salę na
             wskroś. Mgła jest tu dość gęsta, a rozpadlina za szeroka, żeby
             ją przeskoczyć.",
        e_to In_Hall_Of_Mists,
        w_to "Rozpadlina jest za szeroka.";

FissureRoom West_Side_Of_Fissure "Zachodnia strona rozpadliny"
  with  name 'zachodnia' 'strona' 'stronie' 'rozpadliny',
        description
            "Jesteś po zachodniej stronie rozpadliny w Sali Mgieł.",
        w_to At_West_End_Of_Hall_Of_Mists,
        e_to "Rozpadlina jest za szeroka.",
        n_to At_West_End_Of_Hall_Of_Mists,
        before [;
          Go:
            if (location == West_Side_Of_Fissure && noun == n_obj)
                print
                    "Przeczołgujesz się bardzo niskim, szerokim korytarzem,
                     biegnącym równolegle do Sali Mgieł, na północ od niej.^";
        ];

Treasure -> "diament/y"
  with  name 'diament' 'diamentu' 'brylant' 'brylanty' 'brylantów' 'kilka'
             'najwyższej' 'jakości',
        description "Wyglądają na najwyższej jakości!",
        initial "Leżą tu diamenty!",
  has   multitude pluralname;

Object  CrystalBridge "kryształow/y most/+u"
  with  name 'kryształ' 'kryształu' 'mostek' 'mostku',
        description "Rozpina się nad rozpadliną, więc możesz po nim przejść.",
        initial "Nad rozpadliną rozpina się teraz kryształowy most.",
        door_dir [;
            if (location == West_Side_Of_Fissure) return e_to;
            return w_to;
        ],
        door_to [;
            if (location == West_Side_Of_Fissure) return On_East_Bank_Of_Fissure;
            return West_Side_Of_Fissure;
        ],
        found_in On_East_Bank_Of_Fissure West_Side_Of_Fissure,
  has   static door open absent;

Scenic  "szerok/a rozpadlin/a"
  with  name 'szczelina' 'szczeliny' 'szczelinę' 'przepaść' 'przepaści',
        description "Rozpadlina wydaje się o wiele za szeroka, żeby ją
                     przeskoczyć.",
        found_in On_East_Bank_Of_Fissure West_Side_Of_Fissure,
  has   female;

