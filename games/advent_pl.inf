Object  -> black_rod "czarn/y pręt/ z zardzewiałą gwiazdą"
  with  name 'gwiazda' 'gwiazdą' 'gwiazdę' 'gwiazdy' 'zardzewiała'
             'zardzewiałą' 'zardzewiałej' 'żelazny' 'żelaznego' 'żelaznym'
             'trzystopowy' 'trzystopowego' 'różdżka' 'różdżkę' 'różdżki'
             'kij' 'kija' 'kijem' 'laska' 'laskę' 'laski',
        description "To czarny pręt długości trzech stóp, z zardzewiałą
                     gwiazdą na jednym końcu.",
        initial
            "Niedaleko leży czarny pręt długości trzech stóp, z zardzewiałą
             gwiazdą na jednym końcu.",
        before [;
          Wave:
            if (location == West_Side_Of_Fissure or On_East_Bank_Of_Fissure) {
                if (caves_closed) "Dziwne. Nic się nie dzieje.";
                if (CrystalBridge notin nothing) {
                    remove CrystalBridge;
                    give CrystalBridge absent;
                    West_Side_Of_Fissure.e_to = nothing;
                    On_East_Bank_Of_Fissure.w_to = nothing;
                    "Kryształowy most zniknął!";
                }
                else {
                    move CrystalBridge to location;
                    give CrystalBridge ~absent;
                    West_Side_Of_Fissure.e_to = CrystalBridge;
                    On_East_Bank_Of_Fissure.w_to = CrystalBridge;
                    "Nad rozpadliną rozpina się teraz kryształowy most.";
                }
            }
            "Nic się nie dzieje.";
        ];

