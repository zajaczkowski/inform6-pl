Room    In_Bedquilt "Pikowana Kołdra"
  with  name 'pikowana' 'pikowanej' 'kołdra' 'kołdrze',
        description
            "Jesteś w Pikowanej Kołdrze, długim korytarzu wschód-zachód
             pełnym dziur. Jeśli chcesz zwiedzać na chybił trafił, wybierz
             północ, południe, górę albo dół.",
        e_to At_Complex_Junction,
        w_to In_Swiss_Cheese_Room,
        s_to In_Slab_Room,
        u_to In_Dusty_Rock_Room,
        n_to At_Junction_Of_Three,
        d_to In_Anteroom,
        before [ destiny;
          Go:
            if (noun == s_obj or d_obj && random(100) <= 80) destiny = 1;
            if (noun == u_obj && random(100) <= 80)          destiny = 1;
            if (noun == u_obj && random(100) <= 50) destiny = In_Secret_N_S_Canyon_1;
            if (noun == n_obj && random(100) <= 60)          destiny = 1;
            if (noun == n_obj && random(100) <= 75) destiny = In_Large_Low_Room;
            if (destiny == 1)
                "Przeczołgujesz się przez jakieś małe dziury i lądujesz
                 z powrotem w głównym korytarzu.";
            if (destiny == 0) rfalse;
            PlayerTo(destiny);
            rtrue;
        ];

! ------------------------------------------------------------------------------

Room    In_Swiss_Cheese_Room "Komnata Szwajcarskiego Sera"
  with  name 'komnata' 'komnacie' 'szwajcarskiego' 'sera',
        description
            "Jesteś w komnacie, której ściany przypominają ser szwajcarski.
             Widoczne korytarze prowadzą na zachód, wschód, północny wschód
             i północny zachód. Część komnaty zajmuje wielki blok litej skały.",
        w_to At_East_End_Of_Twopit_Room,
        s_to In_Tall_E_W_Canyon,
        ne_to In_Bedquilt,
        nw_to In_Oriental_Room,
        e_to In_Soft_Room,
        before [;
          Go:
            if ((noun == s_obj && random(100) <= 80) ||
                (noun == nw_obj && random(100) <= 50))
                "Przeczołgujesz się przez jakieś małe dziury i lądujesz
                 z powrotem w głównym korytarzu.";
        ];

Scenic  -> "blok/+u litej skały"
  with  name 'skała' 'skały' 'skałę' 'lita' 'litej' 'wielki' 'wielkiego',
        description "To po prostu ogromny blok.",
        before [;
          LookUnder, Push, Pull, Take:
            "Chyba żartujesz.";
        ];

! ------------------------------------------------------------------------------
!   Sala Dwóch Jam
! ------------------------------------------------------------------------------
!   Możliwe wysokości rośliny:
! ------------------------------------------------------------------------------

Constant TINY_P = 0;
Constant TALL_P = 1;
Constant HUGE_P = 2;

Room    At_West_End_Of_Twopit_Room "Zachodni koniec Sali Dwóch Jam"
  with  name 'zachodni' 'koniec' 'końcu' 'sali' 'dwóch' 'jam',
        description
            "Jesteś na zachodnim końcu Sali Dwóch Jam. Na tym końcu sali,
             w ścianie nad jamą, jest duża dziura.",
        e_to At_East_End_Of_Twopit_Room,
        w_to In_Slab_Room,
        d_to In_West_Pit,
        u_to "To za wysoko, nie dosięgniesz.",
        before [;
          Enter:
            if (noun == HoleAbovePit_1) "To za wysoko, nie dosięgniesz.";
        ];

Object  PlantStickingUp "łodyg/a fasoli"
  with  name 'roślina' 'rośliny' 'roślinę' 'roślinie' 'roślinką' 'łodyżka'
             'łodyżkę' 'fasola' 'fasolę' 'pnącze' 'pnącza' 'olbrzymia'
             'olbrzymią' 'olbrzymiej' 'malutka' 'malutką' 'mała' 'małą'
             'dwunastostopowa' 'dwunastostopową' 'wysoka' 'wysoką',
        describe [;
            if (Plant.height == TALL_P)
                "Z zachodniej jamy wystaje wierzchołek łodygi fasoli
                 wysokiej na dwanaście stóp.";
            "Z zachodniej jamy wyrasta ogromna łodyga fasoli, sięgająca aż
             do dziury.";
        ],
        before [;
          Examine:
            RunRoutines(self, describe);
            rtrue;
          Climb:
            if (Plant.height == HUGE_P) <<Climb Plant>>;
        ],
        found_in At_West_End_Of_Twopit_Room At_East_End_Of_Twopit_Room,
  has   absent static female;

Scenic  HoleAbovePit_1 "dziur/a nad jamą"
  with  name 'duża' 'dużą' 'dużej' 'otwór' 'otworu' 'otworze',
        description
            "Dziura jest w ścianie nad jamą, na tym końcu sali.",
        found_in In_West_Pit At_West_End_Of_Twopit_Room,
  has   female;

! ------------------------------------------------------------------------------

Room    In_West_Pit "W zachodniej jamie"
  with  name 'zachodnia' 'zachodniej' 'jama' 'jamie',
        description
            "Jesteś na dnie zachodniej jamy w Sali Dwóch Jam. Jakieś
             dwadzieścia pięć stóp nad tobą jest w ścianie duża dziura.",
        before [;
          Climb:
            if (noun == Plant) rfalse;
            if (Plant.height == TINY_P)
                "Nie ma tu na co się wspinać. Żeby wyjść z jamy, wpisz
                 ~do góry~ albo ~wyjdź~.";
        ],
        u_to At_West_End_Of_Twopit_Room,
  has   nodwarf;

Object  -> Plant "roślin/a"
  with  name 'łodyga' 'łodygi' 'łodygę' 'łodydze' 'łodygą' 'fasola' 'fasoli'
             'fasolę' 'pnącze' 'pnącza' 'roślinka' 'roślinkę' 'roślinki'
             'olbrzymia' 'olbrzymią' 'olbrzymiej' 'malutka' 'malutką' 'mała'
             'małą' 'mruczącą' 'dwunastostopowa' 'dwunastostopową' 'wysoka'
             'wysoką' 'ryczącą',
        describe [;
            switch (self.height) {
              TINY_P:
                "W jamie rośnie malutka roślinka i mruczy: ~Wody, wody...~";
              TALL_P:
                "Z jamy wyrasta łodyga fasoli wysoka na dwanaście stóp
                 i ryczy: ~Wody!! Wody!!~";
              HUGE_P:
                "Olbrzymia łodyga fasoli sięga aż do samej dziury.";
            }
        ],
        before [;
          Climb:
            switch (self.height) {
              TINY_P:
                "To przecież tylko mała roślinka!";
              TALL_P:
                print
                    "Wspinasz się po roślinie i wychodzisz z jamy.^";
                PlayerTo(At_West_End_Of_Twopit_Room);
                rtrue;
              HUGE_P:
                print
                    "Wdrapujesz się po roślinie i przemykasz przez dziurę
                     na górze.^";
                PlayerTo(In_Narrow_Corridor);
                rtrue;
            }
          Take:
            "Roślina ma wyjątkowo głębokie korzenie i nie da się jej wyrwać.";
          Water:
            if (bottle notin player)
                "Nie masz czym podlać rośliny.";
            switch (child(bottle)) {
              nothing:
                "Butelka jest pusta.";
              oil_in_the_bottle:
                remove oil_in_the_bottle;
                "Roślina z oburzeniem strząsa olej z liści i pyta: ~Wody?~";
            }
            remove water_in_the_bottle;
            switch ((self.height)++) {
              TINY_P:
                print
                    "Roślina przez kilka sekund rośnie jak szalona.^^";
                give PlantStickingUp ~absent;
              TALL_P:
                print
                    "Roślina wystrzeliwuje w górę i wypełnia niemal całe
                     dno jamy.^^";
              HUGE_P:
                print
                    "Za dużo wody! Roślina więdnie! Ona... ona...^^";
                give PlantStickingUp absent;
                remove PlantStickingUp;
                self.height = TINY_P;
            }
            <<Examine self>>;
          Oil:
            <<Water self>>;
          Examine:
            self.describe();
            rtrue;
        ],
        height TINY_P,
  has   female;

! ------------------------------------------------------------------------------

Room    At_East_End_Of_Twopit_Room "Wschodni koniec Sali Dwóch Jam"
  with  name 'wschodni' 'koniec' 'końcu' 'sali' 'dwóch' 'jam',
