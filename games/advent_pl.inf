Room    In_Barren_Room "Pusta komnata"
  with  name 'pusta' 'pustej' 'komnata' 'komnacie',
        description
            "Jesteś w pustej komnacie. Środek komnaty jest zupełnie pusty, jeśli
             nie liczyć kurzu. Ślady w kurzu prowadzą w stronę drugiego końca
             komnaty. Jedyne wyjście prowadzi tam, skąd się tu weszło.",
        w_to In_Front_Of_Barren_Room,
        out_to In_Front_Of_Barren_Room,
  has   nodwarf;

Scenic  -> "kurz/+u"
  with  name 'ślady' 'śladów' 'pył' 'pyłu',
        description "Wygląda jak zwykły kurz.";

Object  -> Bear "wielk/i niedźwied/ź=zi/ jaskiniow/y!"
  with  name 'miś' 'misia' 'misiem' 'misiu' 'oswojony' 'oswojonego'
             'oswojonym' 'groźny' 'groźnego' 'groźnym' 'dziki' 'dzikiego',
        describe [;
            if (self.is_following_you)
                "Chodzi za tobą bardzo duży, oswojony niedźwiedź.";
            if (self.is_friendly == false)
                "Z drugiego końca komnaty przygląda ci się groźny niedźwiedź
                 jaskiniowy!";
            if (location == In_Barren_Room)
                "W kącie spokojnie siedzi łagodny niedźwiedź jaskiniowy.";
            "W pobliżu kręci się zadowolony z życia niedźwiedź.";
        ],
        life [;
          Attack:
            if (axe in player) <<ThrowAt axe self>>;
            if (self.is_friendly)
                "Niedźwiedź jest zdezorientowany; chce tylko być twoim
                 przyjacielem.";
            "Czym? Gołymi rękami? Przeciwko *jego* niedźwiedzim łapom??";
          ThrowAt:
            if (noun ~= axe) <<Give noun self>>;
            if (self.is_friendly)
                "Niedźwiedź jest zdezorientowany; chce tylko być twoim
                 przyjacielem.";
            move axe to location;
            axe.is_near_bear = true;
            "Topór chybia i ląduje obok niedźwiedzia, tam gdzie nie da się
             po niego sięgnąć.";
          Give:
            if (noun == tasty_food) {
                axe.is_near_bear = false;
                remove tasty_food;
                self.is_friendly = true;
                "Niedźwiedź łapczywie pożera twoje jedzenie, po czym wyraźnie
                 się uspokaja, a nawet robi się całkiem przyjazny.";
            }
            if (self.is_friendly)
                "Niedźwiedź nie wydaje się zbytnio zainteresowany twoją
                 propozycją.";
            "Ojej - twoja propozycja tylko jeszcze bardziej rozzłościła
             niedźwiedzia!";
          Order, Ask, Answer:
            "To Miś o Bardzo Małym Rozumku.";
        ],
        before [;
          Examine:
            print "Niedźwiedź jest ogromny";
            if (self.is_friendly) ", ale wydaje się przyjazny.";
            " i wygląda na bardzo groźnego!";
          Take, Catch:
            if (self.is_friendly == false) "Chyba żartujesz!";
            if (golden_chain has locked)
                "Niedźwiedź jest wciąż przykuty do ściany.";
            self.is_following_you = true;
            StartDaemon(self);
            "Dobrze, niedźwiedź chodzi teraz za tobą.";
          Drop, Release:
            if (self.is_following_you == false) "Słucham?";
            self.is_following_you = false;
            StopDaemon(self);
            if (Troll in location) {
                remove Troll;
                "Niedźwiedź toczy się w stronę trolla, który wydaje z siebie
                 zaskoczony pisk i ucieka. Niedźwiedź szybko rezygnuje
                 z pościgu i wraca.";
            }
            "Niedźwiedź oddala się od ciebie.";
        ],
        daemon [;
            if (location == thedark) rfalse;
            if (self in location) {
                if (location == At_Breath_Taking_View)
                    "^Niedźwiedź ryczy z zachwytu.";
                rfalse;
            }
            move self to location;
            "^Niedźwiedź człapie za tobą.";
        ],
        is_following_you false,
        is_friendly false,
  has   animate male;

Treasure -> golden_chain "złot/y łańcuch/"
  with  name 'ogniwa' 'ogniw' 'kajdany' 'kajdan' 'szczerozłoty'
             'szczerozłotego' 'złoto' 'złota' 'gruby' 'grubego' 'łańcuchy',
        description "Łańcuch ma grube ogniwa ze szczerego złota!",
        describe [;
            if (self has locked)
                "Niedźwiedzia trzyma na uwięzi łańcuch ze szczerego złota.";
            "Na ziemi leży zwinięty łańcuch ze szczerego złota!";
        ],
        with_key set_of_keys,
        before [;
          Take:
            if (self has locked) {
                if (Bear.is_friendly) "Jest przypięty do przyjaznego
                                       niedźwiedzia.";
                "Jest przypięty do groźnego niedźwiedzia!";
            }
          Unlock:
            if (Bear.is_friendly == false)
                "Nie da się przejść obok niedźwiedzia, żeby odpiąć łańcuch,
                 i może to i lepiej.";
          Lock:
            if (self hasnt locked) "Mechanizm już się nie zamknie.";
        ],
        after [;
          Unlock:
            "Odpinasz łańcuch i uwalniasz oswojonego niedźwiedzia.";
        ],
        depositpoints 14,
  has   lockable locked;

