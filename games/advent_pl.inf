Room    In_Shell_Room "Komnata Muszli"
  with  name 'komnata' 'komnacie' 'muszli',
        description
            "Jesteś w dużej komnacie wykutej w skale osadowej. Podłogę
             i ściany pokrywają odłamki muszli zatopione w kamieniu. Płytki
             korytarz prowadzi w dół, a nieco bardziej stromy w górę. Od
             południa wchodzi tu niskie przejście, którym trzeba iść na
             czworakach.",
        u_to In_Arched_Hall,
        d_to In_Ragged_Corridor,
        s_to [;
            if (giant_bivalve in player) {
                if (giant_bivalve has open)
                    "Nie przeciśniesz tej pięciostopowej ostrygi przez to małe
                     przejście!";
                else
                    "Nie przeciśniesz tego pięciostopowego małża przez to małe
                     przejście!";
            }
            return At_Complex_Junction;
        ];

Object  -> giant_bivalve "olbrzym/i małż/"
  with  name 'ostryga' 'ostrygi' 'ostrygę' 'ostrygą' 'ostrydze' 'mięczak'
             'mięczaka' 'małża' 'muszla' 'muszlę' 'muszli',
        describe [;
            if (self.has_been_opened)
                "Leży tu olbrzymia ostryga o szczelnie zamkniętej muszli.";
            "Leży tu olbrzymi małż o szczelnie zamkniętej muszli.";
        ],
        before [;
          Examine:
            if (location == At_Ne_End or At_Sw_End)
                "Ciekawe. Na spodzie ostrygi chyba coś napisano:
                 ^^
                 ~W tym miejscu jest coś dziwnego: jedno z przekleństw,
                 które znam od zawsze, działa tu teraz inaczej.~";
            "Jakiś olbrzymi małż.";
          Open:
            "Nie masz dość siły, żeby otworzyć małża gołymi rękami.";
          Unlock:
            if (second ~= trident) {
                print (CMian) second, " nie ";
                PL(second, "jest", "są");
                " dość ", (nop) Forma(second, "mocny", "mocna", "mocne",
                    "mocne", "mocni"), ", żeby otworzyć małża.";
            }
            if (self.has_been_opened)
                "Ostryga otwiera się ze skrzypnięciem, ale w środku jest tylko
                 ostryga. Zaraz znów się zatrzaskuje.";
            self.has_been_opened = true;
            move pearl to In_A_Cul_De_Sac;
            "Z małża wypada lśniąca perła i gdzieś się toczy. Ojej, to
             chyba jednak ostryga. (Nigdy nie umiałem odróżniać małży.)
             Czymkolwiek jest, znów się zatrzasnęła.";
          Attack:
            "Muszla jest bardzo mocna i odporna na ataki.";
        ],
        has_been_opened false;

Treasure pearl "lśniąc/a perł/a"
