! ------------------------------------------------------------------------------
!   Tu mieszkają smoki
! ------------------------------------------------------------------------------

Room    In_Secret_Canyon "Tajny kanion"
  with  name 'tajny' 'kanion' 'kanionie',
        description
            "Jesteś w tajnym kanionie, z którego wychodzi się na północ i na
             wschód.",
        e_to [;
            if (canyon_from == In_Secret_E_W_Canyon) return canyon_from;
            if (Dragon in location)
                "Smok wygląda dość paskudnie. Lepiej nie próbuj się obok niego
                 przemykać.";
            return In_Secret_E_W_Canyon;
        ],
        n_to [;
            if (canyon_from == In_Secret_N_S_Canyon_0) return canyon_from;
            if (Dragon in location)
                "Smok wygląda dość paskudnie. Lepiej nie próbuj się obok niego
                 przemykać.";
            return In_Secret_N_S_Canyon_0;
        ],
        out_to [;
            return canyon_from;
        ],
        before [;
            if (action == ##Yes && Dragon.is_being_attacked) {
                remove Dragon;
                move DragonCorpse to location;
                Dragon.is_being_attacked = false;
                "Gratulacje! Właśnie pokonał", (nop) Gracz("eś", "aś"), " smoka gołymi rękami! (Niewiarygodne, prawda?)";
            }
            if (action == ##No && Dragon.is_being_attacked) {
                Dragon.is_being_attacked = false;
                "Też tak sądzę.";
            }
            Dragon.is_being_attacked = false;
        ];

Object  -> Dragon "ogromn/y zielon/y smok/"
  with  name 'potwór' 'potwora' 'potworem' 'bestia' 'bestię' 'bestii'
             'jaszczur' 'jaszczura' 'jaszczurem' 'groźny' 'groźnego'
             'groźnym' 'łuskowaty' 'łuskowatego' 'olbrzymi' 'olbrzymiego'
             'dziki' 'dzikiego',
        description "Na twoim miejscu nie zadzierałbym z nim.",
        initial "Drogę zagradza ogromny, groźny zielony smok!",
        life [;
          Attack:
            self.is_being_attacked = true;
            "Czym? Gołymi rękami?";
          Give:
            "Smok jest nieprzejednany.";
          ThrowAt:
            if (noun ~= axe)
                "Gołe ręce byłyby chyba lepsze niż to coś!";
            move axe to location;
            "Topór odbija się nieszkodliwie od grubych łusek smoka.";
        ],
        is_being_attacked false,
  has   animate male;

Treasure -> "persk/i dywan/+u"
  with  name 'dywanik' 'dywanika' 'kobierzec' 'kobierca' 'kobiercu' 'piękny'
             'pięknego' 'pięknym' 'najpiękniejszy' 'smoczy' 'smoczego',
        describe [;
            if (Dragon in location)
                "Smok rozwalił się na perskim dywanie!";
            "Na podłodze rozłożony jest perski dywan.";
        ],
        before [;
          Take:
            if (Dragon in location)
                "Najpierw trzeba by skłonić smoka, żeby się przesunął!";
        ],
        depositpoints 14;

Object  DragonCorpse "ciał/o smoka"
  with  name 'smok' 'smoka' 'smokiem' 'smoku' 'zwłoki' 'zwłok' 'trup'
             'trupa' 'martwy' 'martwego' 'martwym' 'smocze' 'smoczego',
        initial "Z boku leży ciało ogromnego, martwego zielonego smoka.",
        before [;
          Attack:
            "Szkód narobiono już dość!";
        ],
  has   static neuter;

