Room    In_Hall_Of_Mt_King "Sala Króla Gór"
  with  name 'sala' 'sali' 'króla' 'gór',
        description
            "Jesteś w Sali Króla Gór, z której we wszystkich kierunkach
             odchodzą korytarze.",
        cant_go "No, może nie całkiem we wszystkich kierunkach.",
        u_to In_Hall_Of_Mists,
        e_to In_Hall_Of_Mists,
        n_to Low_N_S_Passage,
        s_to In_South_Side_Chamber,
        w_to In_West_Side_Chamber,
        sw_to In_Secret_E_W_Canyon,
        before [;
          Go:
            if (Snake in self && (noun == n_obj or s_obj or w_obj ||
                                 (noun == sw_obj && random(100) <= 35)))
                "Nie przejdziesz obok węża.";
        ];

Object  -> Snake "ogromn/y zielon/y w/ą=ę/ż/"
  with  name 'kobra' 'kobry' 'kobrę' 'kobrą' 'żmija' 'żmii' 'żmiję' 'żmiją'
             'gad' 'gada' 'gadem' 'groźny' 'groźnego' 'groźnym' 'jadowity'
             'jadowitego' 'jadowitym' 'wielki' 'wielkiego' 'wielkim'
             'zabójczy' 'zabójczego' 'wężyk',
        description "Na twoim miejscu nie zadzierałbym z nim.",
        initial "Drogę zagradza ogromny, groźny zielony wąż!",
        life [;
          Order, Ask, Answer:
            "Sssss!";
          ThrowAt:
            if (noun == axe) <<Attack self>>;
            <<Give noun self>>;
          Give:
            if (noun == little_bird) {
                remove little_bird;
                "Wąż pożarł twojego ptaszka.";
            }
            "Nie ma tu nic, co chciałby zjeść (może poza tobą).";
          Attack:
            "Atakowanie węża nic nie da, a do tego jest bardzo
             niebezpieczne.";
          Take:
            deadflag = 1;
            "To on bierze ciebie. Chlup!";
        ],
  has   animate male;

