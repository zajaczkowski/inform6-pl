! ------------------------------------------------------------------------------
!   Komnata ze skałą Y2 i okolice, nieco niżej
! ------------------------------------------------------------------------------

Room    At_Y2 "Przy ~Y2~"
  with  name 'y2',
        description
            "Jesteś w dużej komnacie z korytarzem na południe, korytarzem na
             zachód i ścianą z pokruszonej skały na wschodzie. Na skale
             pośrodku komnaty widnieje wielki napis ~Y2~.",
        after [;
          Look:
            if (random(100) <= 25) print "^Głuchy głos mówi: ~Plugh.~^";
        ],
        before [;
          Plugh:
            PlayerTo(Inside_Building);
            rtrue;
          Plover:
            if (In_Plover_Room hasnt visited) rfalse;
            if (egg_sized_emerald in player) {
                move egg_sized_emerald to In_Plover_Room;
                score = score - 5;
            }
            PlayerTo(In_Plover_Room);
            rtrue;
        ],
        s_to Low_N_S_Passage,
        e_to Jumble_Of_Rock,
        w_to At_Window_On_Pit_1;

Scenic  -> "skał/a z napisem Y2"
  with  name 'kamień' 'kamienia' 'kamieniu' 'głaz' 'głazu' 'głazie' 'napis'
