Room    At_Junction_With_Warm_Walls "Rozwidlenie przy ciepłych ścianach"
  with  name 'rozwidlenie' 'rozwidleniu' 'ciepłe' 'ciepłych' 'ściany',
        description
            "Ściany są tu całkiem ciepłe. Z północy dobiega jednostajny ryk,
             tak głośny, że cała jaskinia zdaje się drżeć. Inny korytarz
             prowadzi na południe, a na wschód niskie przejście.",
        s_to At_Fork_In_Path,
        n_to At_Breath_Taking_View,
        e_to In_Chamber_Of_Boulders,
  has   nodwarf;

! ------------------------------------------------------------------------------

Room    At_Breath_Taking_View "Zapierający dech widok"
  with  name 'zapierający' 'dech' 'widok' 'widoku',
        description
            "Stoisz na krawędzi widoku zapierającego dech w piersiach. Daleko
             w dole jest czynny wulkan, z którego wylewają się wielkie
             strumienie roztopionej lawy i kaskadami spływają z powrotem
             w głębiny. Rozżarzona skała wypełnia najdalsze zakątki groty
             krwistoczerwoną łuną, nadając wszystkiemu niesamowity, makabryczny
             wygląd. Powietrze jest pełne migoczących iskier popiołu i ciężkiej
             woni siarki. Ściany są gorące w dotyku, a grzmot wulkanu zagłusza
             wszystkie inne dźwięki. W poszarpanym stropie wysoko w górze tkwią
             niezliczone poskręcane formacje z czystego, białego alabastru,
             które rozpraszają mętne światło w złowrogie zjawy na ścianach.
             Z jednej strony jest głęboki wąwóz, pełen dziwacznego chaosu
             powykręcanych skał, jakby wykutych przez samego diabła. Z głębi
             wulkanu wyrywa się ogromna rzeka ognia, przepala sobie drogę przez
             wąwóz i spada w bezdenną otchłań daleko po twojej lewej. Po
             prawej z jałowej wyspy pośrodku siarkowego jeziora, które
             złowieszczo bulgocze, bez przerwy tryska ogromny gejzer
             parzącej pary. Najdalsza prawa ściana płonie własnym żarem, co
             dodaje piekielnego blasku i tak już iście piekielnej scenie. Na
             południe prowadzi ciemny, złowróżbny korytarz.",
        s_to At_Junction_With_Warm_Walls,
        out_to At_Junction_With_Warm_Walls,
        d_to "Nie wygłupiaj się!",
        before [;
          Jump:
            <<Go d_obj>>;
        ],
  has   light;

Scenic  -> "czynn/y wulkan/+u"
  with  name 'skała' 'skały' 'skałę' 'rozżarzona' 'rozżarzoną' 'lawa' 'lawy'
             'lawę' 'krwistoczerwona' 'łuna' 'łunę' 'łuny',
        description
            "Z wulkanu wylewają się wielkie strumienie roztopionej lawy
             i kaskadami spływają z powrotem w głębiny. Rozżarzona skała
             wypełnia najdalsze zakątki groty krwistoczerwoną łuną, nadając
             wszystkiemu niesamowity, makabryczny wygląd.";

Scenic  -> "iskr/y+ie popiołu"
  with  name 'iskra' 'iskrę' 'popiół' 'popiołu' 'powietrze' 'powietrza'
             'migoczące' 'migoczących',
        description
            "Iskry są za daleko, żeby dobrze im się przyjrzeć.",
  has   multitude pluralname female;

Scenic  -> "postrzępion/y strop/+u"
