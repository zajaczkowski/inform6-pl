Room    At_Window_On_Pit_1 "Przy oknie nad jamą"
  with  name 'okno' 'oknie' 'jamą',
        description
            "Stoisz przy niskim oknie, które wychodzi na ogromną jamę ginącą
             w górze poza zasięgiem wzroku. Ponad pięćdziesiąt stóp niżej
             niewyraźnie widać dno. Dno jamy pokrywają smużki białej mgły,
             gęstniejące w prawo. Ślady w kurzu wokół okna wskazują, że ktoś
             niedawno tu był. Dokładnie naprzeciwko, po drugiej stronie jamy,
             dwadzieścia pięć stóp dalej, jest podobne okno wychodzące na
             oświetloną komnatę. Widać w nim mroczną postać, która ci się
             przygląda.",
        before [;
          WaveHands:
            "Mroczna postać macha ci w odpowiedzi!";
        ],
        cant_go "Jedyne przejście prowadzi z powrotem na wschód, do Y2.",
        e_to At_Y2;

Class   PitScenic
  with  found_in At_Window_On_Pit_1 At_Window_On_Pit_2,
  has   scenery;

