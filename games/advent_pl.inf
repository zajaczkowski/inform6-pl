DeadendRoom Dead_End_14
  class Room
  with  name 'ślepy' 'zaułek' 'zaułku' 'automat' 'automatu',
        short_name "Ślepy zaułek przy automacie",
        description
            "Docierasz do ślepego zaułka. Stoi tu masywny automat.
             ^^
             Hmmm... W kurzu ktoś nabazgrał ozdobnym pismem jakąś wiadomość.",
        n_to Different_Maze_2,
        out_to Different_Maze_2,
  has   nodwarf;

Scenic  -> "napis/+u w kurzu"
  with  name 'wiadomość' 'wiadomości' 'bazgroły' 'pismo' 'pisma' 'ozdobne'
             'ozdobnym' 'nabazgrany',
        description
            "Napis głosi: ~To nie ten labirynt, w którym pirat zostawia swoją
             skrzynię ze skarbem.~";

Scenic  -> VendingMachine "automat/+u"
  with  name 'maszyna' 'maszynę' 'maszyny' 'maszynie' 'otwór' 'otworu'
             'szczelina' 'szczelinę' 'masywny' 'masywnego' 'automacie',
        description
            "Instrukcja na automacie głosi: ~Wrzuć monety, a otrzymasz świeże
             baterie.~",
        before [;
          Receive:
            if (noun == rare_coins) {
                move fresh_batteries to location;
                remove rare_coins;
                "Chwilę po wrzuceniu monet do otworu automat wydaje zgrzytliwy
                 dźwięk, a u twoich stóp spada para świeżych baterii.";
            }
            "Automat chyba przyjmuje tylko monety.";
          Attack:
            "Automat jest bardzo solidny i wychodzi z twojego ataku bez
             najmniejszego zadrapania.";
          LookUnder:
            "Pod automatem niczego nie ma.";
          Search:
            "Nie da się dostać do wnętrza automatu.";
          Take:
            "Automat jest o wiele za ciężki, żeby go ruszyć.";
        ];

Object  fresh_batteries "śwież/e bateri/e+y" VendingMachine
  with  name 'bateria' 'baterię' 'baterii' 'nowe' 'nowych',
        description
            "Wyglądają jak zwykłe baterie. (Grobowy głos mówi: ~Wciąż
             działają!~)",
        initial "Leżą tu świeże baterie.",
        before [;
          Count:
            "Para.";
        ],
        have_been_used false,
  has   pluralname female;

Object  old_batteries "zużyt/e bateri/e+y"
  with  name 'bateria' 'baterię' 'baterii' 'stare' 'starych' 'wyczerpane'
             'wyczerpanych',
        description "Wyglądają jak zwykłe baterie.",
        initial "W pobliżu ktoś wyrzucił zużyte baterie.",
        before [;
          Count:
            "Para.";
        ],
  has   pluralname female;

! ------------------------------------------------------------------------------
!   Krasnoludy!
! ------------------------------------------------------------------------------

Object  dwarf "groźn/y mał/y krasnolud/"
  with  name 'karzeł' 'karła' 'paskudny' 'paskudnego' 'wredny' 'wrednego'
             'krasnoludek' 'krasnoludka',
        description
            "Chyba nie warto podchodzić zbyt blisko. Wystarczy powiedzieć, że
             ten mały jest dość agresywny.",
        initial "W cieniu kryje się groźny mały krasnolud.",
        number 5,
        daemon [;
            if (location == thedark) return;
            if (self.number == 0) {
                StopDaemon(self);
                return;
            }
            if (parent(self) == nothing) {
                if (location has nodwarf || location has light) return;
                if (random(100) <= self.number) {
                    if (Bear in location || Troll in location) return;
                    new_line;
                    if (Dragon in location) {
                        self.number--;
                        "Pojawia się krasnolud, ale smok jednym niedbałym
                         dmuchnięciem zamienia go w parę!";
                    }
                    move self to location;
                    "Z cienia wychodzi groźny mały krasnolud!";
                }
                return;
            }
            if (parent(self) ~= location) {
                if (location == thedark) return;
                if (location has nodwarf || location has light) return;
                if (random(100) <= 96 && parent(self) ~= In_Mirror_Canyon) {
                    move self to location;
                    print "^Krasnolud skrada się za tobą...^";
                }
                else {
                    remove self;
                    return;
                }
            }
            if (random(100) <= 75) {
                new_line;
                if (self.has_thrown_axe == false) {
                    move axe to location;
                    self.has_thrown_axe = true;
                    remove self;
                    "Krasnolud rzuca w ciebie paskudnym małym toporem, chybia,
                     klnie i ucieka.";
                }
                if (location == In_Mirror_Canyon)
                    "Krasnolud podziwia się w lustrze.";
                print "Krasnolud rzuca w ciebie paskudnym małym nożem ";
                if (random(1000) <= 95) {
                    deadflag = 1;
                    "i trafia!";
                }
                "i chybia!";
            }
            if (random(3) == 1) {
                remove self;
                "^Znudzony krasnolud gdzieś się wymyka.";
            }
        ],
        before [;
          Kick:
            "Kopniakiem posyłasz krasnoluda na drugi koniec komnaty. Klnie,
             wstaje i otrzepuje się. Teraz jest wściekły jak nigdy!";
        ],
        life [;
          ThrowAt:
            if (noun == axe) {
                if (random(3) ~= 1) {
                    remove self;
                    move axe to location;
                    self.number--;
                    "Mały krasnolud nie żyje! Ciało znika w chmurze tłustego
                     czarnego dymu.";
                }
                move axe to location;
                "Pudło! Mały krasnolud uskakuje przed toporem.";
            }
            <<Give noun second>>;
          Give:
            if (noun == tasty_food)
                "Głupi pomysł - krasnoludy jedzą tylko węgiel! Teraz jest
                 *naprawdę* wściekły!";
            "Krasnolud wcale nie jest zainteresowany twoją propozycją.
             (Może dlatego, że jeśli cię zabije, i tak dostanie wszystko,
             co masz.)";
          Attack:
            "Nie gołymi rękami. Mowy nie ma.";
        ],
        has_thrown_axe false,
  has   animate male;

Object  axe "krasnoludzk/i top/ó=o/r/"
  with  name 'toporek' 'toporka' 'toporkiem' 'siekiera' 'siekierę' 'siekiery'
             'mały' 'małego' 'małym',
        description "To po prostu mały topór.",
        initial "Leży tu mały topór.",
        before [;
            if (~~self.is_near_bear) rfalse;
          Examine:
            "Leży obok niedźwiedzia.";
          Take:
            "Nie ma szans. Leży obok groźnego niedźwiedzia, w zasięgu jego
             łap.";
        ],
        is_near_bear false;

! ------------------------------------------------------------------------------
!   Dwa spotkania z piratem
! ------------------------------------------------------------------------------

Object  pirate
  with  daemon [ obj booty_nearby;
            if (random(100) > 2 || location == thedark or In_Secret_Canyon ||
                location has light || location has nodwarf) return;
            if (dwarf in location)
                "^Pojawia się brodaty pirat, dostrzega krasnoluda i ucieka.";
            objectloop (obj ofclass Treasure && obj in player or location)
                booty_nearby = true;
            if (booty_nearby == false) {
                if (self.has_been_spotted) return;
                self.has_been_spotted = true;
                if (self.has_stolen_something) StopDaemon(self);
                "^Z ciemności za tobą dochodzą ciche szelesty. Gdy się
                 odwracasz, dostrzegasz brodatego pirata. Niesie dużą
                 skrzynię.
                 ^^
                 ~Do stu tysięcy beczek śledzi!~ woła. ~Ktoś mnie zobaczył!
                 Lepiej zmykam do labiryntu schować skrzynię!~
                 ^^
                 I już znika w mroku.";
            }
            if (self.has_stolen_something) return;
            self.has_stolen_something = true;
            if (self.has_been_spotted) StopDaemon(self);
            objectloop (obj ofclass Treasure && obj in player or location) {
                if (obj in player) score = score - 5;
                move obj to Dead_End_13;
            }
            "^Z cienia za tobą wyskakuje brodaty pirat! ~Har, har~ - rechocze.
             ~Wezmę sobie cały ten łup i schowam go razem z moją skrzynią
             głęboko w labiryncie!~ Porywa twój skarb i znika w mroku.";
        ],
        has_stolen_something false,
        has_been_spotted false;

! ----------------------------------------------------------------------------
!   Jaskinia się zamyka...
! ----------------------------------------------------------------------------

Object  cave_closer
  with  daemon [;
            if (treasures_found < MAX_TREASURES) return;
            StopDaemon(self);
            caves_closed = true;
            score = score + 25;
            remove CrystalBridge;
            give Grate locked ~open;
            remove set_of_keys;
            StopDaemon(dwarf);
            StopDaemon(pirate);
            remove Troll;
            remove Bear;
            remove Dragon;
            StartTimer(endgame_timer, 25);
            "^Grobowy głos niesie się echem po jaskini: ~Jaskinia wkrótce
             zostanie zamknięta. Wszyscy poszukiwacze przygód proszeni są
             o natychmiastowe wyjście przez główne biuro.~";
        ];

Object  endgame_timer
  with  time_left 0,
        time_out [;
            score = score + 10;
            while (child(player)) remove child(player);
            move bottle to At_Ne_End;
            if (child(bottle)) remove child(bottle);
            move giant_bivalve to At_Ne_End;
            move brass_lantern to At_Ne_End;
            move black_rod to At_Ne_End;
            move little_bird to At_Sw_End;
            move velvet_pillow to At_Sw_End;
            print
                "^Grobowy głos oznajmia: ~Jaskinia jest zamknięta.~ Gdy echo
                 cichnie, następuje oślepiający błysk światła (i mały obłoczek
                 pomarańczowego dymu)...
                 ^^
                 Gdy wzrok wraca ci do normy, rozglądasz się...^";
            PlayerTo(At_Ne_End);
        ];

! ------------------------------------------------------------------------------
!   Gra końcowa
! ------------------------------------------------------------------------------

Room    At_Ne_End "Północno-wschodni koniec magazynu"
  with  name 'koniec' 'końcu' 'magazyn' 'magazynu',
        description
            "Jesteś na północno-wschodnim końcu ogromnej sali, większej
             nawet od Komnaty Olbrzyma. Wygląda na magazyn programu
             ~Przygoda~. Masywne pochodnie wysoko w górze zalewają salę
             zadymionym żółtym światłem. Dookoła leży stos butelek
             (wszystkie puste), szkółka młodych łodyg fasoli cicho
             mruczących pod nosem, ławica ostryg, pęk czarnych prętów
             z zardzewiałymi gwiazdami na końcach i kolekcja mosiężnych lamp.
             Z boku na podłodze śpi mnóstwo krasnoludów, głośno chrapiąc.
             Tabliczka obok głosi: ~Nie budzić krasnoludów!~",
        sw_to At_Sw_End,
  has   light;

Object  -> "ogromn/e lustr/o"
  with  name 'zwierciadło' 'zwierciadła' 'wielkie' 'wielkiego' 'duże'
             'dużego' 'zawieszone' 'wiszące' 'krasnoludzkie',
        description "Wygląda jak zwykłe, choć ogromne lustro.",
        initial
            "Na jednej ze ścian wisi gigantyczne lustro, ciągnące się aż do
             drugiego końca sali, gdzie w oddali majaczą różne inne
             przedmioty.",
        before [;
          Attack:
            print
                "Uderzasz w lustro z głośnym hukiem, a ono rozpryskuje się na
                 miriady drobnych kawałeczków.^^";
            SleepingDwarves.wake_up();
            rtrue;
        ],
        found_in At_Ne_End At_Sw_End,
  has   static neuter;

Scenic  -> "zbi/ó=o/r/+u materiałów do gry"
  with  name 'rzeczy' 'rupiecie' 'rupieci' 'materiały' 'materiałów'
             'pochodnie' 'pochodni' 'przedmioty' 'przedmiotów' 'przygoda'
             'przygody' 'magazyn' 'magazynu' 'masywne' 'różne',
        description
            "Wszystko to już widziano, choć w nieco innym kontekście.",
        before [;
          Take:
            "Zabranie stąd łupu zepsułoby grę przyszłym graczom, więc
             zostawiasz materiały ~Przygody~ tam, gdzie są.";
        ];

Scenic  -> SleepingDwarves "śpiąc/e krasnolud/y"
  with  name 'krasnolud' 'krasnoluda' 'krasnoludów' 'krasnoludami'
             'chrapiące' 'chrapiących' 'drzemiące' 'drzemiących',
        description "Na twoim miejscu nie zaczepiałbym krasnoludów.",
        before [;
          Take:
            "Co, wszystkie?";
        ],
        life [;
          WakeOther:
            print
                "Szturchasz najbliższego krasnoluda. Budzi się zrzędliwie,
                 rzuca na ciebie jedno spojrzenie, klnie i sięga po topór.^^";
            self.wake_up();
            rtrue;
          Attack:
            self.wake_up();
            rtrue;
        ],
        wake_up [;
            deadflag = 1;
            "Ten hałas obudził krasnoludy. W sali jest teraz z tobą kilkadziesiąt
             groźnych małych krasnoludów! Większość z nich rzuca w ciebie
             nożami! Wszystkie trafiają!";
        ],
  has   animate multitude pluralname;

! ------------------------------------------------------------------------------

Room    At_Sw_End "Południowo-zachodni koniec magazynu"
  with  name 'koniec' 'końcu' 'magazyn' 'magazynu',
        description
            "Jesteś na południowo-zachodnim końcu magazynu. Z jednej strony
             jest jama pełna groźnych zielonych węży. Z drugiej stoi rząd
             małych wiklinowych klatek, a w każdej siedzi nadąsany ptaszek.
             W jednym kącie leży pęk czarnych prętów z zardzewiałymi znakami
             na końcach. Po podłodze porozrzucano mnóstwo aksamitnych poduszek.
             Na północny wschód ciągnie się olbrzymie lustro. U twoich stóp jest
             duża stalowa krata, a obok niej tabliczka: ~SKARBIEC. Klucze
             w głównym biurze.~",
        d_to RepositoryGrate,
        ne_to At_Ne_End,
  has   light;

Object  -> RepositoryGrate "stalow/a krat/a"
  with  name 'zwykła' 'zwykłą' 'zwykłej' 'kratka' 'kratkę' 'kratownica',
        description "Wygląda jak zwykła stalowa krata.",
        when_open "Krata jest otwarta.",
        when_closed "Krata jest zamknięta.",
        door_dir d_to,
        door_to Outside_Grate,
        with_key nothing,
  has   static door locked openable female;

Scenic  -> "zbi/ó=o/r/+u materiałów do gry"
  with  name 'jama' 'jamę' 'jamie' 'wąż' 'węże' 'węży' 'groźne' 'zielone'
             'rzeczy' 'rupiecie' 'rupieci' 'materiały' 'materiałów'
             'przygoda' 'przygody' 'magazyn' 'magazynu' 'masywne' 'różne',
        description
            "Wszystko to już widziano, choć w nieco innym kontekście.",
        before [;
          Take:
            "Zabranie stąd łupu zepsułoby grę przyszłym graczom, więc
             zostawiasz materiały ~Przygody~ tam, gdzie są.";
        ];

Object  -> black_mark_rod "czarn/y pręt/ z zardzewiałym znakiem"
  with  name 'znak' 'znakiem' 'zardzewiały' 'zardzewiałym' 'żelazny'
             'żelaznego' 'trzystopowy' 'wybuchowy' 'wybuchowego' 'dynamit'
             'dynamitu' 'laska' 'laskę' 'laski',
        description "To czarny pręt długości trzech stóp, z zardzewiałym
                     znakiem na jednym końcu.",
        initial
            "Niedaleko leży czarny pręt długości trzech stóp, z zardzewiałym
             znakiem na jednym końcu.",
        before [;
          Wave:
            "Nic się nie dzieje.";
        ];

! ------------------------------------------------------------------------------
!   Kilka punktów wejścia
! ------------------------------------------------------------------------------

[ Initialise;
    location = At_End_Of_Road;
    score = 36;
    StartDaemon(dwarf);
    StartDaemon(pirate);
    StartDaemon(cave_closer);
    "^^^^^Witaj w Przygodzie!^
          (Wpisz POMOC, żeby zobaczyć instrukcję i informacje o grze.)^^";
];

[ PrintRank;
    print ", co czyni cię ";
    if (score >= 348) "Wielkim Mistrzem Przygody!";
    if (score >= 330) "Mistrzem pierwszej klasy.";
    if (score >= 300) "Mistrzem drugiej klasy.";
    if (score >= 200) "Młodszym Mistrzem.";
    if (score >= 130) "Zaprawionym Poszukiwaczem Przygód.";
    if (score >= 100) "Doświadczonym Poszukiwaczem Przygód.";
    if (score >= 35)  "Poszukiwaczem Przygód.";
    if (score >= 10)  "Nowicjuszem.";
                      "Amatorem.";
];

[ DarkToDark;
    if (dark_warning == false) {
        dark_warning = true;
        "Jest zupełnie ciemno. Jeśli pójdziesz dalej, najpewniej wpadniesz
         do jakiejś jamy.";
    }
    if (random(4) == 1) {
        deadflag = 1;
        "Wpadasz do jamy i łamiesz sobie wszystkie kości!";
    }
    rfalse;
];

[ UnknownVerb word
    obj;
    objectloop (obj ofclass Room) {
        if (obj has visited && WordInProperty(word, obj, name)) {
            verb_wordnum = 0;
            return 'idź';
        }
    }
    rfalse;
];

! ------------------------------------------------------------------------------
!   Wskrzeszenie
! ------------------------------------------------------------------------------

[ AfterLife o;
    if (deadflag == 3) {
        deadflag = 1;
        rfalse;
    }
    print "^^";
    if (caves_closed)
        "Wygląda na to, że nie żyjesz. Cóż, skoro i tak zaraz zamykamy,
         chyba na tym skończymy.";
    switch (deaths) {
      0:
        print
            "Ojej, wygląda na to, że nie żyjesz. Może dałbym radę ci pomóc,
             ale nigdy wcześniej tego nie robiłem. Mam spróbować cię
             wskrzesić?^^";
      1:
        print
            "Ty niezdaro, znowu to samo! Nie wiem, jak długo jeszcze dam radę.
             Mam spróbować wskrzesić cię jeszcze raz?^^";
      2:
        print
            "No, teraz to już naprawdę przesada! Skończył mi się pomarańczowy
             dym! Chyba nie oczekujesz porządnego wskrzeszenia bez
             pomarańczowego dymu?^^";
    }
    print "> ";
    if (YesOrNo() == false) {
        switch (deaths) {
          0: "Jak sobie życzysz.";
          1: "Chyba rozsądny wybór.";
          2: "Tak myślałem!";
        }
    }
    switch (deaths) {
      0:
        print
            "Dobrze. Ale nie miej do mnie pretensji, jeśli coś pójdzie nie
             ta......
             ^^^^
             --- PUF!! ---
             ^^
             Spowija cię chmura pomarańczowego dymu. Kaszląc i łapiąc
             oddech, wychodzisz z dymu i odkrywasz, że jesteś....^";
      1:
        print
            "Dobrze, gdzie ja położyłem ten pomarańczowy dym?.... >PUF!<
             ^^
             Wszystko znika w gęstej chmurze pomarańczowego dymu.^";
      2:
        "Dobrze, skoro tyle wiesz, radź sobie dalej beze mnie! Ja się
         wynoszę!";
    }
    deaths++;
    score = score - 10;
    if (location ~= thedark) {
        while (child(player)) {
            o = child(player);
            move o to location;
            if (o ofclass Treasure) score = score - 5;
        }
    }
    else {
        while (child(player)) {
            o = child(player);
            move o to real_location;
            if (o ofclass Treasure) score = score - 5;
        }
    }
    move brass_lantern to At_End_Of_Road;
    give brass_lantern ~on ~light;
    remove dwarf;
    deadflag = 0;
    PlayerTo(Inside_Building);
];

! ------------------------------------------------------------------------------
!   Pomoc w formie menu (właściwie nie należy do samej gry)
! ------------------------------------------------------------------------------

[ HelpMenu;
    if (menu_item == 0) {
        item_width = 7;
        item_name = "O Przygodzie";
        if (deadflag == 2) return 4;
        else               return 3;
    }
    if (menu_item == 1) {
        item_width = 5;
        item_name = "Instrukcja";
    }
    if (menu_item == 2) {
        item_width = 4;
        item_name = "Historia";
    }
    if (menu_item == 3) {
        item_width = 6;
        item_name = "Autentyczność";
    }
    if (menu_item == 4) {
        item_width = 8;
        item_name = "Czy wiesz, że...";
    }
];

[ HelpInfo;
    if (menu_item == 1) {
        print
            "Znam miejsca, czynności i przedmioty. Możesz mną kierować za
             pomocą poleceń w trybie rozkazującym. Żeby się poruszać, spróbuj
             poleceń takich jak ~wejdź~, ~wschód~, ~zachód~, ~północ~,
             ~południe~, ~góra~, ~dół~, ~wejdź do budynku~, ~wespnij się
             na słup~ itd.^^";
        print
            "Znam kilka szczególnych przedmiotów, na przykład czarny pręt
             ukryty w jaskini. Można coś z nimi robić za pomocą czasowników,
             które znam. Zwykle trzeba podać czasownik, a po nim przedmiot
             (w razie potrzeby z przymiotnikami), ale czasem potrafię się
             domyślić przedmiotu z samego czasownika. Niektóre przedmioty
             same wskazują czynność; na przykład ~ekwipunek~ oznacza
             ~sprawdź ekwipunek~, a wtedy podaję listę tego, co masz przy
             sobie. Przedmioty mają skutki uboczne; na przykład pręt
             płoszy ptaszka.^^";
        print
            "Wiele poleceń ma skróty. Na przykład zamiast ~ekwipunek~ możesz
             wpisać ~i~, zamiast ~zbadaj przedmiot~ - ~x przedmiot~ itd.
             Kierunki skraca się tak: pn, pd, w, z, pnw, pnz, pdw, pdz,
             g (góra) i d (dół).^^";
        print
            "Zwykle, gdy ktoś ma kłopot z poruszaniem się, wystarczy
             spróbować kilku innych słów. Zwykle, gdy ktoś bezskutecznie
             próbuje coś zrobić z przedmiotem, próbuje czegoś, co przekracza
             jego (albo moje!) możliwości, i powinien spróbować zupełnie innego
             podejścia.^^";
        print
            "Pamiętaj, że korytarze w jaskini bardzo się wiją i że wyjście
             z komnaty na północ wcale nie gwarantuje, że do następnej wejdzie
             się od południa.^^";
        print
            "Jeśli chcesz wcześniej zakończyć przygodę, wpisz ~koniec~. Żeby
             przerwać przygodę i dokończyć ją później, wpisz ~zapisz~, a żeby
             wczytać zapisaną grę - ~wczytaj~. Żeby zobaczyć, jak ci idzie,
             wpisz ~wynik~. Pełną liczbę punktów za skarb dostaje się dopiero
             po bezpiecznym złożeniu go w budynku, choć część punktów dostaje
             się już za samo odnalezienie. Punkty traci się za śmierć albo za
             rezygnację, przy czym śmierć kosztuje więcej. Są też punkty
             za to, jak dużą część jaskini (jeśli w ogóle) udało się zbadać;
             w szczególności jest duża premia za samo dostanie się do środka
             (żeby odróżnić początkujących od reszty stawki), a są też inne
             sposoby sprawdzenia, czy udało się przejść przez niektóre
             z bardziej mrożących krew w żyłach miejsc.^^";
        print
            "Jeśli wydaje ci się, że masz już wszystkie skarby, po prostu
             zwiedzaj dalej przez jakiś czas. Jeśli nic ciekawego się nie
             wydarzy, znaczy, że jeszcze nie wszystkie. Jeśli coś ciekawego
             *się* wydarzy, znaczy to, że dostajesz premię i masz okazję zdobyć
             mnóstwo kolejnych punktów w części dla mistrzów.^^";
        "Powodzenia!";
    }
    if (menu_item == 2) {
        print
            "Być może pierwszym poszukiwaczem przygód był niewolnik Stephen
             Bishop, urodzony około 1820 roku: «drobny, zgrabny i bardzo
             przystojny»; «bystry, odważny i pełen zapału» przewodnik po
             Jaskini Mamuciej w krasie Kentucky. Historia jaskini to
             osobliwy mikrokosmos historii Ameryki. Jej odkrycie to legenda
             sięgająca lat dziewięćdziesiątych XVIII wieku; podobno myśliwy
             John Houchin ścigał rannego niedźwiedzia aż do dużej jamy nad
             Green River i natknął się na wejście. Przy wejściu roiło się od
             nietoperzy, a w czasie wojny 1812 roku intensywnie wydobywano
             tu guano, które rozpuszczano w kadziach z azotanem, żeby uzyskać
             saletrę do prochu. Po wojnie ceny spadły, ale jaskinia stała się
             pomniejszą atrakcją, kiedy w pobliżu znaleziono wysuszoną mumię
             Indianki, siedzącą prosto w kamiennej trumnie i otoczoną
             talizmanami. W 1815 roku Fawn Hoof, jak ją nazwano od jednego
             z amuletów, zabrał cyrk, który ściągał na nią tłumy w całej
             Ameryce (trasa przypominała nieco piosenkę Dona McLeana «The
             Legend of Andrew McCrew»). Trafiła w końcu do Instytutu
             Smithsona, ale w latach dwudziestych XIX wieku jaskinię nazywano
             już jednym z cudów świata, głównie dzięki jej pośmiertnym
             staraniom.^^";
        print
            "Na początku XIX wieku jaskinie europejskie były wielkimi
             atrakcjami turystycznymi, ale Jaskini Mamuciej, «cud świata» czy
             nie, prawie nikt nie odwiedzał. Nie była też wtedy szczególnie
             duża (nazwa została po górnikach, którzy chwalili się mamucimi
             urobkami guana). W 1838 roku właściciel Stephena Bishopa kupił
             jaskinię. Stephen, jak go (jako niewolnika) zawsze nazywano, był
             pod każdym względem niezwykłym człowiekiem: samouk w łacinie
             i grece, zasłynął jako «główny władca» swojego podziemnego
             królestwa. W wolnym czasie zbadał i nazwał dużą część jaskini,
             w ciągu roku podwajając znaną mapę. Charakterystyczny styl nazw
             w jaskini - na wpół swojski amerykański, na wpół klasyczny -
             zaczął się od Stephena: rzeka Styks, Komnata Śnieżki, Aleja
             Małego Nietoperza, Wielka Kopuła. Stephen znalazł dziwne ślepe
             ryby, węże, nieme świerszcze, szczątki niedźwiedzi jaskiniowych
             (dzikich, figlarnych stworzeń, długich na pięć stóp i wysokich na
             cztery, które wymarły pod koniec ostatniej epoki lodowcowej),
             kilkusetletnie indiańskie wyrobiska gipsu i coraz więcej jaskini.
             Jego mapa z 1842 roku, narysowana w całości z pamięci, była
             w użyciu jeszcze czterdzieści lat później.^^";
        print
            "Jako atrakcja turystyczna (a ponieważ właściciel Stephena był
             filantropem, przez krótki czas także, na podstawie beznadziejnej
             teorii medycznej, sanatorium dla gruźlików) jaskinia stała się
             wielkim biznesem: przez dziesięciolecia gorączkowo zajmowano
             pobliskie jaskinie i bez końca podważano tytuły prawne. Sąsiedni
             system, po drugiej stronie doliny Houchins w Flint Ridge, otworzył
             w 1912 roku Wielką Jaskinię Onyksową. W latach dwudziestych
             wojny jaskiniowe w Kentucky trwały w najlepsze. Konkurencyjni
             właściciele zawracali turystów za pomocą fałszywych policjantów,
             wynajmowali ludzi do zakłócania wycieczek z przewodnikiem
             konkurencji, palili budki z biletami i publikowali oszczercze
             i fałszywe ogłoszenia. Badanie jaskiń stało się tak niebezpieczne
             i tajemnicze, że w końcu w 1941 roku wkroczył rząd Stanów
             Zjednoczonych, ustanowił na dużej części tego obszaru park
             narodowy i w praktyce zakazał eksploracji jaskiń. Gorączka
             złota turystów i tak już zresztą słabła.^^";
        print
            "Przekonani, że jaskinie Mamucia i Flint Ridge tworzą jeden wielki
             system, grotołazi latami szukali tajnych wejść, aż w końcu
             zyskali oficjalne poparcie. Przez całe lata sześćdziesiąte
             wszystkie połączenia z Flint Ridge - trudne, zalane wodą tunele -
             kończyły się frustrująco zwałami głazów. Przełomu dokonała w 1972
             roku «chuda jak trzcina» fizyczka Patricia Crowther, która
             przecisnęła się przez Ciasne Miejsce i znalazła błotnisty
             korytarz: było to ukryte wejście do Jaskini Mamuciej.^^";
        print
            "Zgodnie z testamentem właściciela Stephen Bishop odzyskał wolność
             w 1856 roku; jaskinia miała wtedy 226 alei, 47 kopuł, 23 jamy
             i 8 wodospadów. Zmarł rok później, zanim zdążył wykupić żonę
             i syna. W latach siedemdziesiątych XX wieku błotnisty korytarz
             Crowther odnaleziono na jego mapie.^^";
        print
            "Jaskinia Mamucia jest ogromna, a jej pełny zasięg wciąż jest
             przedmiotem spekulacji (szacunki wahają się od 300 do 500 mil).
             Choć grę często nazywano ~Colossal Cave~, w rzeczywistości jest
             ona symulacją rejonu jaskini Bedquilt. Oto jak jej powstanie
             opisuje Will Crowther:^^";
        print
            "~Grałem wtedy w niekomputerową grę fabularną, Dungeons and
             Dragons, a do tego aktywnie zwiedzałem jaskinie - zwłaszcza
             Jaskinię Mamucią w Kentucky. Nagle przyszedł rozwód i trochę mnie
             to na różne sposoby rozbiło. Przede wszystkim brakowało mi dzieci.
             Skończyło się też chodzenie po jaskiniach, bo zrobiło się
             niezręcznie, więc postanowiłem dla zabawy napisać program, który
             byłby fantastycznym odtworzeniem mojego grotołażenia, a zarazem
             grą dla dzieci, może z elementami Dungeons and Dragons, w które
             grałem.^^";
        print
            "~Chodziło mi o to, żeby była to gra komputerowa, która nie
             onieśmieli ludzi niemających do czynienia z komputerami, i między
             innymi dlatego zrobiłem tak, żeby gracz kierował grą w języku
             naturalnym, a nie za pomocą bardziej ustandaryzowanych poleceń.
             Moje dzieci świetnie się przy niej bawiły.~ [Cytat z ~Genesis II:
             Creation and Recreation with Computers~, Dale Peterson (1983).]^^";
        print
            "Oryginalny program Crowthera w FORTRAN-ie miał mniej więcej pięć
             skarbów, ale żadnej formalnej punktacji. Wyzwaniem było przede
             wszystkim zwiedzanie, choć przeszkadzał na przykład wąż. Jak
             prawdziwy rejon Bedquilt, symulacja Crowthera ma mapę na mniej
             więcej czterech poziomach głębokości i obfituje w szczegóły
             geologiczne. Dobrym przykładem jest pomarańczowa kolumna, która
             schodzi do Komnaty Pomarańczowej Rzeki (gdzie mieszka ptaszek):
             prawdziwa kolumna jest z pomarańczowego trawertynu, pięknego
             minerału występującego w wilgotnym wapieniu.^^";
        print
            "Język gry jest pełen odniesień do speleologii, do «kopuł»
             i «przełazów». Na przykład «komnata z płytą» (slab room) to bardzo
             stara jaskinia, której strop zaczął się kruszyć na ostre płaty,
             zaścielające podłogę w bezładnym stosie. Używanie przez program
             słowa «room» (komnata) na określenie wszelkich jaskiń i miejsc
             wydaje się w potocznym angielskim trochę niechlujne, ale jest
             powszechne w amerykańskiej speleologii i sięga czasów Stephena
             Bishopa: możliwe więc, że to on przekazał grom przygodowym
             zwyczaj nazywania każdego miejsca «komnatą».^^";
        print
            "Decydujący krok w stronę rozwiązywania zagadek gra zrobiła,
             kiedy Don Woods, student Stanfordu, poprawił ją i rozbudował.
             Potroił liczbę skarbów i dodał strefy niegeologiczne: wszystko od
             mostu trolla dalej, razem z większością przedsionków na poziomie
             Bedquilt. Wszystkie liczne naśladownictwa i rozszerzenia
             oryginalnej Przygody opierają się w gruncie rzeczy na
             350-punktowej wersji Woodsa. (W internecie krąży wiele
             rozdętych, zepsutych albo ulepszonych - zależnie od punktu
             widzenia - wersji gry, a najlepiej rozpoznawać je po
             maksymalnej liczbie punktów. Istnieje wiele wersji do mniej
             więcej 400 i 500 punktów, a jedna nawet do 1000. Sam Woods wciąż
             wydaje nowe wersje swojej gry; większość innych rozszerzających
             nie ma jego talentu.)^^";
        print
            "Choć gra odeszła od czystej symulacji, sporo w niej wciąż
             realistycznego. Grotołazi naprawdę zawracają, kiedy migocą im
             lampy karbidowe; na ścianach jaskiń naprawdę są tajemnicze znaki
             i inicjały, pozostawione częściowo przez górników, częściowo
             przez Bishopa, częściowo przez badaczy z lat dwudziestych.
             Oczywiście w środkowym Kentucky nie ma czynnego wulkanu, nie ma
             też smoków ani krasnoludów. Ale nawet te ozdobniki wywodzą się
             w pewnym sensie z tradycji: jak większość wczesnych gier
             fabularnych, «Przygoda» wiele zawdzięcza «Hobbitowi» J. R. R.
             Tolkiena oraz przejściu przez góry i Morię we «Władcy
             Pierścieni» (być może najbardziej dramatycznemu
             i nastrojowemu fragmentowi tej książki). Sam Tolkien, najbardziej
             utytułowany twórca mitów XX wieku, wzorował się na sagach
             islandzkich, fińskich i walijskich.^^";
        print
            "W 1977 roku taśmy z «Przygodą» krążyły już szeroko, między
             innymi za sprawą grupy użytkowników Digital, DECUS, i wszędzie,
             gdzie trafiły, pochłaniały przerwy na lunch i weekendy... ale to
             już inna historia. (Dobrze oddaje to fascynująca książka Tracy'ego
             Kiddera «The Soul of a New Machine», dziennikarskie spojrzenie
             na zespół budujący komputer typu mainframe.)^^";
        "To kopia z trzeciej albo czwartej ręki: od oryginału Willa
         Crowthera, przez 350-punktową wersję Donalda Woodsa, przeniesienie
         na PC Donalda Ekmana i znakomitą wersję TADS Davida M. Baggetta
         (1993), aż do tej.^^";
    }
    if (menu_item == 3) {
        print
            "To przeniesienie jest dość bliskie oryginałowi. Zagadki,
             przedmioty i miejsca są dokładnie takie jak w oryginalnej
             350-punktowej wersji Woodsa.^^";
        print
            "Tu i ówdzie dodałem kilka pomocnych komunikatów, takich jak ~To
             ślepy zaułek.~, i przywróciłem niektóre opisy początkowego
             położenia przedmiotów, na przykład (dość kulawe)
             ^^  Leży tu smaczne jedzenie.^^
             z plików źródłowych, które są na pewno wczesne, ale wątpliwego
             pochodzenia. Wydają się dobrze pasować do reszty tekstu.^^";
        print
            "System punktacji jest oryginalny, z tym że nie traci się już
             4 punktów za rezygnację (w grach Inform i tak nie widać wyniku
             po rezygnacji, więc to bez różnicy) i - co kontrowersyjne -
             przyznaję 5 punktów za samo noszenie skarbu, jak w niektórych
             przeniesieniach z początku lat osiemdziesiątych. Nazwy rang są
             trochę uporządkowane. Jedyna istotna zmiana zasad polega na tym,
             że nie można używać magicznych słów, dopóki nie odwiedzi się
             miejsc, do których prowadzą.^^";
        print
            "Krasnoludy poruszają się w prostszy sposób, ale za to dodałem
             kilka komunikatów, żeby lepiej współgrały z resztą gry.
             Prawdopodobieństwa są takie jak w oryginale.^^";
        print
            "W oryginale można było wpisać nazwę miejsca, żeby się do niego
             przenieść: dla oszczędności kodu pominąłem tę możliwość, choć
             z żalem. [RF: dodane w wydaniu 9.]^^";
        print
            "Sam tekst niemal wszędzie zachowano bez zmian, ale poprawiłem
             trochę błędów ortograficznych i gramatycznych (i zmieniłem kilka
             zupełnie mylących i zagadkowych uwag). Instrukcja jest nieco
             zmieniona (z oczywistych powodów), ale w zasadzie taka, jak ją
             napisano.^^";
        "Dobrym źródłem szczegółów jest kod źródłowy Davida Baggetta,
         który krąży w internecie.";
    }
    print "Czy wiesz, że...^^";
    print
        "Pięć krasnoludów ma 96% szans, że pójdzie za tobą, chyba że do
         światła, w dół jamy albo kiedy podziwiają się w lustrze; a ich
         paskudne małe noże trafiają w 9,5% przypadków.^^";
    print "Smoki spalają krasnoludy (może dlatego, że krasnoludy jedzą
           tylko węgiel).^^";
    print
        "Niedźwiedź (który lubi wulkan) jest za ciężki na most... a po
         wskrzeszeniu można wrócić na miejsce wypadku.^^";
    print
        "Można się prześlizgnąć obok węża do tajnego kanionu wschód-zachód,
         w każdym razie w 35% przypadków. A chodzenie po ciemku nie jest
         takie straszne: grozi tylko w 25% upadkiem do jamy.^^";
    print "Waza nie lubi kąpieli.^^";
    print "Mroczne postacie mogą do siebie machać.^^";
    print "Polanie zawiasów drzwi wodą znów je zardzewia.^^";
    print
        "Kiedy jaskinia się zamyka, krata zostaje zablokowana, klucze
         wyrzucone, stworzenia uciekają, a kryształowy most znika...^^";
    print
        "...a na muszli olbrzymiej ostrygi w grze końcowej jest napisana
         zupełnie bezużyteczna wskazówka. (Żeby była odrobinę uczciwsza,
         zmieniłem jedno słowo i porozrzucałem podpowiedzi w innych
         miejscach gry.)^^";
    "Ostatni nędzny punkt można zdobyć... ale nie. To byłoby już
     zdradzanie.";
];

[ HelpSub;
    if (deadflag ~= 2)
        DoMenu(
            "Dostępne są informacje na następujące tematy:^
            ^     Instrukcja gry
            ^     Wstęp historyczny
            ^     Na ile autentyczna jest ta wersja?^", HelpMenu, HelpInfo);
    else
        DoMenu(
            "Dostępne są informacje na następujące tematy:^
            ^     Instrukcja gry
            ^     Wstęp historyczny
            ^     Na ile autentyczna jest ta wersja?
            ^     Czy wiesz, że...^", HelpMenu, HelpInfo);
];

[ Amusing; HelpSub(); ];

! ------------------------------------------------------------------------------
!   Gramatyka: zwykła polska gramatyka i kilka rozszerzeń
! ------------------------------------------------------------------------------

Include "PolskiG";

Extend 'pomoc' replace
    *                       -> Help;

! ------------------------------------------------------------------------------

[ OffSub;
    if (brass_lantern notin player) "Nie masz lampy.";
    <<SwitchOff brass_lantern>>;
];

[ OnSub;
    if (brass_lantern notin player) "Nie masz lampy.";
    <<SwitchOn brass_lantern>>;
];

Extend 'wyłącz' first
    *                       -> Off;

Extend 'włącz' first
    *                       -> On;

! ------------------------------------------------------------------------------

[ CatchSub; "Nie da się złapać ", (dop) noun, "."; ];

[ ReleaseSub; "Nie da się uwolnić ", (dop) noun, "."; ];

Extend only 'złap' first
    * creature              -> Catch
    * creature 'do'/'w//' held -> Catch;

Verb 'schwytaj' 'łap' 'pochwyć'
    * creature              -> Catch
    * creature 'do'/'w//' held -> Catch;

Verb 'uwolnij' 'wypuść' 'oswobodź'
    * creature              -> Release;

! ------------------------------------------------------------------------------

[ WaterSub;
    if (bottle in player) <<Empty bottle>>;
    "Wodą? Jaką wodą?";
];

[ OilSub;
    if (bottle in player) <<Empty bottle>>;
    "Olejem? Jakim olejem?";
];

Verb 'podlej' 'zlej' 'zmocz'
    * noun                  -> Water;

Verb 'naoliw' 'nasmaruj' 'smaruj' 'oliw'
    * noun                  -> Oil;

Verb 'polej'
    * noun 'wodą'           -> Water
    * noun 'olejem'/'oliwą' -> Oil
    * 'wodą' noun           -> Water
    * 'olejem'/'oliwą' noun -> Oil
    * noun                  -> Water;

Extend 'wylej' first
    * 'wodę' 'na' noun      -> Water
    * 'olej'/'oliwę' 'na' noun -> Oil;

! ------------------------------------------------------------------------------

[ BlastSub;
    if (location ~= At_Sw_End or At_Ne_End) "Frustrujące, prawda?";
    if (location == At_Sw_End && parent(black_mark_rod) == At_Ne_End) {
        score = score + 35;
        deadflag = 2;
        "Rozlega się głośny wybuch i w przeciwległej ścianie pojawia się dwudziestostopowa dziura, a krasnoludy giną pod gruzami.
         Przechodzisz przez dziurę i trafiasz do głównego biura, gdzie
         wiwatujący oddział przyjaznych elfów niesie zwycięskiego
         poszukiwacza przygód w stronę zachodzącego słońca.";
    }
    if (location == At_Ne_End && parent(black_mark_rod) == At_Sw_End) {
        score = score + 20;
        deadflag = 1;
        "Rozlega się głośny wybuch i w przeciwległej ścianie pojawia się dwudziestostopowa dziura, a węże giną pod gruzami. Przez
         dziurę wlewa się rzeka roztopionej lawy, niszcząc wszystko na swojej
         drodze, łącznie z tobą!";
    }
    deadflag = 1;
    "Rozlega się głośny wybuch, a ty nagle rozpryskujesz się po ścianach
     komnaty.";
];

[ BlastWithSub;
    if (second ~= black_mark_rod) "Do wysadzania potrzebny jest dynamit.";
    "Znowu dziwne ciasteczka na deser?";
];

Verb 'wysadź' 'zdetonuj'
    *                       -> Blast
    * noun held             -> BlastWith
    * noun 'za' 'pomocą' held -> BlastWith;

! ------------------------------------------------------------------------------

[ XyzzySub; "Nic się nie dzieje."; ];

[ PlughSub; "Nic się nie dzieje."; ];

[ PloverSub; "Nic się nie dzieje."; ];

[ FeeSub; FthingSub(0); ];

[ FieSub; FthingSub(1); ];

[ FoeSub; FthingSub(2); ];

[ FooSub; FthingSub(3); ];

[ FthingSub i;
    if (feefie_count ~= i) {
        feefie_count = 0;
        "Powiedz to porządnie, głuptasie!";
    }
    if (feefie_count++ == 3) {
        feefie_count = 0;
        if (golden_eggs in In_Giant_Room) "Nic się nie dzieje.";
        if ((golden_eggs in player) || (golden_eggs in location))
            print "Gniazdo ze złotymi jajami zniknęło!^";
        else
            print "Zrobione!";
        if (golden_eggs in player) score = score - 5;
        if (golden_eggs in Inside_Building)
            score = score - golden_eggs.depositpoints;
        move golden_eggs to In_Giant_Room;
        if (location == In_Giant_Room)
            "^^Znikąd pojawia się nagle wielkie gniazdo pełne złotych jaj!";
    }
    else
        "Dobrze.";
];

[ OldMagicSub; "Niezła próba, ale to stare, wyświechtane magiczne słowo."; ];

Verb 'xyzzy'
    *                       -> Xyzzy;

Verb 'plugh'
    *                       -> Plugh;

Verb 'plover'
    *                       -> Plover;

Verb 'fee'
    *                       -> Fee;

Verb 'fie'
    *                       -> Fie;

Verb 'foe'
    *                       -> Foe;

Verb 'foo'
    *                       -> Foo;

Verb 'sezamie' 'sezam' 'abrakadabra' 'hokus' 'pokus' 'shazam' 'foobar'
     'frotz' 'sesame' 'abracadabra'
    *                       -> OldMagic;

Extend 'powiedz' first
    * 'xyzzy'               -> Xyzzy
    * 'plugh'               -> Plugh
    * 'plover'              -> Plover
    * 'fee'                 -> Fee
    * 'fie'                 -> Fie
    * 'foe'                 -> Foe
    * 'foo'                 -> Foo
    * 'sezamie'/'sezam'/'abrakadabra'/'hokus'/'pokus'/'shazam'/'foobar'/'frotz'
                            -> OldMagic;

! ------------------------------------------------------------------------------

[ CountSub;
    if (noun has multitude) "Jest ich mnóstwo.";
    print "Widzę ";
    if (noun has animate && RodzajObiektu(noun) == 0) print "jednego";
    else Forma(noun, "jeden", "jedną", "jedno", "jedne", "jednych");
    " (1): ", (bie) noun, ".";
];

[ KickSub;  <<Attack noun>>; ];         ! do kopania krasnoludów

[ UseSub; "Musisz wyrazić się nieco dokładniej."; ];

Verb 'policz' 'przelicz' 'zlicz'
    * noun                  -> Count;

Extend only 'kopnij' first
    * noun                  -> Kick;

Verb 'użyj' 'wykorzystaj'
    *                       -> Use
    * noun                  -> Use;

! ------------------------------------------------------------------------------
!   Teleportacja (korzysta też z punktu wejścia UnknownVerb)
! ------------------------------------------------------------------------------

[ TeleportScope
    obj;
    switch (scope_stage) {
      1:    rfalse;
      2:    objectloop (obj ofclass Room)
                if (obj has visited) PlaceInScope(obj);
            rtrue;
      3:    return L__M(##Go, 2);
    }
];

[ TeleportSub;
    if (noun == location) "Przecież już tu jesteś!";
    PlayerTo(noun);
];

Extend 'idź'
    * scope=TeleportScope       -> Teleport
    * 'do'/'na'/'w//'/'nad'/'pod'/'przed' scope=TeleportScope -> Teleport;

#Ifndef DEBUG;

Verb 'goto'
    * scope=TeleportScope       -> Teleport;

#Endif;

! ------------------------------------------------------------------------------
!   W wersji testowej: bez krasnoludów i pirata, magiczne słowa działają od
!   początku
! ------------------------------------------------------------------------------

#Ifdef TEST_VERSION;

[ XdetermSub;
    StopDaemon(dwarf);
    StopDaemon(pirate);
    give In_Debris_Room visited;
    give At_Y2 visited;
    give In_Plover_Room visited;
];

Verb 'xdeterm'
    *                       -> Xdeterm;

#Endif;

! ------------------------------------------------------------------------------
