Room    In_Hall_Of_Mists "Sala Mgieł"
  with  name 'sala' 'sali' 'mgieł',
        description
            "Jesteś na jednym końcu ogromnej sali, która ciągnie się na zachód,
             aż poza zasięg wzroku. Po obu stronach są otwory. Niedaleko
             w dół prowadzą szerokie kamienne schody. Salę wypełniają smużki
             białej mgły, które kołyszą się tam i z powrotem, prawie jakby
             żyły. Od schodów wieje w górę zimny wiatr. Za tobą, na szczycie
             kopuły, jest jakiś korytarz.
             ^^
             Na kopułę prowadzą nierówne kamienne stopnie.",
        initial [;
            if (self has visited) rfalse;
            score = score + 25;
        ],
        s_to In_Nugget_Of_Gold_Room,
        w_to On_East_Bank_Of_Fissure,
        d_to In_Hall_Of_Mt_King,
        n_to In_Hall_Of_Mt_King,
        u_to [;
            if (large_gold_nugget in player) "Na kopułę nie da się wspiąć.";
            return At_Top_Of_Small_Pit;
        ];

Scenic  -> "szerok/ie kamienn/e schod/y"
  with  name 'stopnie' 'stopni' 'schodki' 'schodków' 'klatka' 'klatce',
        description "Schody prowadzą w dół.",
  has   pluralname;

