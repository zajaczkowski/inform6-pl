! Constant TEST_VERSION;

Include "PolskiZ";

Constant Story "PRZYGODA";
Constant Headline
    "^Interaktywny oryginał^
      Will Crowther (1976) i Don Woods (1977)^
      Odtworzona w trzech krokach przez:^
      Donalda Ekmana, Davida M. Baggetta (1993) i Grahama Nelsona (1994)^
      [In memoriam Stephen Bishop (1820?-1857): GN]^
      Wersja polska.^^";
Serial "060321";
Release 9;

! IFID gry Adventure -- zob. http://babel.ifarchive.org/
Array UUID_ARRAY string "UUID://E9FD3D87-DD2F-4005-B332-23557780B64E//"; #Ifdef UUID_ARRAY; #Endif;

Constant AMUSING_PROVIDED;
Constant MAX_CARRIED   = 7;
Constant MAX_SCORE     = 350;
Constant MAX_TREASURES = 15;

Include "Parser";
Include "VerbLib";

Attribute nodwarf;                      ! krasnoludy tu nie wchodzą
Attribute treasure_found;               ! skarb został już znaleziony
Attribute multitude;                    ! używane tylko przez POLICZ

Global caves_closed;                    ! true, gdy jaskinia się zamyka
Global canyon_from;                     ! do którego kanionu wrócić
Global treasures_found;                 ! liczba znalezionych skarbów
Global deaths;                          ! liczba śmierci i wskrzeszeń
Global dark_warning;                    ! true po ostrzeżeniu o jamach w ciemności
Global feefie_count;                    ! licznik fee/fie/foe/foo

! ------------------------------------------------------------------------------
!   Reguły dla skarbów, rozrzuconych po całej grze
! ------------------------------------------------------------------------------

Class   Treasure
  with  after [;
          Take:
            if (location == Inside_Building)
                score = score - self.depositpoints;
            score = score + 5;
            if (noun hasnt treasure_found) {
                give noun treasure_found;
                treasures_found++;
                score = score + 2;
            }
            "Wzięte!";
          Insert:
            score = score - 5;  ! (na wypadek włożenia do wiklinowej klatki)
          Drop:
            score = score - 5;
            if (location == Inside_Building) {
                score = score + self.depositpoints;
                print "Bezpiecznie złożon"; KoncY(noun); ".";
            }
        ],
        depositpoints 10;

! ------------------------------------------------------------------------------
!   Świat na powierzchni
! ------------------------------------------------------------------------------

Class   Room;

Class   Aboveground
  class Room
  has   light nodwarf;

Class   Scenic
  has   scenery;

Aboveground At_End_Of_Road "Koniec drogi"
  with  name 'koniec' 'drogi' 'ulicy' 'parowu',
        description
            "Stoisz na końcu drogi, przed małym budynkiem z cegły. Dookoła
             rośnie las. Z budynku wypływa niewielki strumień i spływa w dół
             parowem.",
        w_to At_Hill_In_Road,
        u_to At_Hill_In_Road,
        e_to Inside_Building,
        d_to In_A_Valley,
        s_to In_A_Valley,
        n_to In_Forest_1,
        in_to Inside_Building;

Scenic  "mał/y budyn/e/k/+u z cegły"
  with  name 'dom' 'domu' 'domek' 'domku' 'studnia' 'studni' 'studnią'
             'ceglany' 'ceglanego' 'ceglanym' 'cegła' 'cegły',
        description "To mały budynek z cegły. Wygląda na domek nad studnią.",
        found_in At_End_Of_Road At_Hill_In_Road Inside_Building,
        before [;
          Enter:
            if (location == At_Hill_In_Road && Inside_Building hasnt visited)
                "Jest za daleko.";
            <<Teleport Inside_Building>>;
        ];

Scenic  Stream "strumie/ń=ni/"
  with  name 'woda' 'wody' 'wodę' 'wodą' 'wodzie' 'potok' 'potoku' 'potokiem'
             'rzeka' 'rzeki' 'rzekę' 'rzece' 'jezioro' 'jeziora' 'jeziorze'
             'zbiornik' 'zbiornika' 'zbiorniku' 'mały' 'małego' 'małym'
             'szumiący' 'szumiącego' 'rwący' 'rwącego' 'bystry' 'bystrego',
        found_in At_End_Of_Road In_A_Valley At_Slit_In_Streambed In_Pit
                 In_Cavern_With_Waterfall At_Reservoir Inside_Building,
        before [;
          Drink:
            "Pijesz wodę ze strumienia. Ma wyraźny posmak minerałów, ale nie
             jest nieprzyjemna. Jest lodowato zimna.";
          Take:
            if (bottle notin player)
                "Nie masz w czym nieść wody.";
            <<Fill bottle>>;
          Insert:
            if (second == bottle) <<Fill bottle>>;
            "Nie masz w czym nieść wody.";
          Receive:
            if (noun == ming_vase) {
                remove ming_vase;
                move shards to location;
                score = score - 5;
                "Nagła zmiana temperatury roztrzaskała delikatną wazę.";
            }
            if (noun == bottle) <<Fill bottle>>;
            remove noun;
            if (noun ofclass Treasure) score = score - 5;
            print (CMian) noun, " "; PL(noun, "odpływa", "odpływają");
            " z nurtem strumienia.";
        ],
  has   male;

Scenic  "drog/a"
  with  name 'ulica' 'ulicy' 'ulicę' 'ścieżka' 'ścieżki' 'ścieżkę' 'ścieżce'
             'gruntowa' 'gruntowej' 'gruntową',
        description "Droga jest gruntowa, a nie wyłożona żółtą cegłą.",
        found_in At_End_Of_Road At_Hill_In_Road In_Forest_2,
  has   female;

Scenic  "las/+u"
  with  name 'drzewo' 'drzewa' 'drzew' 'dąb' 'dęby' 'klon' 'klony' 'gaj'
             'sosna' 'sosny' 'świerk' 'świerki' 'brzoza' 'brzozy' 'jesion'
             'jesiony' 'młodniak' 'krzaki' 'krzaków' 'krzewy' 'krzewów'
             'liście' 'liści' 'jagoda' 'jagody' 'jagód' 'zarośla' 'zarośli',
        description
            "Las to duże drzewa liściaste, dęby i klony, gdzieniegdzie
             przetykane gajem sosen albo świerków. Podszyt jest dość gęsty:
             to głównie młode brzozy i jesiony, a do tego najróżniejsze
             krzaki. O tej porze roku liście mocno ograniczają widoczność,
             ale chodzi się całkiem łatwo, jeśli omija się świerki i krzaki
             jagód.",
        found_in At_End_Of_Road At_Hill_In_Road In_A_Valley In_Forest_1 In_Forest_2,
  has   multitude;

