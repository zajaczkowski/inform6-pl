             Niski, szeroki korytarz z kocimi łbami jest tu zatkany błotem
             i śmieciami, ale w górę i na zachód prowadzi niewygodny kanion.
             ^^
             Na ścianie wisi kartka: ~Magiczne słowo XYZZY.~",
        e_to In_Cobble_Crawl,
        u_to In_Awkward_Sloping_E_W_Canyon,
        w_to In_Awkward_Sloping_E_W_Canyon,
        before [;
          Xyzzy:
            PlayerTo(Inside_Building);
            rtrue;
        ],
  has   nodwarf;

Scenic  -> "rumowisk/o"
  with  name 'śmieci' 'śmieciami' 'błoto' 'błota' 'błotem' 'gruz' 'gruzu',
