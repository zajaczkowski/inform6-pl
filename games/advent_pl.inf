          Count:
            "Kilkanaście kluczy.";
        ];

Object  -> tasty_food "smaczn/e jedzeni/e"
  with  name 'żywność' 'żywności' 'prowiant' 'prowiantu' 'racje' 'racji'
             'flaki' 'flaków' 'pyszne' 'pysznego' 'wyborne' 'wybornego',
        description "Wygląda naprawdę apetycznie!",
        initial "Leży tu smaczne jedzenie.",
        after [;
          Eat:
            "Pyszne!";
        ],
  has   edible neuter;

Object  -> brass_lantern "mosiężn/a lamp/a"
  with  name 'lampa' 'lampka' 'lampkę' 'lampki' 'latarka' 'latarkę'
             'latarki' 'latarnia' 'latarnię' 'latarni' 'czołówka' 'czołówkę'
             'światło' 'światła' 'błyszcząca' 'błyszczącą' 'błyszczącej',
        when_off "W pobliżu leży błyszcząca mosiężna lampa.",
        when_on "Leży tu twoja lampa i jasno świeci.",
        daemon [ t;
            if (self hasnt on) {
                StopDaemon(self);
                rtrue;
            }
            t = --(self.power_remaining);
            if (t == 0) give self ~on ~light;
            if (self in player || self in location) {
                if (t == 0) {
                    print "W lampie wyczerpały się baterie.";
                    if (fresh_batteries notin player && location hasnt light) {
                        deadflag = 3;
                        " Bez lampy nie da się badać jaskini. Na tym
                         chyba skończymy.";
                    }
                    else
                        self.replace_batteries();
                    new_line;
                    rtrue;
                }
                if (t == 30) {
                    print "Lampa zaczyna przygasać.";
                    if (fresh_batteries.have_been_used)
                        " Nie masz już też zapasowych baterii. Najlepiej
                         zacznij to wszystko kończyć.";
                    if (fresh_batteries in VendingMachine && Dead_End_14 has visited)
                        " Najlepiej zacznij to wszystko kończyć, chyba że
                         znajdziesz świeże baterie. Coś mi świta, że
                         w labiryncie jest automat. Weź ze sobą trochę
                         monet.";
                    if (fresh_batteries notin VendingMachine or player or location)
                        " Lepiej wróć po tamte baterie.";
                    new_line;
                    rtrue;
                }
            }
        ],
        before [;
          Examine:
            print "To błyszcząca mosiężna lampa";
            if (self hasnt on) ". W tej chwili nie świeci.";
            if (self.power_remaining < 30) ", świecąca słabym blaskiem.";
            ", świecąca jasnym blaskiem.";
          Burn:
            <<SwitchOn self>>;
          Rub:
            "Pocieranie elektrycznej lampy nie daje szczególnej satysfakcji.
             W każdym razie nic ciekawego się nie dzieje.";
          SwitchOn:
            if (self.power_remaining <= 0)
                "Niestety, baterie chyba się wyczerpały.";
          Receive:
            if (noun == old_batteries)
                "Te baterie są wyczerpane; na nic się nie przydadzą.";
            if (noun == fresh_batteries) {
                self.replace_batteries();
                rtrue;
            }
            "Jedyne, co można by z pożytkiem włożyć do lampy, to para
             świeżych baterii.";
        ],
        after [;
          SwitchOn:
            give self light;
            StartDaemon(self);
          SwitchOff:
            give self ~light;
        ],
        replace_batteries [;
            if (fresh_batteries in player or location) {
                remove fresh_batteries;
                fresh_batteries.have_been_used = true;
                move old_batteries to location;
                self.power_remaining = 2500;
                "Pozwalam sobie wymienić baterie.";
            }
        ],
        power_remaining 330,
  has   switchable female;

Object  -> bottle "mał/a butelk/a"
  with  name 'flaszka' 'flaszkę' 'flaszki' 'słoik' 'słoika' 'słoik'
             'manierka' 'manierkę' 'manierki',
        initial "Stoi tu pusta butelka.",
        before [;
          LetGo:
            if (noun in bottle)
                "Przecież już to trzymasz (w butelce).";
          Receive:
            if (noun == stream or Oil)
                <<Fill self>>;
            else
                "Butelka jest przeznaczona tylko na płyny.";
          Fill:
            if (child(bottle) ~= nothing)
                "Butelka jest już pełna.";
            if (stream in location || Spring in location) {
                move water_in_the_bottle to bottle;
                "Butelka jest teraz pełna wody.";
            }
            if (Oil in location) {
                move oil_in_the_bottle to bottle;
                "Butelka jest teraz pełna oleju.";
            }
            "Nie ma tu niczego, czym można by napełnić butelkę.";
          Empty:
            if (child(bottle) == nothing)
                "Butelka jest już pusta!";
            remove child(bottle);
            "Butelka jest teraz pusta, a ziemia mokra.";
        ],
  has   container open female;

Object  water_in_the_bottle "wod/a w butelce"
  with  name 'h2o' 'butelkowana' 'butelkowaną' 'butelkowanej',
        description "Moim zdaniem wygląda jak zwykła woda.",
        before [;
          Drink:
            remove water_in_the_bottle;
            <<Drink Stream>>;
        ],
  has   female;

Object  oil_in_the_bottle "olej/+u w butelce"
  with  name 'smar' 'smaru' 'smarem' 'oliwa' 'oliwy' 'oliwę',
        description "Moim zdaniem wygląda jak zwykły olej.",
        before [;
          Drink:
            <<Drink Oil>>;
        ];

