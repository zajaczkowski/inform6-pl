!% -Cu
!% +language_name=polski
! ==============================================================================
!   Test komunikatów: drukuje każdy komunikat biblioteki dla obiektu każdego
!   rodzaju i dla każdego wykonawcy.  Wynik jest porównywany z plikiem komunikaty.oczekiwane (zob.
!   test.sh), więc każda zmiana brzmienia musi być świadoma.
! ==============================================================================

Include "PolskiZ";

Constant Story "KOMUNIKATY";
Constant Headline "^Test komunikatów^";

Include "Parser";
Include "VerbLib";

Object Pokoj "Pokój"
  with description "Pusty pokój.",
  has  light;

Object -> o_m "stalow/y miecz/";
Object -> o_f "krótk/a księg/a" has female;
Object -> o_n "ciepł/e mlek/o" has neuter;
Object -> o_p "drewnian/e drzwi/" has pluralname;
Object -> o_a "star/y kapłan/+ie" has animate;
Object -> o_k "młod/a kuchark/a" has animate female;
Object -> o_r "dzieln/i rycerz/e" has pluralname animate male;

Array proby table o_m o_f o_n o_p o_a o_k o_r;

Array akcje table
    ##Answer ##Ask ##Attack ##Blow ##Burn ##Buy ##Climb ##Close
    ##Consult ##Cut ##Dig ##Disrobe ##Drink ##Drop
    ##Eat ##EmptyT ##Enter ##Examine ##Exit ##Fill ##PLFind ##FullScore ##PLAskWhat ##PLTellWhat ##PLGreet ##PLNoNeed ##PLThanks ##PLUse ##GetOff ##Give
    ##Go ##Insert ##Inv ##Jump ##JumpIn ##JumpOn ##JumpOver ##Kiss ##Listen
    ##Lock ##Look ##LookUnder ##Mild ##No ##NotifyOff ##NotifyOn ##Objects
    ##Open ##Order ##Places ##Pray ##Pull ##Push ##PushDir ##PutOn ##Remove
    ##Rub ##Search ##Set ##SetTo ##Show ##Sing ##Sleep ##Smell ##Sorry
    ##Squeeze ##Strong ##Swim ##Swing ##SwitchOff ##SwitchOn ##Take ##Taste
    ##Tell ##Think ##ThrowAt ##Tie ##Touch ##Transfer ##Turn ##Unlock ##VagueGo
    ##ListMiscellany ##Wait ##Wake ##WakeOther ##Wave ##WaveHands ##Wear ##Yes;

[ Rzut  a n p m;
    for (a=1 : a<=akcje-->0 : a++) {
        m = 12;
        if (akcje-->a == ##ListMiscellany) m = 30;
        for (n=1 : n<=m : n++)
            for (p=1 : p<=proby-->0 : p++) {
                print a, ".", n, ".", p, ": ";
                L__M(akcje-->a, n, proby-->p, o_f);
                new_line;
            }
    }
];

! Każdy komunikat dla gracza, graczki i postaci każdego rodzaju jako wykonawcy.
[ Initialise;
    location = Pokoj;
    second = o_f; noun = o_m;
    print "Początek^";
    actor = player; Rzut();
    give player female; Rzut(); give player ~female;
    actor = o_a; Rzut();
    actor = o_k; Rzut();
    actor = o_r; Rzut();
    actor = player;
    print "Koniec^";
    deadflag = 2;
];

Include "PolskiG";
